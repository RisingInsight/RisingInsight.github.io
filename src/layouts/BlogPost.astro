---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Comments from '../components/Comments.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { formatDate, formatWordCount, getReadTime, getWordCount, seriesSlug } from '../utils/blog';
import { GITHUB_BRANCH, GITHUB_REPO, PROFILE } from '../consts';

type AdjacentPost = { id: string; data: { title: string } } | null;

type Props = CollectionEntry<'blog'>['data'] & {
  id?: string;
  body?: string;
  filePath?: string;
  prevPost?: AdjacentPost;
  nextPost?: AdjacentPost;
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  ogImage,
  tags,
  categories,
  body,
  series,
  prevPost = null,
  nextPost = null,
} = Astro.props;

const readTime = getReadTime(body || '');
const wordCount = getWordCount(body || '');

const breadcrumbItems = [
  { label: '首页', href: '/' },
  { label: '笔记', href: '/blog/' },
  ...(categories && categories.length > 0 ? [{ label: categories[0] }] : []),
];

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const postId = Astro.props.id || '';
const contentPath = (Astro.props.filePath || `${postId}.md`)
  .replace(/^.*src\/content\/blog\//, '')
  .replace(/^blog\//, '');
const editUrl = `https://github.com/${GITHUB_REPO}/edit/${GITHUB_BRANCH}/src/content/blog/${contentPath}`;
const historyUrl = `https://github.com/${GITHUB_REPO}/commits/${GITHUB_BRANCH}/src/content/blog/${contentPath}`;
const relatedPosts = allPosts
  .filter((post) => post.id !== postId && post.data.tags?.some((tag) => tags?.includes(tag)))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

let seriesPosts: { id: string; title: string }[] = [];
if (series) {
  seriesPosts = allPosts
    .filter((post) => post.data.series === series && post.id !== postId)
    .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf())
    .map((post) => ({ id: post.id, title: post.data.title }));
}
---

<BaseLayout
  title={`${title} // RisingInsight`}
  description={description}
  type="article"
  image={ogImage || heroImage}
>
  <main class="mx-auto max-w-3xl px-4 pb-24 pt-10 sm:px-6 lg:px-8">
    <div id="reading-progress" class="reading-progress" style="width: 0%"></div>

    <Breadcrumb items={breadcrumbItems} />

    <article>
      <header class="border border-rule bg-surface/55 p-5 sm:p-7">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-rule-soft pb-3">
          <div class="flex min-w-0 items-center gap-2 font-mono text-[12px] tracking-[0.04em] text-muted">
            <span class="text-accent">~/</span>
            <span class="truncate">posts/{contentPath}</span>
          </div>
          <div class="flex flex-wrap items-center gap-3 font-mono text-[12px] uppercase tracking-[0.1em]">
            {series && (
              <a
                href={`/series/#series-${seriesSlug(series)}`}
                class="text-accent transition-colors hover:text-accent-strong"
              >
                series: {series}
              </a>
            )}
            <a href={editUrl} target="_blank" rel="noopener noreferrer" class="text-muted transition-colors hover:text-accent">
              edit ↗
            </a>
            <a href={historyUrl} target="_blank" rel="noopener noreferrer" class="text-muted transition-colors hover:text-accent">
              history
            </a>
          </div>
        </div>

        <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[12px] uppercase tracking-[0.1em] text-muted">
          <span class="flex items-center gap-1.5 text-accent"><span class="status-dot"></span> published</span>
          <span class="text-rule">/</span>
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          <span class="text-rule">/</span>
          <span>{readTime}</span>
          <span class="text-rule">/</span>
          <span>{formatWordCount(wordCount)} 字</span>
          {categories.length > 0 && (
            <>
              <span class="text-rule">/</span>
              <span>{categories.join(' / ')}</span>
            </>
          )}
        </div>
        <h1 class="mt-4 text-balance font-serif text-3xl font-semibold leading-[1.12] tracking-[-0.035em] text-ink sm:text-[2.6rem]">
          {title}
        </h1>
        <p class="mt-4 max-w-2xl text-[15px] leading-7 text-muted">{description}</p>
        {updatedDate && (
          <div class="mt-4 font-mono text-[12px] uppercase tracking-[0.12em] text-muted">
            updated {formatDate(updatedDate)}
          </div>
        )}
        {tags.length > 0 && (
          <div class="mt-5 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <a href={`/blog/?tag=${encodeURIComponent(tag)}`} class="tag">{tag}</a>
            ))}
          </div>
        )}
        {heroImage && (
          <div class="mt-6 overflow-hidden border border-rule">
            <img src={heroImage} alt={title} class="w-full" loading="lazy" />
          </div>
        )}
      </header>

      <TableOfContents />

      <div class="prose mt-8" data-pagefind-body>
        <slot />
      </div>

      {series && seriesPosts.length > 0 && (
        <section class="mt-14 border-t border-rule pt-8">
          <div class="flex items-baseline justify-between">
            <div class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted-light">
              Series · {series}
            </div>
            <a
              href={`/series/#series-${seriesSlug(series)}`}
              class="text-[12px] text-muted transition-colors hover:text-accent"
            >
              查看文集 <span aria-hidden="true">→</span>
            </a>
          </div>
          <div class="mt-3 divide-y divide-rule-soft">
            {seriesPosts.map((post) => (
              <a
                href={`/blog/${post.id}/`}
                class="group flex items-center justify-between py-3 text-sm text-ink transition-colors hover:text-accent"
              >
                <span>{post.title}</span>
                <span
                  aria-hidden="true"
                  class="font-mono text-[12px] text-muted-light transition-transform group-hover:translate-x-0.5"
                >→</span>
              </a>
            ))}
          </div>
        </section>
      )}

      {relatedPosts.length > 0 && (
        <section class="mt-14 border-t border-rule pt-8">
          <div class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted-light">
            Related notes
          </div>
          <div class="mt-3 divide-y divide-rule-soft">
            {relatedPosts.map((post) => (
              <a
                href={`/blog/${post.id}/`}
                class="group grid grid-cols-[1fr_auto] items-baseline gap-4 py-3"
              >
                <span class="font-serif text-sm font-semibold text-ink transition-colors group-hover:text-accent">
                  {post.data.title}
                </span>
                <span class="font-mono text-[11px] text-muted-light">
                  {formatDate(post.data.pubDate)}
                </span>
              </a>
            ))}
          </div>
        </section>
      )}

      <div class="panel mt-12 flex flex-wrap items-start gap-4 p-5">
        <img
          src={PROFILE.avatar}
          alt={PROFILE.name}
          class="h-11 w-11 rounded-full border border-accent/30 object-cover"
        />
        <div class="min-w-0">
          <div class="mono-label">operator</div>
          <div class="mt-1 font-serif text-base font-semibold text-ink">{PROFILE.name}</div>
          <div class="mt-1 font-mono text-[11px] leading-5 text-muted">
            {PROFILE.role} · {PROFILE.tagline}
          </div>
        </div>
        <div class="ml-auto flex flex-col items-start gap-2 font-mono text-[11px] uppercase tracking-[0.08em] sm:items-end">
          <a href={editUrl} target="_blank" rel="noopener noreferrer" class="text-muted transition-colors hover:text-accent">
            edit on github ↗
          </a>
          <a href="/about/" class="text-muted transition-colors hover:text-accent">
            about →
          </a>
        </div>
      </div>

      <div class="mt-10 flex items-center justify-between border-t border-rule pt-6 font-mono text-[11px] uppercase tracking-[0.08em] text-muted">
        <button id="back-to-top" type="button" class="transition-colors hover:text-accent">
          ↑ back to top
        </button>
        <a href="/blog/" class="transition-colors hover:text-accent">
          all posts <span aria-hidden="true">→</span>
        </a>
      </div>

      {(prevPost || nextPost) && (
        <nav class="mt-10 grid gap-4 border-t border-rule pt-6 sm:grid-cols-2" aria-label="上下篇">
          {prevPost ? (
            <a href={`/blog/${prevPost.id}/`} class="group">
              <div class="font-mono text-[11px] uppercase tracking-[0.12em] text-muted-light">
                ← 上一篇
              </div>
              <div class="mt-2 font-serif text-sm font-semibold leading-snug text-ink transition-colors group-hover:text-accent">
                {prevPost.data.title}
              </div>
            </a>
          ) : (
            <div></div>
          )}
          {nextPost ? (
            <a href={`/blog/${nextPost.id}/`} class="group sm:text-right">
              <div class="font-mono text-[11px] uppercase tracking-[0.12em] text-muted-light">
                下一篇 →
              </div>
              <div class="mt-2 font-serif text-sm font-semibold leading-snug text-ink transition-colors group-hover:text-accent">
                {nextPost.data.title}
              </div>
            </a>
          ) : (
            <div></div>
          )}
        </nav>
      )}

      <Comments />
    </article>
  </main>

  <button
    id="scroll-top-btn"
    class="pointer-events-none fixed bottom-6 right-6 z-40 flex h-10 w-10 items-center justify-center rounded-full border border-rule bg-paper text-muted opacity-0 shadow-sm transition-all hover:text-accent"
    aria-label="回到顶部"
  >
    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18" />
    </svg>
  </button>

  <div id="shortcut-toast" class="shortcut-toast"></div>

  <div id="lightbox" class="lightbox-overlay" role="dialog" aria-modal="true" aria-label="图片预览" aria-hidden="true">
    <button id="lightbox-close" class="lightbox-close" type="button" aria-label="关闭图片预览">
      <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <img id="lightbox-img" alt="" />
  </div>
</BaseLayout>

<script>
  // ==========================================
  // 1. 阅读进度条 + 浮动回到顶部按钮
  // ==========================================
  const progressBar = document.getElementById('reading-progress');
  const scrollTopBtn = document.getElementById('scroll-top-btn');

  function onScroll() {
    const scrollTop = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
    if (progressBar) progressBar.style.width = progress + '%';
    if (scrollTopBtn) {
      if (scrollTop > 300) {
        scrollTopBtn.classList.remove('opacity-0', 'pointer-events-none');
        scrollTopBtn.classList.add('opacity-100');
      } else {
        scrollTopBtn.classList.add('opacity-0', 'pointer-events-none');
        scrollTopBtn.classList.remove('opacity-100');
      }
    }
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const scrollToTop = () => window.scrollTo({ top: 0, behavior: 'smooth' });
  document.getElementById('back-to-top')?.addEventListener('click', scrollToTop);
  scrollTopBtn?.addEventListener('click', scrollToTop);

  // ==========================================
  // 2. 代码块复制按钮
  // ==========================================
  async function copyText(text: string): Promise<boolean> {
    if (navigator.clipboard?.writeText) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {}
    }
    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.setAttribute('readonly', '');
    textarea.style.position = 'fixed';
    textarea.style.top = '-9999px';
    document.body.appendChild(textarea);
    let copied = false;
    try {
      textarea.select();
      copied = document.execCommand('copy');
    } catch {}
    textarea.remove();
    return copied;
  }

  document.querySelectorAll('.prose pre').forEach((pre) => {
    const wrapper = document.createElement('div');
    wrapper.className = 'code-block-wrapper';
    pre.parentNode?.insertBefore(wrapper, pre);
    wrapper.appendChild(pre);

    const btn = document.createElement('button');
    btn.className = 'code-copy-btn';
    btn.innerHTML = '<span>复制</span>';
    btn.addEventListener('click', async () => {
      const code = pre.querySelector('code')?.textContent || pre.textContent || '';
      const copied = await copyText(code);
      btn.classList.toggle('copied', copied);
      btn.innerHTML = `<span>${copied ? '已复制' : '复制失败'}</span>`;
      setTimeout(() => {
        btn.classList.remove('copied');
        btn.innerHTML = '<span>复制</span>';
      }, 2000);
    });
    wrapper.appendChild(btn);
  });

  // ==========================================
  // 3. 图片灯箱
  // ==========================================
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lightboxClose = document.getElementById('lightbox-close');
  let lightboxTrigger: HTMLImageElement | null = null;

  document.querySelectorAll('.prose img').forEach((img) => {
    const openLightbox = () => {
      if (lightbox && lightboxImg) {
        lightboxTrigger = img;
        lightboxImg.src = img.src;
        lightboxImg.alt = img.alt;
        lightbox.classList.add('active');
        lightbox.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        lightboxClose?.focus();
      }
    };
    // 让图片可通过键盘聚焦并打开（Esc 关闭后焦点能回到图片）
    img.tabIndex = 0;
    img.setAttribute('role', 'button');
    img.setAttribute('aria-label', `查看大图${img.alt ? '：' + img.alt : ''}`);
    img.addEventListener('click', openLightbox);
    img.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        openLightbox();
      }
    });
  });

  const closeLightbox = () => {
    if (lightbox && lightbox.classList.contains('active')) {
      lightbox.classList.remove('active');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      lightboxTrigger?.focus();
      lightboxTrigger = null;
    }
  };

  lightbox?.addEventListener('click', closeLightbox);
  lightboxClose?.addEventListener('click', (event) => {
    event.stopPropagation();
    closeLightbox();
  });

  // ==========================================
  // 4. 图片懒加载渐入
  // ==========================================
  const proseImgs = document.querySelectorAll<HTMLImageElement>('.prose img');
  if ('IntersectionObserver' in window) {
    const imgObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('loaded');
          imgObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    proseImgs.forEach((img) => {
      img.loading = 'lazy';
      img.decoding = 'async';
      img.classList.add('img-lazy');
      if (img.getBoundingClientRect().top < window.innerHeight) {
        img.classList.add('loaded');
      } else {
        imgObserver.observe(img);
      }
    });
  }

  // ==========================================
  // 5. 返回上次阅读位置
  // ==========================================
  const pageId = location.pathname;
  const SCROLL_POS_KEY = 'scroll_pos_';
  const savedPos = sessionStorage.getItem(SCROLL_POS_KEY + pageId);
  if (savedPos) {
    const pos = parseInt(savedPos, 10);
    if (!isNaN(pos) && pos > 0) {
      requestAnimationFrame(() => {
        window.scrollTo({ top: pos, behavior: 'instant' as ScrollBehavior });
      });
    }
  }
  window.addEventListener('pagehide', () => {
    sessionStorage.setItem(SCROLL_POS_KEY + pageId, String(window.scrollY));
  });
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'hidden') {
      sessionStorage.setItem(SCROLL_POS_KEY + pageId, String(window.scrollY));
    }
  });

  // ==========================================
  // 6. 键盘快捷键
  // ==========================================
  const toast = document.getElementById('shortcut-toast');
  function showToast(msg: string) {
    if (!toast) return;
    toast.innerHTML = msg;
    toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), 1500);
  }

  function isTypingTarget(target: EventTarget | null): boolean {
    if (!(target instanceof HTMLElement)) return false;
    const tag = target.tagName;
    return tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || target.isContentEditable;
  }

  document.addEventListener('keydown', (event) => {
    // 用事件目标判断，避免“聚焦过输入框后标记一直为 true”导致快捷键失效
    if (isTypingTarget(event.target)) return;
    if (event.key === 'Escape') {
      closeLightbox();
      return;
    }
    if (event.key === 't' && !event.ctrlKey && !event.metaKey && !event.altKey) {
      event.preventDefault();
      scrollToTop();
      showToast('<kbd>T</kbd> 回到顶部');
    }
  });
</script>
