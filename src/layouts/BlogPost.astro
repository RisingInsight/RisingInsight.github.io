---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import TableOfContents from '../components/TableOfContents.astro';
import AuthorCard from '../components/AuthorCard.astro';
import { getTagColor, getReadTime } from '../utils/blog';

type Props = CollectionEntry<'blog'>['data'] & { id?: string; body?: string };

const { title, description, pubDate, updatedDate, heroImage, tags, categories, body, series } = Astro.props;

// 计算阅读时间
const readTime = getReadTime(body || '');

// 面包屑
const breadcrumbItems = [
  { label: '首页', href: '/' },
  { label: '文章', href: '/blog/' },
  ...(categories && categories.length > 0 ? [{ label: categories[0] }] : []),
  { label: title },
];

// 相关文章（同标签，排除自身）
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const postId = Astro.props.id || '';
const relatedPosts = allPosts
  .filter(p => p.id !== postId && p.data.tags?.some((t: string) => tags?.includes(t)))
  .slice(0, 3);

// 系列文章
let seriesPosts: { id: string; title: string; slug: string }[] = [];
if (series) {
  seriesPosts = allPosts
    .filter(p => p.data.series === series && p.id !== postId)
    .map(p => ({ id: p.id, title: p.data.title, slug: p.id }));
}
---

<html lang="zh-CN">
  <head>
    <BaseHead title={`${title} | RisingInsight's Blog`} description={description} type="article" />
  </head>
  <body>
    <Header />

    <!-- 阅读进度条 -->
    <div id="reading-progress" class="reading-progress" style="width: 0%"></div>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 pt-10 pb-20">
      <div class="flex gap-8 lg:gap-12">
        <!-- 左侧：作者卡片（大屏显示） -->
        <aside class="hidden lg:block w-52 flex-shrink-0">
          <AuthorCard />
        </aside>

        <!-- 中间：文章主体 -->
        <div class="min-w-0 flex-1 max-w-3xl">
      <article>
        <!-- 面包屑 -->
        <Breadcrumb items={breadcrumbItems} />

        <!-- 文章头部 -->
        <header class="mb-10 animate-fade-up">
          <!-- 系列标签 -->
          {series && (
            <div class="mb-4">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-primary/10 text-primary dark:text-primary-light text-xs font-semibold">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
                系列：{series}
              </span>
            </div>
          )}

          <!-- 标签 -->
          {tags && tags.length > 0 && (
            <div class="flex flex-wrap gap-2 mb-5">
              {tags.map((tag) => (
                <span class={`tag ${getTagColor(tag)}`}>{tag}</span>
              ))}
            </div>
          )}

          <!-- 标题 -->
          <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white leading-tight mb-5 tracking-tight">
            {title}
          </h1>

          <!-- 描述 -->
          <p class="text-lg text-slate-500 dark:text-slate-400 mb-6 leading-relaxed">
            {description}
          </p>

          <!-- 元信息 -->
          <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-slate-400 dark:text-slate-500 pb-6 border-b border-slate-200 dark:border-slate-700">
            <div class="flex items-center gap-1.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <time datetime={pubDate.toISOString()}>
                <FormattedDate date={pubDate} />
              </time>
            </div>
            {updatedDate && (
              <div class="flex items-center gap-1.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                <time datetime={updatedDate.toISOString()}>
                  更新 <FormattedDate date={updatedDate} />
                </time>
              </div>
            )}
            {categories && categories.length > 0 && (
              <div class="flex items-center gap-1.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                </svg>
                <span>{categories.join(' / ')}</span>
              </div>
            )}
            <div class="flex items-center gap-1.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>{readTime}</span>
            </div>
            <!-- 访问量 -->
            <div class="flex items-center gap-1.5" id="view-count-container">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
              <span id="view-count">...</span>
            </div>
          </div>

          <!-- 封面图 -->
          {heroImage && (
            <div class="mt-8 rounded-2xl overflow-hidden shadow-lg">
              <img src={heroImage} alt={title} class="w-full" loading="lazy" />
            </div>
          )}
        </header>

        <!-- 文章正文 -->
        <!-- TOC：浮动目录用 fixed 定位不受位置影响，内嵌折叠目录在此显示 -->
        <TableOfContents />
        <div class="prose animate-fade-up animate-delay-1">
          <slot />
        </div>

        <!-- 系列文章导航 -->
        {series && seriesPosts.length > 0 && (
          <div class="mt-12 p-5 rounded-2xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200/60 dark:border-slate-700/40">
            <h3 class="text-sm font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-3 flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
              系列目录
            </h3>
            <div class="space-y-2">
              {seriesPosts.map(p => (
                <a href={`/blog/${p.slug}/`} class="series-nav">
                  <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                  <span class="truncate">{p.title}</span>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- 相关文章推荐 -->
        {relatedPosts.length > 0 && (
          <div class="mt-12">
            <h3 class="text-sm font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-4 flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
              相关推荐
            </h3>
            <div class="grid gap-3">
              {relatedPosts.map(p => {
                const postTags = p.data.tags || [];
                return (
                  <a href={`/blog/${p.id}/`} class="related-post-card group">
                    <div class="flex-1 min-w-0">
                      <h4 class="text-sm font-semibold text-slate-700 dark:text-slate-300 group-hover:text-primary dark:group-hover:text-primary-light transition-colors truncate">
                        {p.data.title}
                      </h4>
                      <div class="flex items-center gap-2 mt-1 text-xs text-slate-400 dark:text-slate-500">
                        <time>{p.data.pubDate.toLocaleDateString('zh-CN', { month: 'short', day: 'numeric' })}</time>
                        <span>·</span>
                        <span>{getReadTime(p.body || '')}</span>
                      </div>
                    </div>
                    <svg class="w-4 h-4 text-slate-300 dark:text-slate-600 group-hover:text-primary dark:group-hover:text-primary-light transition-colors flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                  </a>
                );
              })}
            </div>
          </div>
        )}

        <!-- 点赞 + 文章底部操作 -->
        <div class="mt-10 pt-8 border-t border-slate-200 dark:border-slate-700">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              <button id="like-btn" class="like-btn" aria-label="点赞">
                <svg class="w-5 h-5 heart-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
                <span id="like-count">0</span>
              </button>
              <button
                id="back-to-top"
                class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-slate-500 dark:text-slate-400 hover:text-primary dark:hover:text-primary-light bg-slate-100 dark:bg-slate-800 hover:bg-primary/5 dark:hover:bg-primary/10 rounded-xl transition-all"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
                </svg>
                返回顶部
              </button>
            </div>

            <a
              href="/blog/"
              class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-slate-500 dark:text-slate-400 hover:text-primary dark:hover:text-primary-light bg-slate-100 dark:bg-slate-800 hover:bg-primary/5 dark:hover:bg-primary/10 rounded-xl transition-all"
            >
              全部文章
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>

        <!-- 上下篇导航 -->
        <nav id="post-nav" class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4"></nav>

        <!-- Giscus 评论区 -->
        <div class="giscus-wrapper">
          <div class="giscus"></div>
        </div>
      </article>
        </div>
      </div>
    </main>

    <!-- 全局回到顶部浮动按钮 -->
    <button
      id="scroll-top-btn"
      class="fixed bottom-6 right-6 z-40 w-11 h-11 flex items-center justify-center rounded-full bg-primary text-white shadow-lg shadow-primary/30 opacity-0 pointer-events-none transition-all duration-300 hover:-translate-y-1 hover:shadow-xl"
      aria-label="回到顶部"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
      </svg>
    </button>

    <!-- 键盘快捷键提示 -->
    <div id="shortcut-toast" class="shortcut-toast"></div>

    <Footer />

    <!-- 图片灯箱 -->
    <div id="lightbox" class="lightbox-overlay">
      <button id="lightbox-close" class="lightbox-close" aria-label="关闭">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
      <img id="lightbox-img" src="" alt="" />
    </div>
  </body>
</html>

<script>
  // ==========================================
  // 1. 阅读进度条 + 浮动回到顶部按钮
  // ==========================================
  const progressBar = document.getElementById('reading-progress');
  const scrollTopBtn = document.getElementById('scroll-top-btn');

  function onScroll() {
    const scrollTop = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
    if (progressBar) {
      progressBar.style.width = progress + '%';
    }
    if (scrollTopBtn) {
      if (scrollTop > 300) {
        scrollTopBtn.classList.remove('opacity-0', 'pointer-events-none');
        scrollTopBtn.classList.add('opacity-100');
      } else {
        scrollTopBtn.classList.add('opacity-0', 'pointer-events-none');
        scrollTopBtn.classList.remove('opacity-100');
      }
    }
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const scrollToTop = () => window.scrollTo({ top: 0, behavior: 'smooth' });
  document.getElementById('back-to-top')?.addEventListener('click', scrollToTop);
  scrollTopBtn?.addEventListener('click', scrollToTop);

  // ==========================================
  // 2. 代码块复制按钮
  // ==========================================
  document.querySelectorAll('.prose pre').forEach(pre => {
    const wrapper = document.createElement('div');
    wrapper.className = 'code-block-wrapper';
    pre.parentNode?.insertBefore(wrapper, pre);
    wrapper.appendChild(pre);

    const btn = document.createElement('button');
    btn.className = 'code-copy-btn';
    btn.innerHTML = `<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg><span>复制</span>`;
    btn.addEventListener('click', () => {
      const code = pre.querySelector('code')?.textContent || pre.textContent || '';
      navigator.clipboard.writeText(code).then(() => {
        btn.classList.add('copied');
        btn.innerHTML = `<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg><span>已复制</span>`;
        setTimeout(() => {
          btn.classList.remove('copied');
          btn.innerHTML = `<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg><span>复制</span>`;
        }, 2000);
      });
    });
    wrapper.appendChild(btn);
  });

  // ==========================================
  // 3. 文章点赞（localStorage）
  // ==========================================
  const likeBtn = document.getElementById('like-btn') as HTMLButtonElement;
  const likeCount = document.getElementById('like-count');
  const STORAGE_KEY_LIKES = 'blog_likes';
  const STORAGE_KEY_LIKED = 'blog_liked';
  const pageId = location.pathname;

  function getLikes(): Record<string, number> {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY_LIKES) || '{}'); } catch { return {}; }
  }
  function getLiked(): string[] {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY_LIKED) || '[]'); } catch { return []; }
  }

  if (likeBtn && likeCount) {
    const likes = getLikes();
    const liked = getLiked();
    likeCount.textContent = likes[pageId] || 0;
    if (liked.includes(pageId)) {
      likeBtn.classList.add('liked');
      (likeBtn.querySelector('.heart-icon') as SVGElement)?.setAttribute('fill', 'currentColor');
    }

    likeBtn.addEventListener('click', () => {
      const allLikes = getLikes();
      const allLiked = getLiked();
      if (allLiked.includes(pageId)) {
        allLiked.splice(allLiked.indexOf(pageId), 1);
        allLikes[pageId] = Math.max(0, (allLikes[pageId] || 1) - 1);
        likeBtn.classList.remove('liked');
        (likeBtn.querySelector('.heart-icon') as SVGElement)?.setAttribute('fill', 'none');
      } else {
        allLiked.push(pageId);
        allLikes[pageId] = (allLikes[pageId] || 0) + 1;
        likeBtn.classList.add('liked');
        (likeBtn.querySelector('.heart-icon') as SVGElement)?.setAttribute('fill', 'currentColor');
      }
      localStorage.setItem(STORAGE_KEY_LIKES, JSON.stringify(allLikes));
      localStorage.setItem(STORAGE_KEY_LIKED, JSON.stringify(allLiked));
      likeCount.textContent = allLikes[pageId];
    });
  }

  // ==========================================
  // 4. 图片灯箱
  // ==========================================
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lightboxClose = document.getElementById('lightbox-close');

  document.querySelectorAll('.prose img').forEach(img => {
    img.addEventListener('click', () => {
      if (lightbox && lightboxImg) {
        lightboxImg.src = img.src;
        lightboxImg.alt = img.alt;
        lightbox.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
    });
  });

  const closeLightbox = () => {
    if (lightbox) {
      lightbox.classList.remove('active');
      document.body.style.overflow = '';
    }
  };

  lightbox?.addEventListener('click', closeLightbox);
  lightboxClose?.addEventListener('click', (e) => {
    e.stopPropagation();
    closeLightbox();
  });

  // ==========================================
  // 5. 图片懒加载渐入动画
  // ==========================================
  const proseImgs = document.querySelectorAll('.prose img');
  if ('IntersectionObserver' in window) {
    const imgObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('loaded');
          imgObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    proseImgs.forEach(img => {
      img.classList.add('img-lazy');
      // 如果图片已经在视口内，直接显示
      if (img.getBoundingClientRect().top < window.innerHeight) {
        img.classList.add('loaded');
      } else {
        imgObserver.observe(img);
      }
    });
  }

  // ==========================================
  // 6. 返回上次阅读位置
  // ==========================================
  const SCROLL_POS_KEY = 'scroll_pos_';
  // 恢复位置
  const savedPos = sessionStorage.getItem(SCROLL_POS_KEY + pageId);
  if (savedPos) {
    const pos = parseInt(savedPos, 10);
    if (!isNaN(pos) && pos > 0) {
      requestAnimationFrame(() => {
        window.scrollTo({ top: pos, behavior: 'instant' as ScrollBehavior });
      });
    }
  }
  // 离开页面时保存位置
  window.addEventListener('beforeunload', () => {
    sessionStorage.setItem(SCROLL_POS_KEY + pageId, String(window.scrollY));
  });
  // 30秒自动保存
  setInterval(() => {
    sessionStorage.setItem(SCROLL_POS_KEY + pageId, String(window.scrollY));
  }, 30000);

  // ==========================================
  // 7. 键盘快捷键
  // ==========================================
  const toast = document.getElementById('shortcut-toast');
  function showToast(msg: string) {
    if (!toast) return;
    toast.innerHTML = msg;
    toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), 1500);
  }

  // 文章列表（用于 j/k 导航）— 从上下篇导航推断
  const allArticleLinks: { title: string; href: string }[] = [];
  document.querySelectorAll('#post-nav a').forEach(a => {
    const titleEl = a.querySelector('span:last-child');
    if (titleEl && a.href) {
      allArticleLinks.push({ title: titleEl.textContent || '', href: a.href });
    }
  });
  // 尝试从相关推荐也收集
  document.querySelectorAll('.related-post-card').forEach(a => {
    const titleEl = a.querySelector('h4');
    if (titleEl && a.href && !allArticleLinks.find(l => l.href === a.href)) {
      allArticleLinks.push({ title: titleEl.textContent || '', href: a.href });
    }
  });

  let isSearchFocused = false;
  document.addEventListener('focusin', () => {
    isSearchFocused = document.activeElement?.tagName === 'INPUT' || document.activeElement?.tagName === 'TEXTAREA';
  });

  document.addEventListener('keydown', (e) => {
    if (isSearchFocused) return;

    if (e.key === 'Escape') {
      closeLightbox();
      return;
    }
    if (e.key === 't' && !e.ctrlKey && !e.metaKey && !e.altKey) {
      e.preventDefault();
      scrollToTop();
      showToast(`<kbd>T</kbd> 回到顶部`);
    }
    if (e.key === 'j' && !e.ctrlKey && !e.metaKey && !e.altKey && allArticleLinks.length > 0) {
      // 下一篇文章（通常是 nextPost，索引 1 或 0）
      const next = allArticleLinks[0];
      if (next) {
        showToast(`<kbd>J</kbd> ${next.title}`);
        setTimeout(() => location.href = next.href, 600);
      }
    }
    if (e.key === 'k' && !e.ctrlKey && !e.metaKey && !e.altKey && allArticleLinks.length > 1) {
      const prev = allArticleLinks[1];
      if (prev) {
        showToast(`<kbd>K</kbd> ${prev.title}`);
        setTimeout(() => location.href = prev.href, 600);
      }
    }
  });

  // ==========================================
  // 8. 不蒜子访问量统计
  // ==========================================
  const viewCountEl = document.getElementById('view-count');
  if (viewCountEl) {
    // 动态加载不蒜子脚本
    const script = document.createElement('script');
    script.src = 'https://busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js';
    script.async = true;
    document.head.appendChild(script);
    // 等待脚本加载完成后获取数据
    script.onload = () => {
      // 不蒜子使用 span 标签自动填充，需要特殊处理
      // 使用 fetch 获取 pv 数据
      fetch(`https://busuanzi.ibruce.info/busuanzi?jsonpCallback=busuanziCallBack_${Date.now()}`)
        .then(r => r.text())
        .then(() => {
          // 不蒜子会自动统计，我们用简单方式显示
          const el = document.getElementById('view-count');
          if (el) {
            // 不蒜子会在页面中创建数据，但跨域限制可能无法直接访问
            // 使用简单的 localStorage 计数作为备选
          }
        });
    };
    // 备选：本地计数
    const LOCAL_VIEW_KEY = 'local_views';
    const views = JSON.parse(localStorage.getItem(LOCAL_VIEW_KEY) || '{}');
    if (!views[pageId]) views[pageId] = 0;
    // 仅在首次访问时 +1
    const sessionViewed = sessionStorage.getItem('viewed_' + pageId);
    if (!sessionViewed) {
      views[pageId]++;
      sessionStorage.setItem('viewed_' + pageId, '1');
      localStorage.setItem(LOCAL_VIEW_KEY, JSON.stringify(views));
    }
    viewCountEl.textContent = views[pageId] + ' 阅读';
  }
</script>

