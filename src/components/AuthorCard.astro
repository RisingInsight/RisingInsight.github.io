---
import { SOCIALS, PROFILE } from '../consts';

const socialLinks = SOCIALS.filter(s => s.icon === 'github' || s.icon === 'mail');
---

<div class="author-card sticky top-24">
  <div class="flex flex-col items-center text-center rounded-2xl bg-white/90 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/40 shadow-sm hover:shadow-md transition-shadow overflow-hidden backdrop-blur-sm">

    <!-- 顶部装饰渐变条 -->
    <div class="w-full h-1 bg-gradient-to-r from-primary/60 via-primary to-primary/60 dark:from-primary-light/50 dark:via-primary-light dark:to-primary-light/50"></div>

    <!-- 可点击区域：头像 + 信息 -->
    <a href="/about/" class="w-full group block">

      <!-- 头像区域 -->
      <div class="pt-5 pb-3 px-5">
        <div class="relative inline-block">
          <img
            src="/avatar.jpg"
            alt={PROFILE.name}
            class="w-18 h-18 rounded-full ring-[3px] ring-slate-100 dark:ring-slate-700 group-hover:ring-primary/30 dark:group-hover:ring-primary-light/30 transition-all shadow-md"
          />
          <span class="absolute -bottom-0.5 -right-0.5 w-4 h-4 bg-green-400 border-[2.5px] border-white dark:border-slate-800 rounded-full shadow-sm"></span>
        </div>
      </div>

      <!-- 名字 + 角色 -->
      <div class="px-5 pb-2">
        <h3 class="text-sm font-bold text-slate-900 dark:text-white group-hover:text-primary dark:group-hover:text-primary-light transition-colors">
          {PROFILE.name}
        </h3>
        <p class="text-xs text-slate-400 dark:text-slate-500 mt-0.5 font-medium">
          {PROFILE.role}
        </p>
      </div>

      <!-- 简介区域 -->
      <div class="px-5 pb-4 pt-1">
        <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
          {PROFILE.bio}
        </p>
      </div>
    </a>

    <!-- 分隔线 -->
    <div class="w-full h-px bg-slate-100 dark:bg-slate-700/50"></div>

    <!-- 社交图标区域 -->
    <div class="flex items-center justify-center gap-3 py-3.5 px-5">
      {socialLinks.map((s) => (
        <a
          href={s.href}
          target="_blank"
          rel="noopener noreferrer"
          class="w-8 h-8 flex items-center justify-center rounded-lg text-slate-400 dark:text-slate-500 hover:text-primary dark:hover:text-primary-light hover:bg-primary/8 dark:hover:bg-primary-light/10 transition-all"
          aria-label={s.name}
          title={s.name}
        >
          {s.icon === 'github' && (
            <svg class="w-[15px] h-[15px]" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          )}
          {s.icon === 'mail' && (
            <svg class="w-[15px] h-[15px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          )}
        </a>
      ))}
    </div>
  </div>
</div>

<style>
  .author-card .w-18 {
    width: 4.5rem;
    height: 4.5rem;
  }
  .author-card .hover\:bg-primary\/8:hover {
    background-color: color-mix(in srgb, var(--color-primary) 8%, transparent);
  }
</style>
