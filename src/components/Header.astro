---
import { NAV_ITEMS, PROFILE } from '../consts';
import ThemeToggle from './ThemeToggle.astro';
import SearchModal from './SearchModal.astro';

// 去掉尾斜杠后，首页 href="/" 变成空字符串
const pathname = Astro.url.pathname.replace(/\/$/, '');

function isNavActive(currentPath: string, itemHref: string): boolean {
  const itemPath = itemHref.replace(/\/$/, '');
  if (itemPath === '') return currentPath === '';
  return currentPath === itemPath || currentPath.startsWith(itemPath + '/');
}
---

<header data-pagefind-ignore class="sticky top-0 z-40 border-b border-rule/80 bg-paper/95 backdrop-blur-md">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8" aria-label="主导航">
    <a href="/" class="group flex items-center gap-3">
      <span class="flex h-8 w-8 items-center justify-center border border-rule font-mono text-[10px] tracking-[0.14em] text-accent transition-colors group-hover:border-accent">
        RI
      </span>
      <span class="hidden font-serif text-[17px] font-semibold tracking-tight text-ink transition-colors group-hover:text-accent sm:block">
        {PROFILE.name}
      </span>
    </a>

    <div class="hidden items-center gap-4 sm:flex md:gap-5 lg:gap-6">
      {NAV_ITEMS.map((item) => {
        const isActive = isNavActive(pathname, item.href);
        return (
          <a
            href={item.href}
            aria-current={isActive ? 'page' : undefined}
            class:list={[
              'relative py-2 text-[13px] tracking-wide transition-colors',
              isActive ? 'text-ink' : 'text-muted hover:text-ink',
            ]}
          >
            {item.label}
            {isActive && <span class="absolute inset-x-0 -bottom-1 h-px bg-accent"></span>}
          </a>
        );
      })}
      <span class="h-4 w-px bg-rule"></span>
      <button
        data-search-trigger
        class="rounded-md p-2 text-muted transition-colors hover:bg-rule-soft hover:text-ink lg:hidden"
        aria-label="搜索"
        aria-controls="search-modal"
        aria-haspopup="dialog"
        title="搜索文章 (Ctrl+K)"
      >
        <svg class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </button>
      <button
        data-search-trigger
        class="hidden h-8 w-48 items-center gap-2 border border-rule bg-surface/70 px-2.5 text-left text-[12px] text-muted transition-colors hover:border-muted-light hover:text-ink lg:flex xl:w-56"
        aria-label="搜索文章"
        aria-controls="search-modal"
        aria-haspopup="dialog"
        title="搜索文章 (Ctrl+K)"
      >
        <svg class="h-3.5 w-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span class="flex-1 truncate">搜索笔记</span>
        <kbd class="border border-rule bg-paper px-1 py-0.5 font-mono text-[8px] uppercase tracking-[0.08em] text-muted-light">
          Ctrl K
        </kbd>
      </button>
      <ThemeToggle />
    </div>

    <div class="flex items-center gap-0.5 sm:hidden">
      <button
        data-search-trigger
        class="rounded-md p-2 text-muted transition-colors hover:bg-rule-soft hover:text-ink"
        aria-label="搜索"
        aria-controls="search-modal"
        aria-haspopup="dialog"
        title="搜索文章"
      >
        <svg class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </button>
      <ThemeToggle />
      <button
        id="mobile-menu-btn"
        class="rounded-md p-2 text-muted transition-colors hover:bg-rule-soft hover:text-ink"
        aria-label="打开菜单"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="menu-icon-open" class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg id="menu-icon-close" class="hidden h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-rule bg-paper sm:hidden">
    <div class="px-4 py-2">
      {NAV_ITEMS.map((item) => {
        const isActive = isNavActive(pathname, item.href);
        return (
          <a
            href={item.href}
            aria-current={isActive ? 'page' : undefined}
            class:list={[
              'flex items-center justify-between border-b border-rule-soft py-3.5 font-serif text-lg transition-colors last:border-b-0',
              isActive ? 'text-accent' : 'text-ink hover:text-accent',
            ]}
          >
            <span>{item.label}</span>
            <span class="font-mono text-[10px] text-muted-light">→</span>
          </a>
        );
      })}
    </div>
  </div>
</header>

<SearchModal />

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  btn?.addEventListener('click', () => {
    const isHidden = menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden', !isHidden);
    iconClose?.classList.toggle('hidden', isHidden);
    btn.setAttribute('aria-expanded', String(!isHidden));
  });
</script>
