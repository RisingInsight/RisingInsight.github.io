---
import { NAV_ITEMS, PROFILE, GITHUB_USERNAME } from '../consts';
import ThemeToggle from './ThemeToggle.astro';
import SearchModal from './SearchModal.astro';

// 去掉尾斜杠后，首页 href="/" 变成空字符串
const pathname = Astro.url.pathname.replace(/\/$/, '');

function isNavActive(currentPath: string, itemHref: string): boolean {
  const itemPath = itemHref.replace(/\/$/, '');
  if (itemPath === '') return currentPath === '';
  return currentPath === itemPath || currentPath.startsWith(itemPath + '/');
}

const buildDate = new Date().toISOString().slice(0, 10).replace(/-/g, '.');
---

<header data-pagefind-ignore class="sticky top-0 z-40 border-b border-rule/80 bg-paper/80 backdrop-blur-xl">
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8" aria-label="主导航">
    <a href="/" class="group flex shrink-0 items-center gap-3">
      <span class="relative flex h-9 w-9 items-center justify-center border border-accent/35 bg-accent-soft font-mono text-[10px] tracking-[0.08em] text-accent transition-all group-hover:border-accent group-hover:shadow-[0_0_24px_rgba(94,234,212,.18)]">
        RI
        <span class="absolute -right-0.5 -top-0.5 h-1.5 w-1.5 rounded-full bg-accent shadow-[0_0_8px_var(--accent)]"></span>
      </span>
      <span class="hidden sm:block">
        <span class="block font-serif text-[16px] font-semibold leading-tight tracking-[-0.02em] text-ink transition-colors group-hover:text-accent">
          {PROFILE.name}
        </span>
        <span class="mt-0.5 block font-mono text-[8px] uppercase tracking-[0.2em] text-muted-light">
          engineering log
        </span>
      </span>
    </a>

    <div class="hidden items-center gap-4 sm:flex md:gap-5 lg:gap-6">
      {NAV_ITEMS.map((item) => {
        const isActive = isNavActive(pathname, item.href);
        return (
          <a
            href={item.href}
            aria-current={isActive ? 'page' : undefined}
            class:list={[
              'relative py-2 font-mono text-[10px] uppercase tracking-[0.1em] transition-colors',
              isActive ? 'text-accent' : 'text-muted hover:text-ink',
            ]}
          >
            {item.label}
            {isActive && <span class="absolute inset-x-0 -bottom-1 h-px bg-accent shadow-[0_0_8px_var(--accent)]"></span>}
          </a>
        );
      })}
      <span class="h-4 w-px bg-rule"></span>
      <button
        data-search-trigger
        class="rounded p-2 text-muted transition-colors hover:bg-rule-soft hover:text-accent lg:hidden"
        aria-label="搜索"
        aria-controls="search-modal"
        aria-haspopup="dialog"
        title="搜索文章 (Ctrl+K)"
      >
        <svg class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </button>
      <button
        data-search-trigger
        class="hidden h-8 w-48 items-center gap-2 border border-rule bg-surface/60 px-2.5 text-left font-mono text-[10px] text-muted transition-all hover:border-accent/50 hover:text-ink hover:shadow-[0_0_24px_rgba(94,234,212,.08)] lg:flex xl:w-56"
        aria-label="搜索文章"
        aria-controls="search-modal"
        aria-haspopup="dialog"
        title="搜索文章 (Ctrl+K)"
      >
        <span class="text-accent">$</span>
        <span class="flex-1 truncate">grep notes...</span>
        <kbd class="border border-rule bg-paper px-1 py-0.5 text-[8px] uppercase tracking-[0.08em] text-muted-light">
          Ctrl K
        </kbd>
      </button>
      <a
        href={`https://github.com/${GITHUB_USERNAME}`}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden rounded p-2 text-muted transition-colors hover:bg-rule-soft hover:text-accent lg:inline-flex"
        aria-label="GitHub"
        title="GitHub"
      >
        <svg class="h-[18px] w-[18px]" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.69 5.41-5.25 5.69.41.35.78 1.05.78 2.12 0 1.53-.01 2.76-.01 3.14 0 .31.21.67.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
        </svg>
      </a>
      <ThemeToggle />
    </div>

    <div class="flex items-center gap-0.5 sm:hidden">
      <button
        data-search-trigger
        class="rounded p-2 text-muted transition-colors hover:bg-rule-soft hover:text-accent"
        aria-label="搜索"
        aria-controls="search-modal"
        aria-haspopup="dialog"
        title="搜索文章"
      >
        <svg class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </button>
      <ThemeToggle />
      <button
        id="mobile-menu-btn"
        class="rounded p-2 text-muted transition-colors hover:bg-rule-soft hover:text-accent"
        aria-label="打开菜单"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="menu-icon-open" class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg id="menu-icon-close" class="hidden h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </nav>

  <div class="hidden border-t border-rule/60 md:block">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-1.5 font-mono text-[8px] uppercase tracking-[0.16em] text-muted-light sm:px-6 lg:px-8">
      <span class="flex items-center gap-2">
        <span class="status-dot"></span>
        system online
      </span>
      <span class="hidden lg:inline">astro@6 · github pages</span>
      <span>build {buildDate}</span>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-rule bg-paper/95 backdrop-blur-xl sm:hidden">
    <div class="px-4 py-2">
      {NAV_ITEMS.map((item) => {
        const isActive = isNavActive(pathname, item.href);
        return (
          <a
            href={item.href}
            aria-current={isActive ? 'page' : undefined}
            class:list={[
              'flex items-center justify-between border-b border-rule-soft py-3.5 font-mono text-[11px] uppercase tracking-[0.1em] transition-colors last:border-b-0',
              isActive ? 'text-accent' : 'text-ink hover:text-accent',
            ]}
          >
            <span>{item.label}</span>
            <span class="text-[10px] text-muted-light">→</span>
          </a>
        );
      })}
    </div>
    <div class="flex items-center justify-between border-t border-rule px-4 py-3 font-mono text-[8px] uppercase tracking-[0.14em] text-muted-light">
      <span class="flex items-center gap-2"><span class="status-dot"></span> online</span>
      <a href={`https://github.com/${GITHUB_USERNAME}`} target="_blank" rel="noopener noreferrer" class="hover:text-accent">github ↗</a>
    </div>
  </div>
</header>

<SearchModal />

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  btn?.addEventListener('click', () => {
    const isHidden = menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden', !isHidden);
    iconClose?.classList.toggle('hidden', isHidden);
    btn.setAttribute('aria-expanded', String(!isHidden));
  });
</script>
