---
import { NAV_ITEMS, GITHUB_USERNAME } from '../consts';
import ThemeToggle from './ThemeToggle.astro';
import SearchModal from './SearchModal.astro';

// 去掉尾斜杠后，首页 href="/" 变成空字符串
const pathname = Astro.url.pathname.replace(/\/$/, '');

function isNavActive(currentPath: string, itemHref: string): boolean {
  const itemPath = itemHref.replace(/\/$/, '');
  if (itemPath === '') return currentPath === '';
  return currentPath === itemPath || currentPath.startsWith(itemPath + '/');
}
---

<header
  id="site-header"
  data-site-header
  data-pagefind-ignore
  class="sticky top-0 z-40 border-b border-rule/70 bg-paper/85 backdrop-blur-md"
>
  <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8" aria-label="主导航">
    <a href="/" class="group flex shrink-0 items-center gap-2.5" aria-label="返回首页">
      <img
        src="/avatar.jpg"
        alt=""
        width="64"
        height="64"
        class="h-8 w-8 rounded-full border border-rule object-cover"
      />
      <span class="font-serif text-[17px] font-semibold tracking-[.01em] text-ink transition-colors group-hover:text-accent">
        RisingInsight
      </span>
    </a>

    <div class="hidden items-center gap-6 md:flex">
      {NAV_ITEMS.map((item) => {
        const isActive = isNavActive(pathname, item.href);
        return (
          <a
            href={item.href}
            aria-current={isActive ? 'page' : undefined}
            class:list={[
              'nav-link relative shrink-0 whitespace-nowrap py-1.5 text-[14px] transition-colors',
              isActive ? 'is-active font-medium text-ink' : 'text-muted hover:text-ink',
            ]}
          >
            {item.label}
          </a>
        );
      })}
      <span class="h-4 w-px bg-rule" aria-hidden="true"></span>
      <button
        data-search-trigger
        class="flex h-8 items-center gap-2 rounded-full border border-rule bg-surface px-3 text-[13px] text-muted transition-colors hover:border-muted-light hover:text-ink"
        aria-label="搜索文章"
        aria-controls="search-modal"
        aria-haspopup="dialog"
        title="搜索文章 (Ctrl+K)"
      >
        <svg class="h-[15px] w-[15px]" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span class="hidden lg:inline">搜索</span>
        <kbd class="hidden border border-rule bg-paper-alt px-1.5 py-0.5 font-mono text-[11px] text-muted-light lg:inline">
          Ctrl K
        </kbd>
      </button>
      <a
        href={`https://github.com/${GITHUB_USERNAME}`}
        target="_blank"
        rel="noopener noreferrer"
        class="text-muted transition-colors hover:text-ink"
        aria-label="GitHub"
        title="GitHub"
      >
        <svg class="h-[18px] w-[18px]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.69 5.41-5.25 5.69.41.35.78 1.05.78 2.12 0 1.53-.01 2.76-.01 3.14 0 .31.21.67.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
        </svg>
      </a>
      <ThemeToggle />
    </div>

    <div class="flex items-center gap-0.5 md:hidden">
      <button
        data-search-trigger
        class="flex h-10 w-10 items-center justify-center text-muted transition-colors hover:text-ink"
        aria-label="搜索"
        aria-controls="search-modal"
        aria-haspopup="dialog"
        title="搜索文章"
      >
        <svg class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </button>
      <ThemeToggle />
      <button
        id="mobile-menu-btn"
        class="flex h-10 w-10 items-center justify-center text-muted transition-colors hover:text-ink"
        aria-label="打开菜单"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="menu-icon-open" class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg id="menu-icon-close" class="hidden h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-rule bg-paper/95 backdrop-blur-md md:hidden">
    <div class="px-4 py-2">
      {NAV_ITEMS.map((item) => {
        const isActive = isNavActive(pathname, item.href);
        return (
          <a
            href={item.href}
            aria-current={isActive ? 'page' : undefined}
            class:list={[
              'flex items-center justify-between border-b border-rule-soft py-3.5 text-[15px] transition-colors last:border-b-0',
              isActive ? 'font-medium text-accent' : 'text-ink-soft hover:text-ink',
            ]}
          >
            <span>{item.label}</span>
            <span class="text-[13px] text-muted-light" aria-hidden="true">→</span>
          </a>
        );
      })}
    </div>
  </div>
</header>

<SearchModal />

<script>
  // ==========================================
  // 滚动状态：越过 8px 后给 header 加 is-scrolled，强化分隔感
  // ==========================================
  const siteHeader = document.getElementById('site-header');
  if (siteHeader) {
    let ticking = false;
    const syncScrolled = () => {
      siteHeader.classList.toggle('is-scrolled', window.scrollY > 8);
      ticking = false;
    };
    const requestSync = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(syncScrolled);
    };
    window.addEventListener('scroll', requestSync, { passive: true });
    syncScrolled();
  }

  // ==========================================
  // 移动端菜单
  // ==========================================
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  function setMenuOpen(open: boolean) {
    if (!menu || !btn) return;
    menu.classList.toggle('hidden', !open);
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
  }

  btn?.addEventListener('click', () => {
    setMenuOpen(menu?.classList.contains('hidden') ?? false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu && !menu.classList.contains('hidden')) {
      setMenuOpen(false);
      btn?.focus();
    }
  });

  // 点击菜单外部时收起
  document.addEventListener('click', (event) => {
    if (!menu || menu.classList.contains('hidden')) return;
    const target = event.target as Node;
    if (!menu.contains(target) && !btn?.contains(target)) setMenuOpen(false);
  });
</script>

<style>
  header {
    transition: background-color .3s ease, box-shadow .3s ease;
  }

  /* 滚动后：底部出现柔和的落影 */
  header.is-scrolled {
    box-shadow: 0 1px 0 var(--rule), 0 12px 28px -22px rgba(32, 27, 22, .35);
  }

  /* 桌面导航：active 用细下划线表达，不加发光 */
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    border-radius: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform .25s var(--ease-out-expo);
    pointer-events: none;
  }

  .nav-link:hover::after,
  .nav-link.is-active::after {
    transform: scaleX(1);
  }

  /* 触屏：图标按钮命中区 */
  @media (pointer: coarse) {
    #site-header nav :global(button) {
      min-width: 40px;
      min-height: 40px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    header,
    .nav-link::after {
      transition: none;
    }
  }
</style>
