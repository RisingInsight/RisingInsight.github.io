---
/**
 * 访问统计卡（参考 vilstia 侧栏的「访问统计」）
 * 展示值 = VISIT_SEED 起始值 + 不蒜子（busuanzi）真实计数。
 * - SSR 直接渲染 seed：无 "--" 占位、无数字闪跳
 * - busuanzi 异步回报后，hidden span 会被填充，轮询读到即合并显示
 * - busuanzi 拉取失败 / 本地预览：保留 seed 值，安静降级
 */
import { VISIT_SEED } from '../consts';

function fmt(n: number): string {
  if (n >= 10000) {
    return `${parseFloat((n / 10000).toFixed(2))}万`;
  }
  return n.toLocaleString('zh-CN');
}
const seedPv = fmt(VISIT_SEED.pv);
const seedUv = fmt(VISIT_SEED.uv);
---

<section data-visit-stats data-pagefind-ignore>
  <div class="mono-label">访问统计</div>

  <div class="mt-4 grid grid-cols-2 gap-3">
    <div class="visit-cell">
      <svg class="visit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.5 12s3.5-6.5 9.5-6.5S21.5 12 21.5 12s-3.5 6.5-9.5 6.5S2.5 12 2.5 12Z" />
        <circle cx="12" cy="12" r="2.8" />
      </svg>
      <span class="visit-label">总浏览</span>
      <span class="visit-num" data-visit-pv>{seedPv}</span>
    </div>
    <div class="visit-cell">
      <svg class="visit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16 19v-1.2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4V19" />
        <circle cx="9.5" cy="7.5" r="3.2" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 19v-1.2a4 4 0 0 0-3-3.87" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.5 4.6a3.2 3.2 0 0 1 0 5.8" />
      </svg>
      <span class="visit-label">总访客</span>
      <span class="visit-num" data-visit-uv>{seedUv}</span>
    </div>
  </div>

  <!-- busuanzi 官方填充位：脚本会按 id 写入站点计数，页面不可见 -->
  <span id="busuanzi_value_site_pv" hidden>0</span>
  <span id="busuanzi_value_site_uv" hidden>0</span>
</section>

<script define:vars={{ seedPv: VISIT_SEED.pv, seedUv: VISIT_SEED.uv }}>
  (function () {
    var pvEl = document.querySelector('[data-visit-pv]');
    var uvEl = document.querySelector('[data-visit-uv]');
    var srcPv = document.getElementById('busuanzi_value_site_pv');
    var srcUv = document.getElementById('busuanzi_value_site_uv');
    if (!pvEl || !uvEl) return;

    function fmt(n) {
      if (n >= 10000) return parseFloat((n / 10000).toFixed(2)) + '万';
      return n.toLocaleString('zh-CN');
    }
    function parseInt0(text) {
      var n = parseInt(String(text || '').replace(/[^0-9]/g, ''), 10);
      return isNaN(n) ? 0 : n;
    }

    // busuanzi 异步 JSONP 回填 hidden span；轮询探测，读到即合并
    var tries = 0;
    var timer = setInterval(function () {
      tries++;
      var pv = parseInt0(srcPv && srcPv.textContent);
      var uv = parseInt0(srcUv && srcUv.textContent);
      if (pv > 0 || uv > 0) {
        clearInterval(timer);
        pvEl.textContent = fmt(seedPv + pv);
        uvEl.textContent = fmt(seedUv + uv);
      } else if (tries > 16) {
        // ~5s 仍无数据（被墙/离线/本地预览）：保留 seed 展示
        clearInterval(timer);
      }
    }, 300);
  })();
</script>

<style>
  .visit-cell {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    padding: 10px 12px;
    border: 1px solid var(--rule-soft);
    border-radius: var(--r-md);
    background: var(--surface-alt);
  }
  .visit-icon {
    width: 16px;
    height: 16px;
    color: var(--muted-light);
  }
  .visit-label {
    margin-top: 2px;
    font-size: 12px;
    line-height: 1.4;
    color: var(--muted-light);
  }
  .visit-num {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
</style>
