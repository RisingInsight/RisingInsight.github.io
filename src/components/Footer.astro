---
import { SOCIALS, PROFILE } from '../consts';

// 博客创建日期（2026 年 1 月 1 日）
const BLOG_START_DATE = '2026-01-01';
---

<footer data-pagefind-ignore class="border-t border-rule bg-paper-alt/50">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-[1.25fr_.75fr]">
      <div>
        <a href="/" class="font-serif text-xl font-semibold tracking-tight text-ink transition-colors hover:text-accent">
          RisingInsight
        </a>
        <p class="mt-4 max-w-md text-sm leading-7 text-muted">
          {PROFILE.bio}
        </p>
        <p class="mt-1 text-[12px] text-muted-light">
          {PROFILE.role} · {PROFILE.tagline}
        </p>
        <div class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-[12px] text-muted">
          {SOCIALS.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              class="transition-colors hover:text-accent"
            >
              {s.name} <span aria-hidden="true">↗</span>
            </a>
          ))}
          <a href="/rss.xml" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-accent">
            RSS <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-8 text-sm md:justify-items-end">
        <div>
          <div class="font-mono text-[10px] uppercase tracking-[0.16em] text-muted-light">About</div>
          <ul class="mt-3 space-y-2 text-muted">
            <li>{PROFILE.location}</li>
            <li>{PROFILE.school}</li>
            <li>
              已运行 <span id="footer-run-days" class="font-mono text-[12px] text-ink">--</span> 天
            </li>
          </ul>
        </div>
        <div class="md:text-right">
          <div class="font-mono text-[10px] uppercase tracking-[0.16em] text-muted-light">Index</div>
          <ul class="mt-3 space-y-2 text-muted">
            <li><a href="/blog/" class="transition-colors hover:text-accent">笔记</a></li>
            <li><a href="/lab/" class="transition-colors hover:text-accent">实验</a></li>
            <li><a href="/archives/" class="transition-colors hover:text-accent">归档</a></li>
            <li><a href="/about/" class="transition-colors hover:text-accent">关于</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-2 border-t border-rule pt-5 text-[11px] text-muted-light sm:flex-row sm:items-center sm:justify-between">
      <span>© {new Date().getFullYear()} RisingInsight</span>
      <span class="font-mono tracking-[0.04em]">Built with Astro & Tailwind · GitHub Pages</span>
    </div>
  </div>
</footer>

<script define:vars={{ BLOG_START_DATE }}>
  function updateRunDays() {
    var el = document.getElementById('footer-run-days');
    if (!el) return;
    var start = new Date(BLOG_START_DATE);
    var now = new Date();
    var days = Math.floor((now.getTime() - start.getTime()) / (1000 * 60 * 60 * 24));
    el.textContent = days;
  }
  updateRunDays();
</script>
