---
import { SOCIALS, PROFILE } from '../consts';

// 博客创建日期（2026 年 1 月 1 日）
const BLOG_START_DATE = '2026-01-01';
---

<footer class="relative overflow-hidden border-t border-slate-200/80 dark:border-slate-800/60 bg-gradient-to-b from-slate-50 to-slate-100/80 dark:from-slate-900/60 dark:to-slate-950/80">
  <!-- 装饰性背景元素 -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-gradient-to-b from-primary/5 to-transparent dark:from-primary-light/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-8">
    <!-- 主体内容 -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-16">

      <!-- 左：品牌信息 + 社交 -->
      <div>
        <a href="/" class="inline-flex items-center gap-2.5 mb-4 group">
          <img src="/avatar.jpg" alt="avatar" class="w-10 h-10 rounded-xl ring-2 ring-white dark:ring-slate-700 shadow-md group-hover:ring-primary/30 dark:group-hover:ring-primary-light/30 transition-all" />
          <span class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-primary dark:group-hover:text-primary-light transition-colors">{PROFILE.name}</span>
        </a>
        <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed mb-5 max-w-sm">
          {PROFILE.bio}
        </p>
        <!-- 社交图标 -->
        <div class="flex items-center gap-2.5">
          {SOCIALS.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              class="social-btn w-9 h-9 flex items-center justify-center rounded-xl bg-white/80 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/50 text-slate-400 dark:text-slate-500 hover:text-primary dark:hover:text-primary-light hover:border-primary/40 dark:hover:border-primary-light/40 hover:bg-primary/5 dark:hover:bg-primary-light/5 shadow-sm hover:shadow-md transition-all"
              aria-label={s.name}
              title={s.name}
            >
              {s.icon === 'github' && (
                <svg class="w-[16px] h-[16px]" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
              )}
              {s.icon === 'zhihu' && (
                <svg class="w-[16px] h-[16px]" fill="currentColor" viewBox="0 0 24 24"><path d="M5.721 0C2.251 0 0 2.25 0 5.719V18.28C0 21.751 2.252 24 5.721 24h12.56C21.751 24 24 21.75 24 18.281V5.72C24 2.249 21.75 0 18.281 0zm1.964 4.078h5.202c.105 0 .167.054.167.167v5.646c0 .112-.063.166-.167.166H9.793v2.31h4.503c.105 0 .168.054.168.167v5.087H14.01l.012-2.025h1.992l.08 2.025h1.137c.106 0 .169-.054.169-.167V6.778l-1.398.532v1.293h-1.8V6.93l-1.398.564v1.241H10.72V7.25l-1.398.565v1.15H7.477V7.028L6.08 7.57v1.15H4.725V7.56L3.328 8.125v.834h1.397v5.046H3.328v1.678h1.397v2.05H4.86c.105 0 .168-.054.168-.167v-1.883h1.397v2.05h1.398V15.013H9.215V9.057H7.685V4.245zm9.367 0h.29v.776h.767v-.776h.29c.075 0 .136.061.136.136v1.363c0 .075-.061.136-.136.136h-.29v-.776h-.767v.776h-.29a.136.136 0 0 1-.136-.136V4.214c0-.075.061-.136.136-.136z"/></svg>
              )}
              {s.icon === 'csdn' && (
                <svg class="w-[16px] h-[16px]" fill="currentColor" viewBox="0 0 24 24"><path d="M3.5 8.5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1v-2zm7 0a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1v-2zm7 0a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1v-2zM3.5 14.5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1v-2zm7 0a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1v-2zm7 0a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1v-2z"/></svg>
              )}
              {s.icon === 'mail' && (
                <svg class="w-[16px] h-[16px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              )}
            </a>
          ))}
          <!-- RSS 订阅 -->
          <a
            href="/rss.xml"
            target="_blank"
            rel="noopener noreferrer"
            class="social-btn w-9 h-9 flex items-center justify-center rounded-xl bg-white/80 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/50 text-slate-400 dark:text-slate-500 hover:text-orange-500 dark:hover:text-orange-400 hover:border-orange-300 dark:hover:border-orange-500/40 hover:bg-orange-50 dark:hover:bg-orange-500/10 shadow-sm hover:shadow-md transition-all"
            aria-label="RSS 订阅"
            title="RSS 订阅"
          >
            <svg class="w-[16px] h-[16px]" fill="currentColor" viewBox="0 0 24 24"><path d="M6.503 20.752c0 1.794-1.456 3.248-3.251 3.248-1.796 0-3.252-1.454-3.252-3.248 0-1.794 1.456-3.248 3.252-3.248 1.795.001 3.251 1.454 3.251 3.248zm-6.503-12.572v4.811c6.05.062 10.96 4.966 11.022 11.009h4.817c-.062-8.71-7.118-15.758-15.839-15.82zm0-8.18v4.819c12.951.115 23.457 10.622 23.574 23.574h4.426c-.12-15.629-12.819-28.316-28-28.393z"/></svg>
          </a>
        </div>
      </div>

      <!-- 右：关于本站 -->
      <div class="md:text-right">
        <h4 class="text-xs font-semibold text-slate-900 dark:text-white mb-4 uppercase tracking-widest">关于本站</h4>
        <div class="space-y-3">
          <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed">
            {PROFILE.role}
          </p>
          <p class="text-sm text-slate-400 dark:text-slate-500 italic">
            {PROFILE.tagline}
          </p>
          <div class="flex items-center gap-4 pt-1 md:justify-end">
            <div class="flex items-center gap-1.5 text-xs text-slate-400 dark:text-slate-500">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              <span>{PROFILE.location}</span>
            </div>
            <div class="flex items-center gap-1.5 text-xs text-slate-400 dark:text-slate-500">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <span>已运行 <span id="footer-run-days" class="text-primary dark:text-primary-light font-semibold">--</span> 天</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 底部分割线 + 版权 -->
    <div class="mt-10 pt-6 border-t border-slate-200/60 dark:border-slate-800/40 flex flex-col sm:flex-row items-center justify-between gap-3">
      <div class="flex items-center gap-1.5 text-xs text-slate-400 dark:text-slate-500">
        <!-- 小 Logo -->
        <span class="inline-flex items-center justify-center w-5 h-5 rounded-md bg-gradient-to-br from-primary to-primary-dark text-white text-[10px] font-bold shadow-sm">R</span>
        <span>&copy; {new Date().getFullYear()} {PROFILE.name}</span>
      </div>
      <div class="flex items-center gap-1.5 text-xs text-slate-400 dark:text-slate-500">
        <span>Built with</span>
        <span class="inline-flex items-center gap-0.5">
          <span class="text-primary dark:text-primary-light font-medium">Astro</span>
          <span class="text-slate-300 dark:text-slate-600">&</span>
          <span class="text-cyan-600 dark:text-cyan-400 font-medium">Tailwind</span>
        </span>
        <span class="text-slate-300 dark:text-slate-600">·</span>
        <span>Hosted on</span>
        <span class="text-slate-900 dark:text-white font-medium">GitHub Pages</span>
      </div>
    </div>
  </div>
</footer>

<script define:vars={{ BLOG_START_DATE }}>
  // 客户端动态计算运行天数，每天自动更新
  function updateRunDays() {
    var el = document.getElementById('footer-run-days');
    if (!el) return;
    var start = new Date(BLOG_START_DATE);
    var now = new Date();
    var days = Math.floor((now.getTime() - start.getTime()) / (1000 * 60 * 60 * 24));
    el.textContent = days;
  }
  updateRunDays();
</script>
