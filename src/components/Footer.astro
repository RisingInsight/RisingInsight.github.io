---
import { SOCIALS, PROFILE, GITHUB_USERNAME } from '../consts';

const siteNav = [
  { label: '笔记', href: '/blog/' },
  { label: '论文', href: '/papers/' },
  { label: '系列', href: '/series/' },
  { label: '归档', href: '/archives/' },
  { label: '留言', href: '/guestbook/' },
  { label: '关于', href: '/about/' },
];
const moreNav = [
  { label: 'GitHub', href: `https://github.com/${GITHUB_USERNAME}`, external: true },
  { label: '时光机', href: '/moments/', external: false },
  { label: 'RSS', href: '/rss.xml', external: true },
];
---

<footer data-pagefind-ignore class="border-t border-rule">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <a href="/" class="inline-flex items-center gap-2 font-serif text-xl font-semibold text-ink transition-colors hover:text-accent">
          {PROFILE.name}
          <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>
        </a>
        <p class="mt-4 max-w-sm text-sm leading-7 text-muted">{PROFILE.bio} · {PROFILE.tagline}</p>
        <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-[13px] text-muted">
          {SOCIALS.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              class="transition-colors hover:text-accent"
            >
              {s.name} <span aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </div>

      <nav aria-label="站内导航">
        <div class="mono-label">站内</div>
        <ul class="mt-4 space-y-2.5 text-[13px] text-muted">
          {siteNav.map((item) => (
            <li><a href={item.href} class="transition-colors hover:text-accent">{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label="更多链接">
        <div class="mono-label">更多</div>
        <ul class="mt-4 space-y-2.5 text-[13px] text-muted">
          {moreNav.map((item) => (
            <li>
              <a
                href={item.href}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
                class="transition-colors hover:text-accent"
              >
                {item.label}{item.external && <span aria-hidden="true"> ↗</span>}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="mt-12 flex flex-col gap-2 border-t border-rule-soft pt-5 font-mono text-[11px] text-muted-light sm:flex-row sm:items-center sm:justify-between">
      <span>© {new Date().getFullYear()} {PROFILE.name}</span>
      <span><span class="text-accent">$</span> echo "keep building"<span class="cursor-blink" aria-hidden="true"></span></span>
    </div>
  </div>
</footer>
