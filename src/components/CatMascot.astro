---
// 每个实例使用独立渐变 id：开屏与灵宠会同时挂载两个 SVG
const gradientId = `mascot-fur-${Math.random().toString(36).slice(2, 9)}`;
---

<svg class="mascot-svg" viewBox="0 0 240 240" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={gradientId} x1="78" y1="48" x2="166" y2="218" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#f3b978"/>
      <stop offset="1" stop-color="#df8e4e"/>
    </linearGradient>
  </defs>

  <ellipse class="cat-shadow" cx="120" cy="227" rx="44" ry="7" fill="var(--cat-shadow)" opacity=".28"/>

  <g class="cat-ufo">
    <ellipse cx="120" cy="50" rx="30" ry="5" fill="var(--cat-eye)" opacity=".08"/>
    <path d="M84 38C84 30 100 25 120 25C140 25 156 30 156 38C156 47 140 52 120 52C100 52 84 47 84 38Z" fill="var(--ufo-metal)" stroke="var(--cat-line)" stroke-width="2.4"/>
    <path d="M102 33C102 21 112 14 120 14C128 14 138 21 138 33C138 39 130 43 120 43C110 43 102 39 102 33Z" fill="var(--ufo-glass)" opacity=".78" stroke="var(--cat-line)" stroke-width="2.2"/>
    <circle cx="100" cy="41" r="2.4" fill="var(--cat-eye)"/>
    <circle cx="120" cy="44" r="2.4" fill="var(--cat-eye)"/>
    <circle cx="140" cy="41" r="2.4" fill="var(--cat-eye)"/>
    <path d="M92 47C106 53 134 53 148 47" fill="none" stroke="var(--cat-eye)" stroke-width="1.6" stroke-linecap="round" opacity=".5"/>
    <path d="M176 29L178.2 34.4L183.6 36.6L178.2 38.8L176 44.2L173.8 38.8L168.4 36.6L173.8 34.4Z" fill="var(--cat-eye)" opacity=".7"/>
  </g>

  <g class="cat-animal">
    <g class="cat-tail">
      <path d="M164 194C196 194 205 167 190 154C183 148 173 153 177 162C185 177 177 183 160 183" fill="none" stroke="var(--cat-line)" stroke-width="18" stroke-linecap="round"/>
      <path d="M164 194C196 194 205 167 190 154C183 148 173 153 177 162C185 177 177 183 160 183" fill="none" stroke={`url(#${gradientId})`} stroke-width="12" stroke-linecap="round"/>
    </g>

    <g class="cat-body">
      <path d="M72 197C72 164 84 148 104 141L136 141C156 148 168 164 168 197C168 212 158 220 144 220L96 220C82 220 72 212 72 197Z" fill={`url(#${gradientId})`} stroke="var(--cat-line)" stroke-width="3"/>
      <path d="M99 199C99 174 108 161 120 161C132 161 141 174 141 199C141 211 132 217 120 217C108 217 99 211 99 199Z" fill="var(--cat-cream)"/>
      <ellipse cx="91" cy="213" rx="14" ry="7" fill="var(--cat-cream)" stroke="var(--cat-line)" stroke-width="2.4"/>
      <ellipse cx="149" cy="213" rx="14" ry="7" fill="var(--cat-cream)" stroke="var(--cat-line)" stroke-width="2.4"/>
    </g>

    <g class="cat-head">
      <path d="M66 88L58 45L96 64Z" fill={`url(#${gradientId})`} stroke="var(--cat-line)" stroke-width="3" stroke-linejoin="round"/>
      <path d="M174 88L182 45L144 64Z" fill={`url(#${gradientId})`} stroke="var(--cat-line)" stroke-width="3" stroke-linejoin="round"/>
      <path d="M68 56L64 79L86 68Z" fill="var(--cat-pink)" opacity=".75"/>
      <path d="M172 56L176 79L154 68Z" fill="var(--cat-pink)" opacity=".75"/>
      <path d="M60 94C60 67 84 52 120 52C156 52 180 67 180 94C180 126 158 144 120 144C82 144 60 126 60 94Z" fill={`url(#${gradientId})`} stroke="var(--cat-line)" stroke-width="3"/>
      <path d="M76 82C84 66 100 58 114 56" fill="none" stroke="rgba(255,255,255,.28)" stroke-width="4" stroke-linecap="round"/>
      <path d="M112 58L120 70L128 58" fill="none" stroke="var(--cat-fur-dark)" stroke-width="4" stroke-linecap="round" opacity=".55"/>
      <path d="M94 105C104 98 136 98 146 105C151 119 140 134 120 134C100 134 89 119 94 105Z" fill="var(--cat-cream)"/>

      <g class="cat-eye">
        <ellipse cx="96" cy="94" rx="11" ry="13" fill="var(--cat-eye)" stroke="var(--cat-line)" stroke-width="2"/>
        <ellipse cx="98" cy="96" rx="4.2" ry="7.5" fill="var(--cat-pupil)"/>
        <circle cx="92.5" cy="89" r="2.4" fill="#fff" opacity=".9"/>
      </g>
      <g class="cat-eye">
        <ellipse cx="144" cy="94" rx="11" ry="13" fill="var(--cat-eye)" stroke="var(--cat-line)" stroke-width="2"/>
        <ellipse cx="146" cy="96" rx="4.2" ry="7.5" fill="var(--cat-pupil)"/>
        <circle cx="140.5" cy="89" r="2.4" fill="#fff" opacity=".9"/>
      </g>

      <ellipse cx="82" cy="112" rx="7" ry="3" fill="var(--cat-pink)" opacity=".55"/>
      <ellipse cx="158" cy="112" rx="7" ry="3" fill="var(--cat-pink)" opacity=".55"/>
      <path d="M114 113L126 113L120 120Z" fill="var(--cat-nose)"/>
      <path d="M120 120C120 125 114 128 109 126M120 120C120 125 126 128 131 126" fill="none" stroke="var(--cat-line)" stroke-width="2.2" stroke-linecap="round"/>
      <path d="M88 113L64 108M88 121L66 124M152 113L176 108M152 121L174 124" fill="none" stroke="var(--cat-line)" stroke-width="2" stroke-linecap="round" opacity=".5"/>
    </g>
  </g>
</svg>

<style>
  .mascot-svg {
    --cat-line: #2a1a10;
    --cat-fur: #e9a35f;
    --cat-fur-dark: #cf7c3e;
    --cat-cream: #f8e7ca;
    --cat-pink: #f1b6a8;
    --cat-eye: #5eead4;
    --cat-pupil: #0d1b18;
    --cat-nose: #d97b70;
    --ufo-metal: #93a6bb;
    --ufo-glass: #7ee7c7;
    --cat-shadow: rgba(15, 23, 42, .18);
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    filter: drop-shadow(0 8px 12px rgba(15, 23, 42, .12));
  }

  .cat-animal {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: mascot-float 4.4s ease-in-out infinite;
  }

  .cat-tail {
    transform-box: fill-box;
    transform-origin: 15% 80%;
    animation: mascot-tail 3.6s ease-in-out infinite;
  }

  .cat-ufo {
    transform-box: fill-box;
    transform-origin: center;
    animation: mascot-ufo 3.8s ease-in-out infinite;
  }

  .cat-eye {
    transform-box: fill-box;
    transform-origin: center;
    animation: mascot-blink 5.8s infinite;
  }

  @keyframes mascot-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-4px); }
  }
  @keyframes mascot-tail {
    0%, 100% { transform: rotate(0); }
    50% { transform: rotate(5deg); }
  }
  @keyframes mascot-ufo {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
  }
  @keyframes mascot-blink {
    0%, 92%, 100% { transform: scaleY(1); }
    94.5% { transform: scaleY(.08); }
    96% { transform: scaleY(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .cat-animal, .cat-tail, .cat-ufo, .cat-eye { animation: none; }
  }
</style>
