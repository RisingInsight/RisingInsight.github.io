---
/**
 * 灵鸮（Owl）—— 智慧与洞察的化身。
 * 品牌标记：header logo / favicon / 404，静态、克制、每页最多一次。
 *
 * 造型：正面坐姿的圆滚猫头鹰 —— 大圆头 + 梨形身体 + 两只小爪 + 尾部三片短羽。
 * 记忆点：细边框圆眼镜（两片镜片横跨大眼），镜片内是琥珀色虹膜。
 */
interface Props {
  /** 灵宠尺寸小，裁切到头部特写，五官更清晰 */
  crop?: boolean;
  /** 开屏实例：追加「睁眼 + 耳羽抖动 + 翅膀展开」登场动画 */
  intro?: boolean;
  /** 品牌标记模式：关闭全部待机动画，纯静态 */
  static?: boolean;
}

const { crop = false, intro = false, static: isStatic = false } = Astro.props;

// 同一页面会同时挂载多个实例（开屏 / 灵宠），defs id 必须隔离
const uid = Math.random().toString(36).slice(2, 9);
const gid = (name: string) => `${name}-${uid}`;

const bodyFill = gid('body');
const rimStroke = gid('rim');
const discFill = gid('disc');
const chestFill = gid('chest');
const wingFill = gid('wing');
const tailFill = gid('tail');
const irisFill = gid('iris');
const beakFill = gid('beak');
const auraFill = gid('aura');

// crop：头肩特写（240 坐标系下头部 x 68..172 / y 42..138，向下多露到胸口）
const viewBox = crop ? '58 8 124 148' : '0 0 240 240';

const classes = ['mascot-svg', crop ? 'mascot-svg--crop' : '', intro ? 'mascot-svg--intro' : '', isStatic ? 'mascot-svg--static' : '']
  .filter(Boolean)
  .join(' ');

// ===== 几何（全部在 240×240 坐标系内，左右以 x=120 对称）=====
// 头：cx 120 / cy 90 / rx 52 / ry 48
// 身：y 112..221 的梨形，最宽处 57..183
const TORSO_PATH =
  'M120 112C141 112 154 123 159 141C176 157 182 176 180 191C178 206 157 214 120 214C83 214 62 206 60 191C58 176 64 157 81 141C86 123 99 112 120 112Z';

// 面盘：一枚很淡的心形，给五官一个"落位"，不描边
const DISC_PATH =
  'M120 62C108 52 82 56 76 76C70 96 86 116 120 128C154 116 170 96 164 76C158 56 132 52 120 62Z';

// 收在身侧的翅膀：外侧贴着身体轮廓，内侧是一道弧线，形成翼与胸的分界
const WING_L = 'M92 136C76 148 64 170 63 190C62 202 74 206 80 198C88 186 96 156 98 142Z';
const WING_R = 'M148 136C164 148 176 170 177 190C178 202 166 206 160 198C152 186 144 156 142 142Z';

// 尾羽：三片短羽，从身体底部露出（身体下沿 y 214）
const TAILS = [
  'M102 204H110C111 216 109 224 106 230C103 224 101 216 102 204Z',
  'M115 206H125C126 218 124 226 120 232C116 226 114 218 115 206Z',
  'M130 204H138C139 216 137 224 134 230C131 224 129 216 130 204Z',
];

// 胸口羽纹：三行扇形细线，越往下越窄
const PLUMES = [
  'M104 156Q112 165 120 156Q128 165 136 156',
  'M97 174Q104.5 184 112 174Q120 184 128 174Q135.5 184 143 174',
  'M107 192Q113.5 200 120 192Q126.5 200 133 192',
];

// 耳羽：向外后方斜出的小簇，顶端收圆（尖锐三角会读成猫耳）
const TUFT_L = 'M84 56C79 50 72 41 68 33C66.5 30 70 29.5 72.5 31.5C82 37.5 93 41.5 102 44Z';
const TUFT_R = 'M156 56C161 50 168 41 172 33C173.5 30 170 29.5 167.5 31.5C158 37.5 147 41.5 138 44Z';

---

<svg
  class={classes}
  viewBox={viewBox}
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <!-- 身体：深青黑，上浅下深 -->
    <linearGradient id={bodyFill} x1="120" y1="108" x2="120" y2="224" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#1b2f36"/>
      <stop offset=".55" stop-color="#16272e"/>
      <stop offset="1" stop-color="#0d1a20"/>
    </linearGradient>

    <!-- 边缘薄荷色 rim light：上方最亮，往底部淡出 -->
    <linearGradient id={rimStroke} x1="120" y1="36" x2="146" y2="226" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#7ee7c7" stop-opacity=".38"/>
      <stop offset=".5" stop-color="#7ee7c7" stop-opacity=".18"/>
      <stop offset="1" stop-color="#7ee7c7" stop-opacity="0"/>
    </linearGradient>

    <!-- 面盘：中心一点点提亮，四周完全淡出 -->
    <radialGradient id={discFill} cx=".5" cy=".42" r=".62">
      <stop offset="0" stop-color="#dff7ef" stop-opacity=".1"/>
      <stop offset=".62" stop-color="#dff7ef" stop-opacity=".04"/>
      <stop offset="1" stop-color="#dff7ef" stop-opacity="0"/>
    </radialGradient>

    <!-- 胸腹浅色：中心实、四周淡出 -->
    <radialGradient id={chestFill} cx=".5" cy=".42" r=".66">
      <stop offset="0" stop-color="#e8fbf4" stop-opacity=".17"/>
      <stop offset=".55" stop-color="#e8fbf4" stop-opacity=".08"/>
      <stop offset="1" stop-color="#e8fbf4" stop-opacity="0"/>
    </radialGradient>

    <!-- 翅膀：比身体略亮一档，靠明度差分层，不靠描边 -->
    <linearGradient id={wingFill} x1="120" y1="136" x2="120" y2="204" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#7ee7c7" stop-opacity=".09"/>
      <stop offset="1" stop-color="#7ee7c7" stop-opacity=".02"/>
    </linearGradient>

    <!-- 尾羽：根深，末端微微透青 -->
    <linearGradient id={tailFill} x1="120" y1="200" x2="120" y2="238" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#16262d"/>
      <stop offset="1" stop-color="#1d3a42"/>
    </linearGradient>

    <!-- 琥珀虹膜 -->
    <radialGradient id={irisFill} cx=".36" cy=".28" r=".86">
      <stop offset="0" stop-color="#fff6e0"/>
      <stop offset=".32" stop-color="#dcae74"/>
      <stop offset=".68" stop-color="#b9823c"/>
      <stop offset="1" stop-color="#a85f21"/>
    </radialGradient>

    <!-- 喙：暖橙，上亮下暗 -->
    <linearGradient id={beakFill} x1="120" y1="103" x2="120" y2="121" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#eab077"/>
      <stop offset=".55" stop-color="#d68f4d"/>
      <stop offset="1" stop-color="#b96f34"/>
    </linearGradient>

    <!-- 身后柔光 -->
    <radialGradient id={auraFill} cx=".5" cy=".5" r=".5">
      <stop offset="0" stop-color="#7ee7c7" stop-opacity=".2"/>
      <stop offset=".55" stop-color="#7ee7c7" stop-opacity=".08"/>
      <stop offset="1" stop-color="#7ee7c7" stop-opacity="0"/>
    </radialGradient>
  </defs>

  <!-- 身后柔光（crop 模式隐藏） -->
  <g class="owl-glow">
    <ellipse cx="120" cy="132" rx="90" ry="94" fill={`url(#${auraFill})`}/>
  </g>

  <!-- 落地投影：不跟随浮动，保持"坐着"的稳定感 -->
  <ellipse class="owl-shadow" cx="120" cy="237" rx="40" ry="4" fill="#04120f" opacity=".13"/>

  <g class="owl-float">
    <!-- 尾羽（在身体之后，只露末端） -->
    <g class="owl-tail">
      {TAILS.map((d) => (
        <path d={d} fill={`url(#${tailFill})`} stroke="#7ee7c7" stroke-opacity=".16" stroke-width="1"/>
      ))}
    </g>

    <!-- 身体 -->
    <g class="owl-body">
      <path d={TORSO_PATH} fill={`url(#${bodyFill})`} stroke={`url(#${rimStroke})`} stroke-width="1.5"/>

      <!-- 胸腹的浅色区域（很淡，只做体积感） -->
      <ellipse cx="120" cy="168" rx="36" ry="42" fill={`url(#${chestFill})`}/>

      <!-- 胸口羽纹：细线扇形，带一点点呼吸微光 -->
      <g class="owl-plume" stroke="#bff3e3" stroke-width="1.1" stroke-linecap="round" fill="none" opacity=".24">
        {PLUMES.map((d) => <path d={d}/>)}
      </g>

      <!-- 小爪：两只圆钝的脚，趾缝只留两道极短细线 -->
      <g class="owl-feet">
        <g>
          <ellipse cx="106" cy="209" rx="9.2" ry="6" fill="#d99a5e" fill-opacity=".28"/>
          <g stroke="#d99a5e" stroke-opacity=".3" stroke-width="2.4" stroke-linecap="round">
            <path d="M102.5 212V214"/>
            <path d="M109.5 212V214"/>
          </g>
        </g>
        <g>
          <ellipse cx="134" cy="209" rx="9.2" ry="6" fill="#d99a5e" fill-opacity=".28"/>
          <g stroke="#d99a5e" stroke-opacity=".3" stroke-width="2.4" stroke-linecap="round">
            <path d="M130.5 212V214"/>
            <path d="M137.5 212V214"/>
          </g>
        </g>
      </g>
    </g>

    <!-- 翅膀（收在身侧，边缘一道薄荷轮廓光） -->
    <g class="owl-wing owl-wing--l">
      <path d={WING_L} fill={`url(#${wingFill})`} stroke="#7ee7c7" stroke-opacity=".15" stroke-width="1.2"/>
    </g>
    <g class="owl-wing owl-wing--r">
      <path d={WING_R} fill={`url(#${wingFill})`} stroke="#7ee7c7" stroke-opacity=".15" stroke-width="1.2"/>
    </g>

    <!-- 头落在身体上的投影，避免"球叠梨" -->
    <ellipse cx="120" cy="134" rx="46" ry="11" fill="#08161c" opacity=".45"/>

    <!-- 头 -->
    <g class="owl-head-look">
      <g class="owl-head">
        <!-- 耳羽（先画，被头盖住根部） -->
        <g class="owl-tuft owl-tuft--l">
          <path d={TUFT_L} fill={`url(#${bodyFill})`}/>
          <path d={TUFT_L} stroke="#7ee7c7" stroke-opacity=".2" stroke-width="1.2" stroke-linejoin="round"/>
        </g>
        <g class="owl-tuft owl-tuft--r">
          <path d={TUFT_R} fill={`url(#${bodyFill})`}/>
          <path d={TUFT_R} stroke="#7ee7c7" stroke-opacity=".2" stroke-width="1.2" stroke-linejoin="round"/>
        </g>

        <!-- 头 -->
        <ellipse cx="120" cy="90" rx="52" ry="48" fill={`url(#${bodyFill})`} stroke={`url(#${rimStroke})`} stroke-width="1.5"/>

        <!-- 面盘：不描边，只用一点点提亮勾出心形 -->
        <path d={DISC_PATH} fill={`url(#${discFill})`}/>

        <!-- 眼睛：虹膜 30px 直径，68px 按钮里依然清晰 -->
        <g class="owl-gaze">
          <g class="owl-eye owl-eye--l">
            <ellipse cx="99" cy="90" rx="15" ry="15" fill={`url(#${irisFill})`}/>
            <ellipse cx="99" cy="90" rx="15" ry="15" stroke="#7a4a1c" stroke-opacity=".2" stroke-width="1"/>
            <ellipse cx="99" cy="90.5" rx="6.6" ry="7.6" fill="#14100a"/>
            <circle cx="94.4" cy="84" r="2.7" fill="#ffffff"/>
            <circle cx="103" cy="95" r="1.3" fill="#ffffff" opacity=".55"/>
          </g>
          <g class="owl-eye owl-eye--r">
            <ellipse cx="141" cy="90" rx="15" ry="15" fill={`url(#${irisFill})`}/>
            <ellipse cx="141" cy="90" rx="15" ry="15" stroke="#7a4a1c" stroke-opacity=".2" stroke-width="1"/>
            <ellipse cx="141" cy="90.5" rx="6.6" ry="7.6" fill="#14100a"/>
            <circle cx="136.4" cy="84" r="2.7" fill="#ffffff"/>
            <circle cx="145" cy="95" r="1.3" fill="#ffffff" opacity=".55"/>
          </g>
        </g>

        <!-- 圆眼镜：细边框横跨两眼，记忆点 -->
        <g class="owl-glasses" fill="none" stroke="#a9f4dd" stroke-linecap="round">
          <g stroke-opacity=".55" stroke-width="1.7">
            <circle cx="99" cy="90" r="19.6"/>
            <circle cx="141" cy="90" r="19.6"/>
            <path d="M118.6 89.4Q120 86.6 121.4 89.4"/>
            <path d="M79.6 88.4Q73.5 84.6 69 81.4"/>
            <path d="M160.4 88.4Q166.5 84.6 171 81.4"/>
          </g>
          <!-- 镜片反光：一道很短的斜高光 -->
          <g stroke-opacity=".3" stroke-width="1.5">
            <path d="M86.2 78.6L91.2 73.6"/>
            <path d="M128.2 78.6L133.2 73.6"/>
          </g>
        </g>

        <!-- 喙：小巧的暖橙倒三角 -->
        <g class="owl-beak">
          <path d="M113.5 108Q120 105 126.5 108Q124 113.5 120 119Q116 113.5 113.5 108Z" fill={`url(#${beakFill})`}/>
          <path d="M120 109.5V116" stroke="#fff2e0" stroke-opacity=".2" stroke-width="1" stroke-linecap="round"/>
        </g>
      </g>
    </g>
  </g>
</svg>

<style>
  .mascot-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* 裁切模式：只留头肩，外围元素直接不画 */
  .mascot-svg--crop {
    overflow: hidden;
  }
  .mascot-svg--crop .owl-glow,
  .mascot-svg--crop .owl-shadow {
    display: none;
  }

  /* ===== 待机微动：各分组错峰，周期刻意不成倍数，避免同步感 ===== */
  .owl-glow {
    transform-box: fill-box;
    transform-origin: center;
    animation: owl-glow-pulse 8.4s ease-in-out infinite;
  }

  .owl-float {
    transform-box: fill-box;
    transform-origin: 50% 96%;
    animation: owl-float 7.2s ease-in-out infinite;
  }

  .owl-body {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: owl-breathe 6.4s ease-in-out infinite;
  }

  .owl-head {
    transform-box: fill-box;
    transform-origin: 50% 92%;
    animation: owl-head-turn 12.6s ease-in-out infinite;
  }

  /* 外部（灵宠）通过 CSS 变量驱动"看向指针 / 跟随滚动"，不打断上面的动画 */
  .owl-head-look {
    transform-box: fill-box;
    transform-origin: 50% 92%;
    transform: translate(var(--owl-look-x, 0px), var(--owl-look-y, 0px)) rotate(var(--owl-tilt, 0deg));
    transition: transform .45s cubic-bezier(.2, .7, .3, 1);
  }

  .owl-gaze {
    transform: translate(var(--owl-gaze-x, 0px), var(--owl-gaze-y, 0px));
    transition: transform .35s cubic-bezier(.2, .7, .3, 1);
  }

  .owl-tuft {
    transform-box: fill-box;
  }
  .owl-tuft--l {
    transform-origin: 78% 100%;
    animation: owl-tuft-l 9.2s ease-in-out infinite;
  }
  .owl-tuft--r {
    transform-origin: 22% 100%;
    animation: owl-tuft-r 10.6s ease-in-out infinite;
  }

  .owl-eye {
    transform-box: fill-box;
    transform-origin: center;
  }
  .owl-eye--l { animation: owl-blink 7.4s infinite; }
  .owl-eye--r { animation: owl-blink 8.8s infinite .35s; }

  .owl-tail {
    transform-box: fill-box;
    transform-origin: 50% 0%;
    animation: owl-tail-sway 5.8s ease-in-out infinite;
  }

  .owl-wing {
    transform-box: fill-box;
  }
  .owl-wing--l {
    transform-origin: 88% 8%;
    animation: owl-ruffle-l 11.4s ease-in-out infinite;
  }
  .owl-wing--r {
    transform-origin: 12% 8%;
    animation: owl-ruffle-r 13.2s ease-in-out infinite;
  }

  .owl-plume {
    animation: owl-plume-glow 5.2s ease-in-out infinite;
  }

  /* ===== 开屏实例：睁眼 + 耳羽抖动 + 翅膀展开 =====
     延时由父组件用 --owl-eye-in / --owl-tuft-in / --owl-wing-in 注入 */
  .mascot-svg--intro .owl-eye--l,
  .mascot-svg--intro .owl-eye--r {
    animation:
      owl-eye-open .9s cubic-bezier(.16, 1, .3, 1) var(--owl-eye-in, .4s) both,
      owl-blink 6.8s calc(var(--owl-eye-in, .4s) + 1.4s) infinite;
  }

  .mascot-svg--intro .owl-tuft--l {
    animation: owl-tuft-jiggle .9s cubic-bezier(.2, .7, .3, 1) var(--owl-tuft-in, .55s) both;
  }
  .mascot-svg--intro .owl-tuft--r {
    animation: owl-tuft-jiggle .9s cubic-bezier(.2, .7, .3, 1) calc(var(--owl-tuft-in, .55s) + .13s) both;
  }

  .mascot-svg--intro .owl-wing--l {
    animation: owl-wing-spread-l 1.4s cubic-bezier(.2, .7, .3, 1) var(--owl-wing-in, .3s) both;
  }
  .mascot-svg--intro .owl-wing--r {
    animation: owl-wing-spread-r 1.4s cubic-bezier(.2, .7, .3, 1) var(--owl-wing-in, .3s) both;
  }

  /* ===== 关键帧 ===== */
  @keyframes owl-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-2.5px); }
  }
  @keyframes owl-breathe {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.014, 1.011); }
  }
  @keyframes owl-head-turn {
    0%, 58%, 100% { transform: rotate(0deg); }
    68% { transform: rotate(-2.2deg); }
    78% { transform: rotate(1.6deg); }
    88% { transform: rotate(0deg); }
  }
  @keyframes owl-tuft-l {
    0%, 76%, 100% { transform: rotate(0deg); }
    82% { transform: rotate(-6deg); }
    89% { transform: rotate(2deg); }
  }
  @keyframes owl-tuft-r {
    0%, 70%, 100% { transform: rotate(0deg); }
    77% { transform: rotate(5deg); }
    84% { transform: rotate(-1.6deg); }
  }
  @keyframes owl-blink {
    0%, 91%, 100% { transform: scaleY(1); }
    93% { transform: scaleY(.06); }
    95.5% { transform: scaleY(1); }
  }
  @keyframes owl-tail-sway {
    0%, 100% { transform: rotate(-2deg); }
    50% { transform: rotate(2.6deg); }
  }
  @keyframes owl-ruffle-l {
    0%, 82%, 100% { transform: rotate(0deg) scaleX(1); }
    88% { transform: rotate(2.4deg) scaleX(1.03); }
    94% { transform: rotate(0deg) scaleX(1); }
  }
  @keyframes owl-ruffle-r {
    0%, 78%, 100% { transform: rotate(0deg) scaleX(1); }
    85% { transform: rotate(-2.4deg) scaleX(1.03); }
    92% { transform: rotate(0deg) scaleX(1); }
  }
  @keyframes owl-glow-pulse {
    0%, 100% { opacity: .55; transform: scale(1); }
    50% { opacity: .92; transform: scale(1.05); }
  }
  @keyframes owl-plume-glow {
    0%, 100% { opacity: .2; }
    50% { opacity: .38; }
  }
  @keyframes owl-eye-open {
    0% { transform: scaleY(.04); }
    60% { transform: scaleY(1.1); }
    100% { transform: scaleY(1); }
  }
  @keyframes owl-tuft-jiggle {
    0% { transform: rotate(0deg); }
    28% { transform: rotate(-7deg); }
    52% { transform: rotate(3.5deg); }
    76% { transform: rotate(-1.6deg); }
    100% { transform: rotate(0deg); }
  }
  @keyframes owl-wing-spread-l {
    0% { transform: rotate(0deg) scaleX(1); }
    42% { transform: rotate(7deg) scaleX(1.1); }
    100% { transform: rotate(0deg) scaleX(1); }
  }
  @keyframes owl-wing-spread-r {
    0% { transform: rotate(0deg) scaleX(1); }
    42% { transform: rotate(-7deg) scaleX(1.1); }
    100% { transform: rotate(0deg) scaleX(1); }
  }

  /* 品牌标记模式：全静态 */
  .mascot-svg--static .owl-glow,
  .mascot-svg--static .owl-float,
  .mascot-svg--static .owl-body,
  .mascot-svg--static .owl-head,
  .mascot-svg--static .owl-tuft--l,
  .mascot-svg--static .owl-tuft--r,
  .mascot-svg--static .owl-eye--l,
  .mascot-svg--static .owl-eye--r,
  .mascot-svg--static .owl-tail,
  .mascot-svg--static .owl-wing--l,
  .mascot-svg--static .owl-wing--r,
  .mascot-svg--static .owl-plume {
    animation: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .owl-glow,
    .owl-float,
    .owl-body,
    .owl-head,
    .owl-tuft--l,
    .owl-tuft--r,
    .owl-eye--l,
    .owl-eye--r,
    .owl-tail,
    .owl-wing--l,
    .owl-wing--r,
    .owl-plume,
    .mascot-svg--intro .owl-eye--l,
    .mascot-svg--intro .owl-eye--r,
    .mascot-svg--intro .owl-tuft--l,
    .mascot-svg--intro .owl-tuft--r,
    .mascot-svg--intro .owl-wing--l,
    .mascot-svg--intro .owl-wing--r {
      animation: none;
    }
    .owl-head-look,
    .owl-gaze {
      transition: none;
    }
  }
</style>
