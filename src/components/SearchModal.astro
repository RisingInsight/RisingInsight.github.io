---
// Pagefind 全文搜索 — 索引在构建时自动生成
// 首次加载尝试使用 Pagefind，失败时降级为标题/标签搜索
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const searchData = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map(post => ({
    id: post.id,
    title: post.data.title,
    description: post.data.description,
    tags: post.data.tags || [],
    categories: post.data.categories || [],
    date: post.data.pubDate,
  }));
---

<!-- 搜索弹窗 -->
<div id="search-modal" class="search-modal" role="dialog" aria-modal="true" aria-label="搜索文章" inert>
  <div class="search-backdrop"></div>
  <div class="search-panel">
    <div class="search-input-wrap">
      <svg class="search-input-icon" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input id="search-input" type="text" placeholder="grep notes / tags..." autocomplete="off" class="search-input" aria-label="搜索文章" />
      <kbd class="search-kbd">ESC</kbd>
      <button id="search-close" class="search-close" type="button" aria-label="关闭搜索">×</button>
    </div>

    <div id="search-results" class="search-results" aria-live="polite">
      <div class="search-empty-state">
        <p class="search-empty-title">输入关键词开始搜索</p>
        <p class="search-empty-hint">full-text index · Pagefind</p>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ searchData }}>
  const modal = document.getElementById('search-modal');
  const input = document.getElementById('search-input');
  const results = document.getElementById('search-results');
  const backdrop = modal?.querySelector('.search-backdrop');
  const closeBtn = document.getElementById('search-close');
  const triggers = document.querySelectorAll('[data-search-trigger]');

  let pagefindLoaded = false;
  let pagefind = null;
  let lastTrigger = null;
  let searchSeq = 0;

  function emptyState(message) {
    return `<div class="search-empty-state"><p class="search-empty-title">${message}</p><p class="search-empty-hint">full-text index · Pagefind</p></div>`;
  }

  function openSearch(event) {
    if (event?.currentTarget) lastTrigger = event.currentTarget;
    const mobileMenu = document.getElementById('mobile-menu');
    if (mobileMenu && !mobileMenu.classList.contains('hidden')) {
      document.getElementById('mobile-menu-btn')?.click();
    }
    modal?.removeAttribute('inert');
    modal?.classList.add('active');
    document.body.style.overflow = 'hidden';
    setTimeout(() => input?.focus(), 100);
  }

  function closeSearch() {
    searchSeq += 1;
    modal?.classList.remove('active');
    modal?.setAttribute('inert', '');
    document.body.style.overflow = '';
    if (input) input.value = '';
    if (results) results.innerHTML = emptyState('输入关键词开始搜索');
    if (lastTrigger) {
      lastTrigger.focus();
      lastTrigger = null;
    }
  }

  triggers.forEach((trigger) => trigger.addEventListener('click', openSearch));
  closeBtn?.addEventListener('click', closeSearch);
  backdrop?.addEventListener('click', closeSearch);

  modal?.addEventListener('keydown', (event) => {
    if (event.key !== 'Tab') return;
    const focusable = Array.from(modal.querySelectorAll('input, button, a[href]'));
    if (focusable.length === 0) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeSearch();
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
      e.preventDefault();
      openSearch();
    }
  });

  async function loadPagefind() {
    if (pagefindLoaded) return pagefind;
    try {
      pagefind = await import('/pagefind/pagefind.js');
      await pagefind.init();
      pagefindLoaded = true;
      return pagefind;
    } catch {
      return null;
    }
  }

  function stripHtml(value) {
    return String(value || '').replace(/<[^>]+>/g, ' ');
  }

  // Pagefind 默认是前缀/模糊匹配，这里再要求查询词真实出现在结果文本中
  function queryMatches(query, post, excerpt) {
    const terms = query.toLowerCase().split(/\s+/).filter(Boolean);
    if (terms.length === 0) return false;
    const haystack = [
      post?.title,
      post?.description,
      ...(post?.tags || []),
      ...(post?.categories || []),
      stripHtml(excerpt),
    ].filter(Boolean).join(' ').toLowerCase();
    return terms.some((term) => haystack.includes(term));
  }

  let searchTimeout;
  input?.addEventListener('input', () => {
    const q = input.value.trim();
    const seq = ++searchSeq;
    clearTimeout(searchTimeout);

    if (!q) {
      results.innerHTML = emptyState('输入关键词开始搜索');
      return;
    }

    searchTimeout = window.setTimeout(async () => {
      const pf = await loadPagefind();
      if (seq !== searchSeq) return;

      if (pf) {
        try {
          const search = await pf.search(q);
          if (seq !== searchSeq) return;
          const items = await Promise.all(search.results.slice(0, 8).map((r) => r.data()));
          if (seq !== searchSeq) return;

          const matchedItems = items.filter((item) => {
            const slug = item.url.replace('/blog/', '').replace(/\/$/, '');
            const post = searchData.find(p => p.id === slug);
            return queryMatches(q, post, item.excerpt);
          });

          if (matchedItems.length === 0) {
            results.innerHTML = emptyState('没有找到相关文章');
            return;
          }

          results.innerHTML = matchedItems.map((item) => {
            const slug = item.url.replace('/blog/', '').replace(/\/$/, '');
            const post = searchData.find(p => p.id === slug);
            const title = post ? post.title : item.meta?.title || slug;
            const desc = item.excerpt || (post ? post.description : '');
            const tags = post ? post.tags : [];
            const date = post ? post.date : null;
            return `
              <a href="${item.url}" class="search-result-item">
                <div class="search-result-title">${highlight(title, q)}</div>
                ${desc ? `<div class="search-result-desc">${desc}</div>` : ''}
                <div class="search-result-meta">
                  ${date ? `<span>${new Date(date).toLocaleDateString('zh-CN', { month: 'short', day: 'numeric' })}</span>` : ''}
                  ${tags.slice(0, 2).map(t => `<span class="search-result-tag">${t}</span>`).join('')}
                </div>
              </a>
            `;
          }).join('');
        } catch {
          if (seq === searchSeq) fallbackSearch(q, seq);
        }
      } else {
        fallbackSearch(q, seq);
      }
    }, 200);
  });

  function fallbackSearch(q, seq = searchSeq) {
    if (seq !== searchSeq) return;
    const lower = q.toLowerCase();
    const matched = searchData.filter(p =>
      p.title.toLowerCase().includes(lower) ||
      p.description.toLowerCase().includes(lower) ||
      p.tags.some(t => t.toLowerCase().includes(lower)) ||
      p.categories.some(c => c.toLowerCase().includes(lower))
    );
    if (matched.length === 0) {
      results.innerHTML = emptyState('没有找到相关文章');
      return;
    }
    results.innerHTML = matched.map(p => `
      <a href="/blog/${p.id}/" class="search-result-item">
        <div class="search-result-title">${highlight(p.title, q)}</div>
        <div class="search-result-desc">${p.description}</div>
        <div class="search-result-meta">
          <span>${new Date(p.date).toLocaleDateString('zh-CN', { month: 'short', day: 'numeric' })}</span>
          ${p.tags.slice(0, 2).map(t => `<span class="search-result-tag">${t}</span>`).join('')}
        </div>
      </a>
    `).join('');
  }

  function escapeHtml(value) {
    return value.replace(/[&<>"']/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch]);
  }

  function highlight(text, q) {
    if (!q) return escapeHtml(text);
    const regex = new RegExp(`(${q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
    return escapeHtml(text).replace(regex, '<mark class="search-highlight">$1</mark>');
  }
</script>

<style>
  .search-modal {
    position: fixed;
    inset: 0;
    z-index: 300;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 10vh;
    opacity: 0;
    pointer-events: none;
    transition: opacity .2s ease;
  }
  .search-modal.active {
    opacity: 1;
    pointer-events: auto;
  }
  .search-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(3, 6, 8, .62);
    backdrop-filter: blur(6px);
  }
  .search-panel {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 90%;
    max-width: 560px;
    max-height: 70vh;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--surface);
    box-shadow: var(--shadow), 0 0 0 1px rgba(var(--accent-rgb), .04);
    transform: scale(.98) translateY(-6px);
    transition: transform .2s cubic-bezier(.16, 1, .3, 1);
  }
  .search-modal.active .search-panel {
    transform: scale(1) translateY(0);
  }
  .search-input-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 15px 18px;
    border-bottom: 1px solid var(--rule);
  }
  .search-input-icon {
    flex-shrink: 0;
    width: 19px;
    height: 19px;
    color: var(--muted-light);
  }
  .search-input {
    flex: 1;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: .95rem;
  }
  .search-input::placeholder {
    color: var(--muted-light);
  }
  .search-kbd {
    padding: 2px 7px;
    border: 1px solid var(--rule);
    border-radius: 3px;
    background: var(--surface-alt);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: .7rem;
  }
  .search-close {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--surface-alt);
    color: var(--muted);
    font-size: 17px;
    line-height: 1;
    cursor: pointer;
    transition: background .15s, color .15s;
  }
  .search-close:hover {
    background: var(--paper-alt);
    color: var(--ink);
  }
  .search-results {
    flex: 1;
    overflow-y: auto;
    padding: 6px;
  }
  :global(.search-empty-state) {
    padding: 38px 20px;
    text-align: center;
  }
  :global(.search-empty-title) {
    font-family: var(--font-serif);
    font-size: 1.02rem;
    color: var(--ink);
  }
  :global(.search-empty-hint) {
    margin-top: 5px;
    color: var(--muted-light);
    font-family: var(--font-mono);
    font-size: .7rem;
    letter-spacing: .06em;
  }
  :global(.search-result-item) {
    display: block;
    padding: 11px 13px;
    border-radius: 4px;
    text-decoration: none;
    transition: background .15s;
  }
  :global(.search-result-item + .search-result-item) {
    border-top: 1px solid var(--rule);
    border-radius: 0;
  }
  :global(.search-result-item:hover) {
    background: var(--accent-soft);
  }
  :global(.search-result-title) {
    margin-bottom: 3px;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 600;
  }
  :global(.search-result-desc) {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    margin-bottom: 5px;
    color: var(--muted);
    font-size: .82rem;
    line-height: 1.6;
  }
  :global(.search-result-meta) {
    display: flex;
    align-items: center;
    gap: 7px;
    color: var(--muted-light);
    font-family: var(--font-mono);
    font-size: .7rem;
  }
  :global(.search-result-tag) {
    padding: 1px 5px;
    border: 1px solid var(--rule);
    border-radius: 3px;
    color: var(--muted);
    font-size: .7rem;
  }
  :global(.search-highlight) {
    padding: 0 1px;
    border-radius: 2px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  @media (max-width: 640px) {
    .search-kbd { display: none; }
  }
</style>
