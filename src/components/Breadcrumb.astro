---
interface Props {
  items: Array<{ label: string; href?: string }>;
}

const { items } = Astro.props;
---

<nav class="mb-6 animate-fade-up" aria-label="Breadcrumb">
  <ol class="flex items-center gap-1.5 text-sm">
    {items.map((item, i) => (
      <li class="flex items-center gap-1.5">
        {i > 0 && (
          <svg class="w-3.5 h-3.5 text-slate-300 dark:text-slate-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        )}
        {item.href ? (
          <a href={item.href} class="text-slate-400 dark:text-slate-500 hover:text-primary dark:hover:text-primary-light transition-colors">
            {item.label}
          </a>
        ) : (
          <span class="text-slate-600 dark:text-slate-300 font-medium">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
