<div class="diffusion-demo" data-diffusion-demo>
  <div class="demo-header">
    <div>
      <div class="demo-kicker">TOY DIFFUSION / 2D</div>
      <h3 class="demo-title">从噪声回到三个簇</h3>
    </div>
    <div class="demo-status" data-status aria-live="polite">就绪</div>
  </div>

  <canvas
    class="demo-canvas"
    data-canvas
    width="720"
    height="360"
    role="img"
    aria-label="二维高斯混合分布的扩散加噪与逆向去噪可视化"
  >
    你的浏览器不支持 canvas。
  </canvas>

  <div class="demo-controls">
    <button type="button" class="demo-btn demo-btn-primary" data-play>运行逆向去噪</button>
    <button type="button" class="demo-btn" data-reset>重置</button>
    <label class="demo-range">
      <span>前向时间步</span>
      <input type="range" data-timestep min="0" max="200" value="0" step="1" />
      <span class="demo-t" data-t-label>T = 0</span>
    </label>
  </div>

  <p class="demo-note">
    前向过程：<span class="demo-mono">x_t = √ᾱ_t x₀ + √(1−ᾱ_t) ε</span>。
    逆向动画使用这个三维高斯混合分布的解析 score，从纯噪声逐步采样；它是教学用的玩具模型，不是训练好的图像生成器。
  </p>
</div>

<script>
  interface PointFrame {
    x: Float32Array;
    y: Float32Array;
  }

  function mulberry32(seed: number) {
    return function random() {
      seed |= 0;
      seed = (seed + 0x6d2b79f5) | 0;
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  function gaussian(random: () => number) {
    let u = 0;
    let v = 0;
    while (u === 0) u = random();
    while (v === 0) v = random();
    return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v);
  }

  function initDemo(root: HTMLElement) {
    const canvas = root.querySelector<HTMLCanvasElement>('[data-canvas]');
    const playBtn = root.querySelector<HTMLButtonElement>('[data-play]');
    const resetBtn = root.querySelector<HTMLButtonElement>('[data-reset]');
    const slider = root.querySelector<HTMLInputElement>('[data-timestep]');
    const label = root.querySelector<HTMLElement>('[data-t-label]');
    const status = root.querySelector<HTMLElement>('[data-status]');
    if (!canvas || !playBtn || !resetBtn || !slider || !label || !status) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const STEPS = 200;
    const PARTICLES = 420;
    const DATA_STD = 0.22;
    const MODES = [
      { x: -1.3, y: -0.6, color: '#5b7ca6' },
      { x: 1.3, y: -0.6, color: '#a87455' },
      { x: 0, y: 1.25, color: '#6f8f6a' },
    ];
    const WEIGHTS = [1 / 3, 1 / 3, 1 / 3];
    const betas: number[] = [];
    const alphas: number[] = [];
    const alphaBars: number[] = [];
    for (let i = 0; i < STEPS; i++) {
      const beta = 1e-4 + (0.04 - 1e-4) * (i / (STEPS - 1));
      betas.push(beta);
      alphas.push(1 - beta);
    }
    let running = 1;
    for (let i = 0; i < STEPS; i++) {
      running *= alphas[i];
      alphaBars.push(running);
    }
    const alphaBarAt = (t: number) => (t <= 0 ? 1 : alphaBars[t - 1]);

    const width = 720;
    const height = 360;
    const pad = 34;
    const scaleX = (width - pad * 2) / 5;
    const scaleY = (height - pad * 2) / 5;
    const screenX = (x: number) => pad + (x + 2.5) * scaleX;
    const screenY = (y: number) => height - pad - (y + 2.5) * scaleY;

    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = width * dpr;
    canvas.height = height * dpr;
    ctx.scale(dpr, dpr);

    const random = mulberry32(20261021);
    const x0 = new Float32Array(PARTICLES);
    const y0 = new Float32Array(PARTICLES);
    const dataLabels = new Uint8Array(PARTICLES);
    for (let i = 0; i < PARTICLES; i++) {
      const modeIndex = Math.floor(random() * MODES.length);
      const mode = MODES[modeIndex];
      x0[i] = mode.x + gaussian(random) * DATA_STD;
      y0[i] = mode.y + gaussian(random) * DATA_STD;
      dataLabels[i] = modeIndex;
    }

    const forwardFrames: PointFrame[] = [{ x: x0.slice(), y: y0.slice() }];
    const noiseRandom = mulberry32(9901);
    for (let t = 1; t <= STEPS; t++) {
      const alphaBar = alphaBarAt(t);
      const signal = Math.sqrt(alphaBar);
      const noise = Math.sqrt(1 - alphaBar);
      const fx = new Float32Array(PARTICLES);
      const fy = new Float32Array(PARTICLES);
      for (let i = 0; i < PARTICLES; i++) {
        fx[i] = x0[i] * signal + gaussian(noiseRandom) * noise;
        fy[i] = y0[i] * signal + gaussian(noiseRandom) * noise;
      }
      forwardFrames.push({ x: fx, y: fy });
    }

    let reverseFrames: PointFrame[] | null = null;
    let reverseLabels: Uint8Array | null = null;

    function scoreAt(x: number, y: number, t: number) {
      const alphaBar = alphaBarAt(t);
      const variance = 1 - alphaBar + alphaBar * DATA_STD * DATA_STD;
      const signal = Math.sqrt(alphaBar);
      const logits: number[] = [];
      let maxLogit = -Infinity;
      for (let k = 0; k < MODES.length; k++) {
        const dx = x - signal * MODES[k].x;
        const dy = y - signal * MODES[k].y;
        const logit = Math.log(WEIGHTS[k]) - (dx * dx + dy * dy) / (2 * variance);
        logits.push(logit);
        maxLogit = Math.max(maxLogit, logit);
      }
      let total = 0;
      const responsibilities = [0, 0, 0];
      for (let k = 0; k < MODES.length; k++) {
        responsibilities[k] = Math.exp(logits[k] - maxLogit);
        total += responsibilities[k];
      }
      let sx = 0;
      let sy = 0;
      for (let k = 0; k < MODES.length; k++) {
        responsibilities[k] /= total;
        sx += (responsibilities[k] * (signal * MODES[k].x - x)) / variance;
        sy += (responsibilities[k] * (signal * MODES[k].y - y)) / variance;
      }
      return [sx, sy] as const;
    }

    function buildReverse() {
      const reverseRandom = mulberry32(424242);
      let px = new Float32Array(PARTICLES);
      let py = new Float32Array(PARTICLES);
      for (let i = 0; i < PARTICLES; i++) {
        px[i] = gaussian(reverseRandom);
        py[i] = gaussian(reverseRandom);
      }
      const frames: PointFrame[] = [{ x: px.slice(), y: py.slice() }];
      for (let t = STEPS; t >= 1; t--) {
        const beta = betas[t - 1];
        const alpha = alphas[t - 1];
        const nx = new Float32Array(PARTICLES);
        const ny = new Float32Array(PARTICLES);
        for (let i = 0; i < PARTICLES; i++) {
          const [sx, sy] = scoreAt(px[i], py[i], t);
          nx[i] = (px[i] + beta * sx) / Math.sqrt(alpha) + Math.sqrt(beta) * gaussian(reverseRandom);
          ny[i] = (py[i] + beta * sy) / Math.sqrt(alpha) + Math.sqrt(beta) * gaussian(reverseRandom);
        }
        px = nx;
        py = ny;
        frames.push({ x: px.slice(), y: py.slice() });
      }
      const labels = new Uint8Array(PARTICLES);
      for (let i = 0; i < PARTICLES; i++) {
        let best = 0;
        let bestDistance = Infinity;
        for (let k = 0; k < MODES.length; k++) {
          const distance = (px[i] - MODES[k].x) ** 2 + (py[i] - MODES[k].y) ** 2;
          if (distance < bestDistance) {
            bestDistance = distance;
            best = k;
          }
        }
        labels[i] = best;
      }
      reverseFrames = frames;
      reverseLabels = labels;
    }

    function drawFrame(frame: PointFrame, labels: Uint8Array, kind: string) {
      ctx.clearRect(0, 0, width, height);
      ctx.save();
      ctx.setLineDash([3, 5]);
      ctx.lineWidth = 1;
      ctx.strokeStyle = 'rgba(130, 125, 115, .32)';
      for (const mode of MODES) {
        ctx.beginPath();
        ctx.ellipse(screenX(mode.x), screenY(mode.y), 0.34 * scaleX, 0.34 * scaleY, 0, 0, Math.PI * 2);
        ctx.stroke();
      }
      ctx.restore();

      for (let i = 0; i < PARTICLES; i++) {
        ctx.beginPath();
        ctx.arc(screenX(frame.x[i]), screenY(frame.y[i]), 2.1, 0, Math.PI * 2);
        ctx.fillStyle = MODES[labels[i]].color;
        ctx.globalAlpha = 0.68;
        ctx.fill();
      }
      ctx.globalAlpha = 1;
      ctx.fillStyle = 'rgba(111, 106, 97, .75)';
      ctx.font = '10px ui-monospace, SFMono-Regular, Consolas, monospace';
      ctx.fillText(kind, 16, 20);
    }

    let playing = false;
    let reverseTimer = 0;
    let reverseStep = 0;

    function setStatus(text: string) {
      status.textContent = text;
    }

    function drawForward(t: number) {
      const frame = forwardFrames[Math.max(0, Math.min(t, STEPS))];
      slider.value = String(t);
      label.textContent = `T = ${t}`;
      drawFrame(frame, dataLabels, t === 0 ? 'DATA / t=0' : `FORWARD / t=${t}`);
      setStatus(t === 0 ? '原始分布' : t === STEPS ? '接近纯噪声' : `前向加噪 · t = ${t}`);
    }

    function drawReverse(step: number) {
      if (!reverseFrames || !reverseLabels) return;
      const t = Math.max(0, STEPS - step);
      label.textContent = `T = ${t}`;
      drawFrame(reverseFrames[step], reverseLabels, `REVERSE / t=${t}`);
    }

    function finishReverse() {
      playing = false;
      slider.disabled = false;
      playBtn.disabled = false;
      playBtn.textContent = '再次运行';
      setStatus('逆向采样完成 · 三个簇');
    }

    function playReverse() {
      if (playing) return;
      if (!reverseFrames) {
        setStatus('准备采样...');
        buildReverse();
      }
      if (!reverseFrames) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        drawReverse(STEPS);
        setStatus('已直接显示最终结果');
        return;
      }
      playing = true;
      reverseStep = 0;
      slider.disabled = true;
      playBtn.disabled = true;
      playBtn.textContent = '采样中...';
      drawReverse(0);
      setStatus('逆向采样中...');
      const tick = () => {
        reverseStep += 1;
        drawReverse(reverseStep);
        if (reverseStep < STEPS) {
          reverseTimer = window.setTimeout(tick, 18);
        } else {
          finishReverse();
        }
      };
      reverseTimer = window.setTimeout(tick, 120);
    }

    function reset() {
      window.clearTimeout(reverseTimer);
      playing = false;
      slider.disabled = false;
      playBtn.disabled = false;
      playBtn.textContent = '运行逆向去噪';
      drawForward(0);
    }

    playBtn.addEventListener('click', playReverse);
    resetBtn.addEventListener('click', reset);
    slider.addEventListener('input', () => {
      if (playing) return;
      drawForward(Number(slider.value));
    });

    drawForward(0);
  }

  const demos = document.querySelectorAll<HTMLElement>('[data-diffusion-demo]');
  demos.forEach(initDemo);
</script>

<style>
  .diffusion-demo {
    margin: 2.2em 0;
    padding: 16px;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--surface);
  }
  .demo-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }
  .demo-kicker {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: .16em;
    color: var(--accent);
  }
  .demo-title {
    margin: 4px 0 0;
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink);
  }
  .demo-status {
    padding-top: 3px;
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--muted-light);
    white-space: nowrap;
  }
  .demo-canvas {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 1;
    margin-top: 14px;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--paper);
  }
  .demo-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    margin-top: 12px;
  }
  .demo-btn {
    padding: 5px 10px;
    border: 1px solid var(--rule);
    border-radius: 3px;
    background: var(--surface-alt);
    color: var(--ink-soft);
    font-family: var(--font-sans);
    font-size: 12px;
    cursor: pointer;
    transition: border-color .2s, color .2s;
  }
  .demo-btn:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }
  .demo-btn:disabled {
    cursor: wait;
    opacity: .55;
  }
  .demo-btn-primary {
    border-color: var(--accent);
    color: var(--accent);
  }
  .demo-range {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 8px;
    min-width: 210px;
    font-size: 11px;
    color: var(--muted);
  }
  .demo-range input {
    flex: 1;
    min-width: 80px;
    accent-color: var(--accent);
  }
  .demo-t {
    min-width: 44px;
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--muted-light);
    text-align: right;
  }
  .demo-note {
    margin: 10px 0 0;
    font-size: 11px;
    line-height: 1.8;
    color: var(--muted);
  }
  .demo-mono {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--ink-soft);
  }
  @media (max-width: 640px) {
    .demo-range {
      flex-basis: 100%;
    }
    .demo-title {
      font-size: 18px;
    }
  }
</style>
