    font-size: 12px;
    letter-spacing: .16em;
    color: var(--accent);
  }
  .demo-title {
    margin: 4px 0 0;
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink);
  }
  .demo-status {
    padding-top: 3px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted-light);
    white-space: nowrap;
  }
  .demo-body {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) 220px;
    gap: 18px;
    align-items: start;
    margin-top: 14px;
  }
  .demo-figure {
    min-width: 0;
    margin: 0;
  }
  .demo-canvas-wrap {
    position: relative;
  }
  .demo-canvas {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--paper);
  }
  .demo-mode-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 2px 7px;
    border: 1px solid var(--rule);
    border-radius: 3px;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: .08em;
    backdrop-filter: blur(4px);
  }
  .demo-figure figcaption {
    margin-top: .55rem;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.6;
    color: var(--muted-light);
  }
  .demo-panel {
    display: flex;
