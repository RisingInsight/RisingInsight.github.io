---
import katex from 'katex';

interface Props {
  latex: string;
  number?: string;
  label?: string;
}

const { latex, number, label } = Astro.props;
const html = katex.renderToString(latex, {
  displayMode: true,
  throwOnError: false,
  strict: false,
});
---

<figure class="mdx-equation">
  {label && <div class="mdx-equation-label">{label}</div>}
  <div class="mdx-equation-body" set:html={html} />
  {number && <figcaption class="mdx-equation-number">({number})</figcaption>}
</figure>

<style>
  .mdx-equation {
    position: relative;
    margin: 2em 0;
    padding: 1rem 3rem 1rem 1rem;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .mdx-equation-label {
    margin-bottom: .5rem;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--muted-light);
  }
  .mdx-equation-body :global(.katex-display) {
    margin: 0 !important;
  }
  .mdx-equation-number {
    position: absolute;
    right: .8rem;
    bottom: .9rem;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--muted-light);
  }
</style>
