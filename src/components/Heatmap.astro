---
import type { CommitActivity } from '../utils/git';
import { getCommitActivity } from '../utils/git';

interface Props {
  activity?: CommitActivity;
}

const activity = Astro.props.activity ?? getCommitActivity();
const weekCount = activity.weeks.length;
const summary = `过去 12 个月共 ${activity.totalYear} 次提交，当前连续 ${activity.currentStreak} 天。`;
---

<section class="panel overflow-hidden" data-heatmap>
  <div class="flex flex-wrap items-start justify-between gap-4 border-b border-rule px-5 py-4 sm:px-6">
    <div>
      <div class="flex items-center gap-2">
        <span class="mono-label text-accent">activity.log</span>
        <span class="h-px w-8 bg-accent/50"></span>
      </div>
      <h2 class="mt-2 font-serif text-xl font-semibold tracking-[-0.02em] text-ink sm:text-2xl">
        创作热力图
      </h2>
      <p class="mt-1 text-[12px] text-muted">过去 12 个月的真实 git 提交记录</p>
    </div>
    <div class="grid grid-cols-3 gap-5 text-right">
      <div>
        <div class="font-serif text-xl text-ink">{activity.totalYear}</div>
        <div class="mono-label mt-1">commits</div>
      </div>
      <div>
        <div class="font-serif text-xl text-accent">{activity.currentStreak}d</div>
        <div class="mono-label mt-1">streak</div>
      </div>
      <div>
        <div class="font-serif text-xl text-ink">{activity.totalAll}</div>
        <div class="mono-label mt-1">all time</div>
      </div>
    </div>
  </div>

  <div class="px-5 py-5 sm:px-6">
    <div class="heatmap-scroll">
      <div class="heatmap-inner" style={`--weeks:${weekCount}`}>
        <div class="heatmap-months" aria-hidden="true">
          {activity.weeks.map((week) => (
            <span class="heatmap-month">{week.month}</span>
          ))}
        </div>

        <div class="heatmap-body">
          <div class="heatmap-weekdays" aria-hidden="true">
            <span></span>
            <span>MON</span>
            <span></span>
            <span>WED</span>
            <span></span>
            <span>FRI</span>
            <span></span>
          </div>

          <div
            class="heatmap-grid"
            data-heatmap-grid
            role="img"
            aria-label={summary}
          >
            {activity.weeks.map((week) =>
              week.days.map((day) => (
                <span
                  class:list={[
                    'heatmap-cell',
                    `level-${day.level}`,
                    day.future && 'is-future',
                  ]}
                  data-date={day.date}
                  data-count={day.count}
                  tabindex={day.count > 0 ? 0 : undefined}
                  aria-label={`${day.date}：${day.count} 次提交`}
                ></span>
              ))
            )}
          </div>
        </div>

        <div class="heatmap-footer">
          <span class="mono-label">last commit · {activity.lastCommit ?? 'unknown'}</span>
          <div class="flex items-center gap-1.5">
            <span class="mono-label">less</span>
            {[0, 1, 2, 3, 4].map((level) => (
              <span class:list={['heatmap-cell', `level-${level}`]} aria-hidden="true"></span>
            ))}
            <span class="mono-label">more</span>
          </div>
        </div>
        <div class="heatmap-mobile-hint">swipe horizontally →</div>
      </div>
    </div>
  </div>

  <div class="heatmap-tooltip" data-heatmap-tooltip aria-hidden="true"></div>
</section>

<style>
  .heatmap-scroll {
    overflow-x: auto;
    padding-bottom: 4px;
    scrollbar-width: thin;
  }

  .heatmap-inner {
    min-width: 825px;
    --cell: 11px;
    --gap: 4px;
  }

  .heatmap-months {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: var(--cell);
    gap: var(--gap);
    margin-left: 30px;
    padding-bottom: 7px;
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: .08em;
    color: var(--muted-light);
  }

  .heatmap-month {
    display: block;
    width: 0;
    overflow: visible;
    white-space: nowrap;
  }

  .heatmap-body {
    display: flex;
    gap: 6px;
  }

  .heatmap-weekdays {
    display: grid;
    grid-template-rows: repeat(7, var(--cell));
    gap: var(--gap);
    width: 24px;
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 7px;
    letter-spacing: .06em;
    color: var(--muted-light);
    text-align: right;
  }

  .heatmap-weekdays span {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    height: var(--cell);
  }

  .heatmap-grid {
    display: grid;
    grid-template-rows: repeat(7, var(--cell));
    grid-auto-flow: column;
    grid-auto-columns: var(--cell);
    gap: var(--gap);
  }

  .heatmap-cell {
    display: block;
    width: var(--cell);
    height: var(--cell);
    border-radius: 2px;
    background: var(--rule-soft);
    outline: none;
    transition: transform .15s ease, box-shadow .15s ease, background .2s ease;
  }

  .heatmap-cell[tabindex]:hover,
  .heatmap-cell[tabindex]:focus-visible {
    position: relative;
    z-index: 2;
    transform: scale(1.35);
    box-shadow: 0 0 0 1px var(--accent), 0 0 12px rgba(var(--accent-rgb), .45);
  }

  .heatmap-cell.level-1 { background: rgba(var(--accent-rgb), .22); }
  .heatmap-cell.level-2 { background: rgba(var(--accent-rgb), .42); }
  .heatmap-cell.level-3 { background: rgba(var(--accent-rgb), .66); }
  .heatmap-cell.level-4 {
    background: var(--accent);
    box-shadow: 0 0 8px rgba(var(--accent-rgb), .28);
  }

  .heatmap-cell.is-future {
    background: transparent;
    border: 1px dashed var(--rule-soft);
    opacity: .4;
  }

  .heatmap-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-left: 30px;
    padding-top: 10px;
  }

  .heatmap-footer .heatmap-cell {
    width: 9px;
    height: 9px;
  }

  .heatmap-tooltip {
    position: fixed;
    z-index: 120;
    pointer-events: none;
    padding: 5px 8px;
    border: 1px solid var(--rule);
    border-radius: 3px;
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--shadow);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: .02em;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity .12s ease, transform .12s ease;
  }

  .heatmap-tooltip.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .heatmap-mobile-hint {
    display: none;
    margin-left: 30px;
    padding-top: 8px;
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--muted-light);
  }

  @media (max-width: 640px) {
    .heatmap-inner {
      min-width: 720px;
      --cell: 10px;
      --gap: 3px;
    }
    .heatmap-mobile-hint { display: block; }
  }
</style>

<script>
  const heatmap = document.querySelector<HTMLElement>('[data-heatmap]');
  if (heatmap) {
    const grid = heatmap.querySelector<HTMLElement>('[data-heatmap-grid]');
    const tooltip = heatmap.querySelector<HTMLElement>('[data-heatmap-tooltip]');
    let activeCell: HTMLElement | null = null;

    function showTooltip(cell: HTMLElement, x: number, y: number) {
      if (!tooltip) return;
      const date = cell.dataset.date || '';
      const count = Number(cell.dataset.count || 0);
      tooltip.textContent = `${date} · ${count} ${count === 1 ? 'commit' : 'commits'}`;
      tooltip.classList.add('is-visible');
      const padding = 12;
      const rect = tooltip.getBoundingClientRect();
      const left = Math.min(Math.max(x + padding, 8), window.innerWidth - rect.width - 8);
      const top = y + padding + rect.height > window.innerHeight ? y - rect.height - padding : y + padding;
      tooltip.style.left = `${left}px`;
      tooltip.style.top = `${top}px`;
    }

    function hideTooltip() {
      tooltip?.classList.remove('is-visible');
      activeCell = null;
    }

    grid?.addEventListener('pointerover', (event) => {
      const cell = (event.target as HTMLElement).closest<HTMLElement>('.heatmap-cell[data-date]');
      if (!cell || cell === activeCell) return;
      activeCell = cell;
      showTooltip(cell, event.clientX, event.clientY);
    });

    grid?.addEventListener('pointermove', (event) => {
      if (activeCell) showTooltip(activeCell, event.clientX, event.clientY);
    });

    grid?.addEventListener('pointerleave', hideTooltip);

    grid?.addEventListener('focusin', (event) => {
      const cell = (event.target as HTMLElement).closest<HTMLElement>('.heatmap-cell[data-date]');
      if (!cell) return;
      activeCell = cell;
      const rect = cell.getBoundingClientRect();
      showTooltip(cell, rect.right, rect.top);
    });

    grid?.addEventListener('focusout', hideTooltip);

    document.addEventListener('scroll', hideTooltip, { passive: true });
  }
</script>
