---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 - 页面未找到" description="页面不存在">
  <main class="mx-auto flex min-h-[60vh] max-w-3xl flex-col items-center justify-center px-4 py-24 text-center">
    <div class="font-mono text-[9px] uppercase tracking-[0.18em] text-muted-light">
      404 / Not found
    </div>
    <h1 class="mt-4 font-serif text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
      这个页面不存在
    </h1>
    <p class="mt-4 text-sm leading-7 text-muted">
      可能是链接过期，或者它从来没有存在过。
    </p>
    <div class="mt-8 flex gap-5 text-[12px]">
      <a href="/" class="text-ink underline decoration-rule underline-offset-4 transition-colors hover:text-accent">
        返回首页
      </a>
      <a href="/blog/" class="text-muted underline decoration-rule underline-offset-4 transition-colors hover:text-accent">
        浏览笔记
      </a>
    </div>
  </main>
</BaseLayout>
