---
import BaseLayout from '../layouts/BaseLayout.astro';
import CatMascot from '../components/CatMascot.astro';
---

<BaseLayout title="404 // RisingInsight" description="页面不存在">
  <main id="main" class="mx-auto flex min-h-[70vh] max-w-3xl flex-col items-center justify-center px-4 py-24">
    <div class="relative w-full max-w-xl">
      <span class="not-found-owl" aria-hidden="true">
        <CatMascot static />
      </span>
      <div class="terminal-window">
        <div class="terminal-bar">
          <span class="terminal-dot"></span>
          <span class="terminal-dot"></span>
          <span class="terminal-dot"></span>
          <span class="ml-2 font-mono text-[11px] tracking-[0.08em] term-muted">error.log</span>
          <span class="ml-auto font-mono text-[11px] uppercase tracking-[0.12em] term-muted">exit 1</span>
        </div>
        <div class="p-6 font-mono text-[12px] leading-6">
          <div><span class="term-accent">$</span> <span class="term-fg">cat /requested/path</span></div>
          <div class="mt-3 text-[var(--danger)]">404: no such file or directory</div>
          <h1 class="mt-6 font-serif text-3xl font-semibold tracking-[.01em] term-fg sm:text-4xl">
            这个页面不存在
          </h1>
          <p class="mt-3 text-[13px] leading-6 term-muted">
            可能是链接过期，或者它从来没有存在过。
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href="/" class="btn btn-on-term">cd ~</a>
            <a href="/blog/" class="btn btn-ghost-on-term">ls /blog</a>
          </div>
          <div class="mt-6 flex items-center gap-2 term-muted">
            <span class="term-accent">$</span>
            <span class="cursor-blink"></span>
          </div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  /* 灵鸮栖在终端窗口右上角：静态，每页只此一处 */
  .not-found-owl {
    position: absolute;
    top: -76px;
    right: 30px;
    width: 76px;
    height: 76px;
    line-height: 0;
  }
  .not-found-owl :global(svg) {
    width: 100%;
    height: 100%;
  }
  @media (max-width: 640px) {
    .not-found-owl {
      top: -58px;
      right: 14px;
      width: 58px;
      height: 58px;
    }
  }

  /* 终端内是暗底：按钮改为亮色语言，避免陷入背景 */
  .btn-on-term {
    border-color: var(--term-fg);
    background: var(--term-fg);
    color: var(--term-bg);
  }
  .btn-on-term:hover {
    border-color: var(--term-accent);
    background: var(--term-accent);
    color: var(--term-bg);
  }
  .btn-ghost-on-term {
    border-color: var(--term-border);
    background: transparent;
    color: var(--term-fg);
  }
  .btn-ghost-on-term:hover {
    border-color: var(--term-accent);
    color: var(--term-accent);
  }
</style>
