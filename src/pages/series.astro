---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { SERIES_INFO } from '../consts';
import {
  formatDate,
  formatWordCount,
  getSeriesGroups,
  getWordCount,
} from '../utils/blog';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const seriesGroups = getSeriesGroups(allPosts);
const seriesNotes = seriesGroups.reduce((sum, group) => sum + group.posts.length, 0);
---

<BaseLayout title="系列" description="按主题组织的连续笔记">
  <main class="mx-auto max-w-4xl px-4 pb-24 pt-10 sm:px-6 lg:px-8">
    <Breadcrumb items={[{ label: '首页', href: '/' }, { label: '系列' }]} />

    <header class="border border-rule bg-surface/55 p-5 sm:p-7">
      <div class="flex items-center gap-2 border-b border-rule-soft pb-3 font-mono text-[11px] tracking-[0.08em] text-muted-light">
        <span class="text-accent">~/</span>
        series.index
      </div>
      <div class="mt-5 font-mono text-[11px] uppercase tracking-[0.16em] text-accent">series</div>
      <h1 class="mt-3 font-serif text-3xl font-semibold tracking-[-0.035em] text-ink sm:text-4xl">
        系列
      </h1>
      <p class="mt-3 max-w-2xl text-sm leading-7 text-muted">
        把同一主题的笔记整理成连续的阅读路径。
        {seriesGroups.length > 0 && `共 ${seriesGroups.length} 个系列、${seriesNotes} 篇笔记。`}
      </p>
    </header>

    {seriesGroups.length > 0 ? (
      <div class="mt-10 space-y-14">
        {seriesGroups.map((group, index) => {
          const description = SERIES_INFO[group.name];
          return (
            <section id={`series-${group.slug}`} class="scroll-mt-24">
              <div class="flex flex-col gap-3 border-b border-rule pb-4 sm:flex-row sm:items-end sm:justify-between">
                <div>
                  <div class="font-mono text-[11px] uppercase tracking-[0.18em] text-accent">
                    Series {String(index + 1).padStart(2, '0')}
                  </div>
                  <h2 class="mt-2 font-serif text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
                    {group.name}
                  </h2>
                </div>
                <div class="font-mono text-[11px] uppercase tracking-[0.12em] text-muted-light">
                  {group.posts.length} notes · {formatWordCount(group.words)} 字
                </div>
              </div>

              {description && (
                <p class="mt-4 max-w-2xl text-[14px] leading-7 text-muted">{description}</p>
              )}

              <div class="mt-6 divide-y divide-rule border border-rule bg-surface">
                {group.posts.map((post, postIndex) => (
                  <a
                    href={`/blog/${post.id}/`}
                    class="group grid grid-cols-[36px_minmax(0,1fr)] gap-3 p-5 sm:grid-cols-[46px_minmax(0,1fr)] sm:p-6"
                  >
                    <span aria-hidden="true" class="font-serif text-2xl leading-none text-accent/60">
                      {String(postIndex + 1).padStart(2, '0')}
                    </span>
                    <div class="min-w-0">
                      <div class="font-mono text-[11px] uppercase tracking-[0.1em] text-muted-light">
                        {formatDate(post.data.pubDate)} · {formatWordCount(getWordCount(post.body || ''))} 字
                      </div>
                      <h3 class="mt-2 font-serif text-lg font-semibold leading-snug text-ink transition-colors group-hover:text-accent sm:text-xl">
                        {post.data.title}
                      </h3>
                      <p class="mt-1.5 text-[14px] leading-7 text-muted">{post.data.description}</p>
                      {post.data.tags.length > 0 && (
                        <div class="mt-3 flex flex-wrap gap-2">
                          {post.data.tags.slice(0, 4).map((tag) => (
                            <span class="tag">{tag}</span>
                          ))}
                        </div>
                      )}
                    </div>
                  </a>
                ))}
              </div>
            </section>
          );
        })}
      </div>
    ) : (
      <p class="py-16 text-sm text-muted">系列正在整理中。</p>
    )}
  </main>
</BaseLayout>
