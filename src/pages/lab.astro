---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ImageDiffusionDemo from '../components/mdx/ImageDiffusionDemo.astro';
import { GITHUB_BRANCH, GITHUB_REPO } from '../consts';
---

<BaseLayout title="实验 // RisingInsight" description="交互式可视化与小型实验">
  <main class="mx-auto max-w-4xl px-4 pb-24 pt-10 sm:px-6 lg:px-8">
    <Breadcrumb items={[{ label: '首页', href: '/' }, { label: '实验' }]} />

    <header class="border border-rule bg-surface/55 p-5 sm:p-7">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-rule-soft pb-3">
        <div class="flex items-center gap-2 font-mono text-[9px] tracking-[0.08em] text-muted-light">
          <span class="text-accent">~/</span>
          lab/
        </div>
        <span class="flex items-center gap-2 font-mono text-[8px] uppercase tracking-[0.12em] text-accent">
          <span class="status-dot"></span>
          interactive
        </span>
      </div>
      <div class="mt-5 font-mono text-[9px] uppercase tracking-[0.16em] text-accent">lab</div>
      <h1 class="mt-3 font-serif text-3xl font-semibold tracking-[-0.035em] text-ink sm:text-4xl">
        实验
      </h1>
      <p class="mt-3 max-w-2xl text-sm leading-7 text-muted">
        把论文里的过程变成可以拖动、可以观察的东西。这里放一些小型交互实验和可视化。
      </p>
      <a
        href={`https://github.com/${GITHUB_REPO}/blob/${GITHUB_BRANCH}/src/components/mdx/ImageDiffusionDemo.astro`}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-5 inline-flex font-mono text-[9px] uppercase tracking-[0.1em] text-muted transition-colors hover:text-accent"
      >
        view source ↗
      </a>
    </header>

    <section class="mt-8">
      <ImageDiffusionDemo />
      <p class="mt-4 font-mono text-[10px] leading-6 text-muted">
        完整推导和解释见
        <a
          href="/blog/image-diffusion-demo/"
          class="text-ink underline decoration-rule underline-offset-4 transition-colors hover:text-accent"
        >《图像扩散：一张图片的加噪与去噪》</a>。
      </p>
    </section>
  </main>
</BaseLayout>
