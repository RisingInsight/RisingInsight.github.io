---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { GITHUB_BRANCH, GITHUB_REPO, PROFILE, SOCIALS } from '../consts';
import { formatDate } from '../utils/blog';

const interests = [
  { label: '生成模型', detail: 'Diffusion / VAE / GAN / Flow' },
  { label: '图像模态转换', detail: 'Image-to-Image / Multi-modal Translation' },
  { label: '深度学习工程', detail: 'PyTorch / Training / Inference / Tooling' },
  { label: '技术写作', detail: 'Build in public / Notes / Experiments' },
];

const timeline = [
  { year: '2026.01.01', title: '搭建个人博客', desc: '使用 Hugo 搭建了个人博客。' },
  { year: '2026.04.11', title: '重构个人博客', desc: '使用 Astro 重构了个人博客。' },
  { year: '2026.10.21', title: '技术风改版', desc: '转向实验室终端风，加入热力图、状态面板与终端交互。' },
];

const toolbox = [
  { category: 'Modeling', items: ['PyTorch', 'Transformer', 'GCN', 'YOLO'] },
  { category: 'Data', items: ['Python', 'NumPy', 'Pandas', 'WebDataset'] },
  { category: 'Build', items: ['Astro', 'TypeScript', 'Tailwind CSS', 'GitHub Actions'] },
];

const recentPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title="关于" description={`About ${PROFILE.name} - Deep Learning Researcher`}>
  <main id="main" class="mx-auto max-w-4xl px-4 pb-24 pt-10 sm:px-6 lg:px-8">
    <Breadcrumb items={[{ label: '首页', href: '/' }, { label: '关于' }]} />

    <header class="border-b border-rule pb-10">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <p class="font-mono text-[12px] text-muted-light">~/about.md</p>
        <a
          href={`https://github.com/${GITHUB_REPO}/edit/${GITHUB_BRANCH}/src/pages/about.astro`}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[12px] text-muted-light transition-colors hover:text-accent"
        >
          编辑 <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="mt-8 flex flex-col gap-6 sm:flex-row sm:items-start">
        <img
          src={PROFILE.avatar}
          alt={PROFILE.name}
          width="160"
          height="160"
          class="h-20 w-20 rounded-full border border-rule object-cover"
        />
        <div class="min-w-0">
          <h1 class="font-serif text-[2.1rem] font-semibold leading-[1.3] tracking-[.01em] text-ink sm:text-[2.5rem]">
            {PROFILE.name}
          </h1>
          <p class="mt-2 text-[13px] text-muted">{PROFILE.role} · {PROFILE.location}</p>
          <p class="mt-4 max-w-2xl text-[15px] leading-8 text-ink-soft">
            你好，我是 {PROFILE.name}。我关注生成模型与深度学习，喜欢把论文里的东西跑起来，
            再把实现过程、踩坑记录和一些技术想法写在这里。
          </p>
          <p class="mt-2 max-w-2xl text-[13px] leading-7 text-muted">
            {PROFILE.bio} · {PROFILE.tagline}
          </p>
        </div>
      </div>
    </header>

    <div class="mt-12 grid gap-12 md:grid-cols-[1fr_240px]">
      <div>
        <section>
          <div class="mono-label">
            Focus areas
          </div>
          <div class="mt-4 divide-y divide-rule">
            {interests.map((item, index) => (
              <div class="grid grid-cols-[28px_1fr] gap-4 py-4">
                <span class="font-serif text-lg leading-none text-accent/70">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <div>
                  <h2 class="font-serif text-base font-semibold text-ink">{item.label}</h2>
                  <p class="mt-1 text-[13px] leading-6 text-muted">{item.detail}</p>
                </div>
              </div>
            ))}
          </div>
        </section>

        <section class="mt-12">
          <div class="mono-label">
            Stack
          </div>
          <div class="mt-4 divide-y divide-rule">
            {toolbox.map((group) => (
              <div class="grid gap-2 py-4 sm:grid-cols-[90px_1fr]">
                <div class="mono-label">
                  {group.category}
                </div>
                <div class="flex flex-wrap gap-x-4 gap-y-1 text-[14px] text-ink">
                  {group.items.map((item) => <span>{item}</span>)}
                </div>
              </div>
            ))}
          </div>
        </section>

        <section class="mt-12">
          <div class="flex items-baseline justify-between">
            <div class="mono-label">
              Recent logs
            </div>
            <a href="/blog/" class="text-[12px] text-muted transition-colors hover:text-accent">
              全部 <span aria-hidden="true">→</span>
            </a>
          </div>
          <div class="mt-4 divide-y divide-rule">
            {recentPosts.map((post) => (
              <a
                href={`/blog/${post.id}/`}
                class="group flex items-baseline justify-between gap-4 py-3"
              >
                <span class="font-serif text-sm font-semibold text-ink transition-colors group-hover:text-accent">
                  {post.data.title}
                </span>
                <span class="font-mono text-[11px] text-muted-light">
                  {formatDate(post.data.pubDate)}
                </span>
              </a>
            ))}
          </div>
        </section>
      </div>

      <aside class="space-y-10">
        <section>
          <div class="mono-label">Profile</div>
          <dl class="mt-4 space-y-3 text-[13px]">
            <div>
              <dt class="text-muted-light">Role</dt>
              <dd class="mt-0.5 text-ink">{PROFILE.role}</dd>
            </div>
            <div>
              <dt class="text-muted-light">School</dt>
              <dd class="mt-0.5 text-ink">{PROFILE.school}</dd>
            </div>
            <div>
              <dt class="text-muted-light">Location</dt>
              <dd class="mt-0.5 text-ink">{PROFILE.location}</dd>
            </div>
          </dl>
        </section>

        <section>
          <div class="mono-label">Site log</div>
          <div class="mt-4 space-y-4">
            {timeline.map((item) => (
              <div>
                <div class="font-mono text-[11px] text-muted-light">{item.year}</div>
                <div class="mt-1 text-[13px] font-medium text-ink">{item.title}</div>
                <p class="mt-0.5 text-[12px] leading-6 text-muted">{item.desc}</p>
              </div>
            ))}
          </div>
        </section>

        <section>
          <div class="mono-label">Contact</div>
          <div class="mt-4 flex flex-col gap-2 text-[13px]">
            {SOCIALS.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-muted transition-colors hover:text-accent"
              >
                {social.name} <span aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </section>
      </aside>
    </div>

    <div class="mt-16 border-t border-rule pt-8 text-center">
      <p class="font-serif text-lg text-muted">“{PROFILE.bio}”</p>
    </div>
  </main>
</BaseLayout>
