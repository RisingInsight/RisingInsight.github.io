---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { PROFILE, SOCIALS } from '../consts';
import { formatDate } from '../utils/blog';

const interests = [
  { label: '扩散模型', detail: 'Diffusion Model / Latent Diffusion Model' },
  { label: '图像模态转换', detail: 'Image-to-Image Translations' },
  { label: '多模态学习', detail: 'Multi-modal / CLIP / Cross-modal Generation' },
  { label: '生成模型', detail: 'VAE / GAN / Diffusion' },
];

const timeline = [
  { year: '2026.01.01', title: '搭建个人博客', desc: '使用 Hugo 搭建了个人博客。' },
  { year: '2026.04.11', title: '重构个人博客', desc: '使用 Astro 重构了个人博客。' },
];

const toolbox = [
  { category: '深度学习', items: ['PyTorch', 'Transformer', 'GCN', 'YOLO'] },
  { category: '数据处理', items: ['WebDataset', 'Pandas', 'NumPy', 'Matplotlib'] },
  { category: '博客工具', items: ['Astro', 'Tailwind CSS', 'GitHub Pages'] },
];

const recentPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title="关于" description={`About ${PROFILE.name} - Deep Learning Researcher`}>
  <main class="mx-auto max-w-4xl px-4 pb-24 pt-10 sm:px-6 lg:px-8">
    <Breadcrumb items={[{ label: '首页', href: '/' }, { label: '关于' }]} />

    <header class="flex flex-col gap-6 border-b border-rule pb-10 sm:flex-row sm:items-start">
      <img
        src={PROFILE.avatar}
        alt={PROFILE.name}
        class="h-24 w-24 rounded-full border border-rule object-cover"
      />
      <div class="min-w-0">
        <div class="font-mono text-[9px] uppercase tracking-[0.16em] text-accent">About</div>
        <h1 class="mt-3 font-serif text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
          {PROFILE.name}
        </h1>
        <p class="mt-2 text-sm text-muted">{PROFILE.role} · {PROFILE.tagline}</p>
        <p class="mt-4 max-w-2xl text-sm leading-7 text-ink-soft">
          你好，我是 {PROFILE.name}，一名关注扩散模型与图像模态转换的学生。
          这里记录推导、实验与论文阅读，也会放一些技术实践。
        </p>
        <div class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-[11px] text-muted">
          <span>{PROFILE.location}</span>
          <span>{PROFILE.school}</span>
        </div>
      </div>
    </header>

    <div class="mt-12 grid gap-12 md:grid-cols-[1fr_240px]">
      <div>
        <section>
          <div class="font-mono text-[9px] uppercase tracking-[0.16em] text-muted-light">
            Research interests
          </div>
          <div class="mt-4 divide-y divide-rule">
            {interests.map((item, index) => (
              <div class="grid grid-cols-[28px_1fr] gap-4 py-4">
                <span class="font-serif text-lg leading-none text-accent/70">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <div>
                  <h2 class="font-serif text-base font-semibold text-ink">{item.label}</h2>
                  <p class="mt-1 text-[12px] leading-6 text-muted">{item.detail}</p>
                </div>
              </div>
            ))}
          </div>
        </section>

        <section class="mt-12">
          <div class="font-mono text-[9px] uppercase tracking-[0.16em] text-muted-light">
            Toolbox
          </div>
          <div class="mt-4 divide-y divide-rule">
            {toolbox.map((group) => (
              <div class="grid gap-2 py-4 sm:grid-cols-[90px_1fr]">
                <div class="font-mono text-[9px] uppercase tracking-[0.1em] text-muted-light">
                  {group.category}
                </div>
                <div class="flex flex-wrap gap-x-4 gap-y-1 text-[13px] text-ink">
                  {group.items.map((item) => <span>{item}</span>)}
                </div>
              </div>
            ))}
          </div>
        </section>

        <section class="mt-12">
          <div class="flex items-baseline justify-between">
            <div class="font-mono text-[9px] uppercase tracking-[0.16em] text-muted-light">
              Recent notes
            </div>
            <a href="/blog/" class="text-[11px] text-muted transition-colors hover:text-accent">
              全部 <span aria-hidden="true">→</span>
            </a>
          </div>
          <div class="mt-4 divide-y divide-rule">
            {recentPosts.map((post) => (
              <a
                href={`/blog/${post.id}/`}
                class="group flex items-baseline justify-between gap-4 py-3"
              >
                <span class="font-serif text-sm font-semibold text-ink transition-colors group-hover:text-accent">
                  {post.data.title}
                </span>
                <span class="font-mono text-[9px] text-muted-light">
                  {formatDate(post.data.pubDate)}
                </span>
              </a>
            ))}
          </div>
        </section>
      </div>

      <aside class="space-y-10">
        <section>
          <div class="font-mono text-[9px] uppercase tracking-[0.16em] text-muted-light">Profile</div>
          <dl class="mt-4 space-y-3 text-[12px]">
            <div>
              <dt class="text-muted-light">Role</dt>
              <dd class="mt-0.5 text-ink">{PROFILE.role}</dd>
            </div>
            <div>
              <dt class="text-muted-light">School</dt>
              <dd class="mt-0.5 text-ink">{PROFILE.school}</dd>
            </div>
            <div>
              <dt class="text-muted-light">Location</dt>
              <dd class="mt-0.5 text-ink">{PROFILE.location}</dd>
            </div>
          </dl>
        </section>

        <section>
          <div class="font-mono text-[9px] uppercase tracking-[0.16em] text-muted-light">Site log</div>
          <div class="mt-4 space-y-4">
            {timeline.map((item) => (
              <div>
                <div class="font-mono text-[9px] text-muted-light">{item.year}</div>
                <div class="mt-1 text-[12px] font-medium text-ink">{item.title}</div>
                <p class="mt-0.5 text-[11px] leading-6 text-muted">{item.desc}</p>
              </div>
            ))}
          </div>
        </section>

        <section>
          <div class="font-mono text-[9px] uppercase tracking-[0.16em] text-muted-light">Contact</div>
          <div class="mt-4 flex flex-col gap-2 text-[12px]">
            {SOCIALS.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-muted transition-colors hover:text-accent"
              >
                {social.name} <span aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </section>
      </aside>
    </div>

    <div class="mt-16 border-t border-rule pt-8 text-center">
      <p class="font-serif text-lg text-muted">“{PROFILE.bio}”</p>
    </div>
  </main>
</BaseLayout>
