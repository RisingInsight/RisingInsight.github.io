---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ddl from '../data/ccf-ddl.json';
import { VENUES, AREA_ORDER, AREA_LABELS, buildVenueYears, dblpUrl, findVenue } from '../data/venues';
import { JOURNAL_METRICS } from '../data/journal-metrics';

const currentYear = new Date().getFullYear();

// 领域内排序：CCF 等级（A→B→C→其他）优先；同级期刊按影响因子降序、
// 会议按简称字母序（CCF 目录内同级即按字母排列）
const RANK_ORDER: Record<string, number> = { A: 0, B: 1, C: 2, '—': 3 };
function compareVenues(a: (typeof VENUES)[number], b: (typeof VENUES)[number]): number {
  const byRank = (RANK_ORDER[a.rank] ?? 3) - (RANK_ORDER[b.rank] ?? 3);
  if (byRank !== 0) return byRank;
  if (a.type !== b.type) return a.type === 'conference' ? -1 : 1;
  if (a.type === 'journal') {
    const byIf = (JOURNAL_METRICS[b.id]?.if ?? -1) - (JOURNAL_METRICS[a.id]?.if ?? -1);
    if (byIf !== 0) return byIf;
  }
  return a.short.localeCompare(b.short);
}

// ---- 截稿日数据（ccfddl 社区仓库，构建期烤入） ----
function ddlDate(str, tz) {
  if (!str) return null;
  let offset = '-12:00'; // 默认 AoE
  const m = (tz || '').match(/UTC([+-]\d{1,2})/);
  if (m) {
    const h = parseInt(m[1], 10);
    offset = `${h >= 0 ? '+' : '-'}${String(Math.abs(h)).padStart(2, '0')}:00`;
  }
  const d = new Date(str.replace(' ', 'T') + offset);
  return isNaN(d.getTime()) ? null : d;
}
const ddlRows = ddl.entries
  .map((e) => {
    const first = e.timelines.map((t) => t.deadline).sort()[0];
    const firstDate = ddlDate(first, e.timezone);
    return { ...e, first, firstDate };
  })
  .filter((e) => e.firstDate)
  .sort((a, b) => a.firstDate - b.firstDate);
// 论文门户里能对上号的会议 → 行内截稿提醒
const ddlByVenue = new Map(ddlRows.filter((r) => findVenue(r.id)).map((r) => [r.id, r]));
const upcomingDdlCount = ddlRows.filter((r) => r.firstDate.getTime() > Date.now()).length;

const conferences = VENUES.filter((venue) => venue.type === 'conference');
const journals = VENUES.filter((venue) => venue.type === 'journal');
const groups = AREA_ORDER.map((area) => ({
  area,
  label: AREA_LABELS[area],
  venues: VENUES.filter((venue) => venue.area === area).sort(compareVenues),
})).filter((group) => group.venues.length > 0);
const venueYears = new Map(VENUES.map((venue) => [venue.id, buildVenueYears(venue, currentYear)]));
---

<BaseLayout title="CCF 顶会顶刊 // RisingInsight" description="CCF 顶会截稿日倒计时与历年中稿论文一站式门户：按领域/等级浏览会议与期刊，摘要、代码、被引与 BibTeX 就地检索">
  <main id="main" class="mx-auto max-w-6xl px-4 pb-24 pt-10 sm:px-6 lg:px-8">
    <Breadcrumb items={[{ label: '首页', href: '/' }, { label: 'CCF' }]} />

    <header class="border-b border-rule pb-9">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <p class="font-mono text-[12px] text-muted-light">~/ccf</p>
        <a
          href={ddl.source}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[12px] text-muted-light transition-colors hover:text-accent"
        >
          数据源 ccfddl <span aria-hidden="true">↗</span>
        </a>
      </div>
      <h1 class="mt-4 font-serif text-[2.1rem] font-semibold leading-[1.3] tracking-[.01em] text-ink sm:text-[2.5rem]">
        CCF 顶会顶刊
      </h1>
      <p class="mt-4 max-w-2xl text-[14px] leading-7 text-muted">
        截稿日追踪与历年中稿论文一站式页面：上方是 CCF-A/B 会议的最近截稿倒计时，
        下方按领域、会议/期刊与年份浏览论文。摘要、代码链接与被引就地展开，
        论文可收藏并在本机保留；截稿时间以官网为准。
      </p>
      <div class="mt-5 flex flex-wrap gap-x-4 gap-y-1 font-mono text-[11px] text-muted-light">
        <span>{ddlRows.length} deadlines</span>
        <span>{upcomingDdlCount} upcoming</span>
        <span>{conferences.length} conferences</span>
        <span>{journals.length} journals</span>
        <span>OpenAlex + Semantic Scholar + 官方快照</span>
      </div>
    </header>

    <!-- 搜索优先：找论文是首要任务，截稿日收在下方折叠区 -->
    <section class="paper-search-hero" aria-labelledby="find-heading">
      <div class="sec-head">
        <h2 id="find-heading" class="font-serif text-xl font-semibold text-ink">找论文</h2>
        <span class="mono-label">标题 / 作者 / 关键词</span>
      </div>
      <input
        id="global-search"
        type="search"
        class="venue-search global-search-main"
        placeholder="输入论文标题、作者或关键词…"
        aria-label="跨会议搜索论文"
        autocomplete="off"
      />
      <span id="global-search-hint" class="global-hint">本地快照 + 收藏 + OpenAlex 在线检索</span>
      <section id="global-panel" class="saved-panel" hidden aria-label="论文检索结果">
        <div class="sec-head">
          <h2 class="font-serif text-lg font-semibold text-ink">检索结果</h2>
          <button id="global-close" type="button" class="papers-close">收起</button>
        </div>
        <ol id="global-list" class="papers-list mt-2"></ol>
        <p id="global-empty" class="py-8 text-center text-[13px] text-muted">没有匹配的论文。</p>
      </section>
    </section>

    <details class="ddl-fold">
      <summary class="ddl-fold-summary">截稿日 <span>{ddlRows.length} 条 · 点击展开</span></summary>
    <section id="deadlines" aria-labelledby="ddl-heading">
      <div class="sec-head mt-9">
        <h2 id="ddl-heading" class="font-serif text-xl font-semibold text-ink">截稿日</h2>
        <div class="ddl-tabs" role="group" aria-label="按等级筛选">
          <button type="button" data-ddl-rank="all" class="ddl-tab is-active" aria-pressed="true">全部</button>
          <button type="button" data-ddl-rank="A" class="ddl-tab" aria-pressed="false">CCF-A</button>
          <button type="button" data-ddl-rank="B" class="ddl-tab" aria-pressed="false">CCF-B</button>
          <label class="ddl-only-upcoming">
            <input type="checkbox" id="ddl-upcoming" checked />
            <span>仅未截止</span>
          </label>
        </div>
      </div>

      <div id="ddl-rows" class="divide-y divide-rule-soft">
        {ddlRows.map((e) => {
          const first = e.timelines[0];
          const isPast = e.firstDate ? e.firstDate.getTime() < Date.now() : false;
          const days = e.firstDate
            ? Math.ceil((e.firstDate.getTime() - Date.now()) / 86400000)
            : null;
          const hasVenue = Boolean(findVenue(e.id));
          return (
            <article
              id={`ddl-${e.id}`}
              class="ddl-row"
              data-ddl-rank={e.rank}
              data-deadline={first.deadline}
              data-tz={e.timezone}
              data-past={String(isPast)}
            >
              <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-1">
                <div class="flex min-w-0 items-center gap-3">
                  <span class:list={['ddl-badge', e.rank === 'A' ? 'is-a' : 'is-b']}>{e.rank}</span>
                  <h3 class="font-mono text-[1.02rem] font-bold text-ink">
                    {e.title}
                    <span class="ml-1 font-sans text-[12.5px] font-normal text-muted-light">{e.year}</span>
                  </h3>
                </div>
                <time class="font-mono text-[12px] text-muted-light" datetime={first.deadline}>
                  {first.deadline} {e.timezone}
                </time>
              </div>
              <div class="mt-1 flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-[11.5px] text-muted-light">
                <span class="inline-flex items-center gap-1.5">
                  <span
                    class="ddl-countdown font-serif text-[15px] font-semibold tabular-nums text-accent"
                    data-deadline={first.deadline}
                    data-tz={e.timezone}
                  >
                    {days !== null ? `D${days <= 0 ? '+' + Math.abs(days) : '-' + days}` : '—'}
                  </span>
                  <span class="ddl-status-label">{isPast ? '已截止' : '距截稿'}</span>
                </span>
                {e.timelines.length > 1 && <span>{e.timelines.length} 轮</span>}
                <span class="font-sans">{e.place}</span>
                {e.link && (
                  <a href={e.link} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-accent">
                    官网 <span aria-hidden="true">↗</span>
                  </a>
                )}
                {hasVenue && (
                  <a href={`#${e.id}`} class="transition-colors hover:text-accent">
                    历年论文 <span aria-hidden="true">→</span>
                  </a>
                )}
              </div>
            </article>
          );
        })}
      </div>

      <p id="ddl-empty" class="hidden py-10 text-center text-sm text-muted">
        没有匹配的会议 —— 放宽筛选试试。
      </p>
    </section>
    </details>

    <div id="papers-root" class="mt-9">
      <div id="papers-cluster" class="papers-cluster">
        <div class="flex flex-wrap items-center gap-3">
          <div class="kind-tabs" role="group" aria-label="论文类型">
            <button type="button" class="kind-btn is-active" data-kind="conference" aria-pressed="true">
              顶会 <span>{conferences.length}</span>
            </button>
            <button type="button" class="kind-btn" data-kind="journal" aria-pressed="false">
              顶刊 <span>{journals.length}</span>
            </button>
          </div>
          <input id="venue-search" type="search" class="venue-search" placeholder="搜索会议 / 期刊…" aria-label="搜索会议或期刊" />
          <button id="saved-open" type="button" class="saved-open" aria-expanded="false">
            我的收藏 <span id="saved-count">0</span>
          </button>
        </div>

        <div id="area-filter" class="area-filter mt-3" role="group" aria-label="按领域筛选">
          <button type="button" class="area-btn is-active" data-area="all" aria-pressed="true">全部</button>
          {groups.map((group) => (
            <button type="button" class="area-btn" data-area={group.area} aria-pressed="false">{group.label}</button>
          ))}
        </div>

        <div id="rank-filter" class="area-filter mt-3" role="group" aria-label="按 CCF 等级筛选">
          <button type="button" class="area-btn is-active" data-rank="all" aria-pressed="true">全部等级</button>
          <button type="button" class="area-btn" data-rank="A" aria-pressed="false">CCF-A</button>
          <button type="button" class="area-btn" data-rank="B" aria-pressed="false">CCF-B</button>
          <button type="button" class="area-btn" data-rank="other" aria-pressed="false">其他</button>
        </div>

      </div>

      <section id="saved-panel" class="saved-panel" hidden aria-label="我的收藏">
        <div class="sec-head">
          <h2 class="font-serif text-lg font-semibold text-ink">我的收藏</h2>
          <div class="saved-actions">
            <span id="cloud-status" class="cloud-status">本机保存</span>
            <button id="saved-note" type="button" class="papers-close">用收藏写笔记</button>
            <button id="saved-export" type="button" class="papers-close">导出全部 BibTeX</button>
            <button id="saved-clear" type="button" class="papers-close">清空</button>
            <button id="saved-close" type="button" class="papers-close">收起</button>
          </div>
        </div>
        <input id="saved-search" type="search" class="papers-search mt-3" placeholder="在收藏中搜索标题 / 作者 / 摘要…" aria-label="搜索收藏的论文" />
        <ol id="saved-list" class="papers-list mt-2"></ol>
        <p id="saved-empty" class="py-10 text-center text-[13px] text-muted">
          还没有收藏论文。点论文卡片上的「收藏」保存，可标记想读 / 在读 / 已读；
          在 /write →「发布设置」配置 Worker 后，收藏会跨设备同步。
        </p>
      </section>

      <p id="venue-empty" class="hidden py-16 text-center text-sm text-muted">没有匹配的会议或期刊。</p>

    <div id="venue-groups">
      {groups.map((group) => (
        <section class="venue-group" data-area={group.area}>
          <div class="sec-head">
            <h2 class="font-serif text-xl font-semibold text-ink">{group.label}</h2>
            <span class="venue-group-count font-mono text-[11px] text-muted-light">{group.venues.length} 个</span>
          </div>
          <div class="venue-list">
            {group.venues.map((venue) => {
              const years = venueYears.get(venue.id) || [];
              const rankClass = venue.rank === 'A' ? 'is-a' : venue.rank === 'B' ? 'is-b' : 'is-other';
              const venueDdl = ddlByVenue.get(venue.id);
              const metrics = venue.type === 'journal' ? JOURNAL_METRICS[venue.id] : undefined;
              return (
                <article
                  id={venue.id}
                  class="venue-block"
                  data-id={venue.id}
                  data-type={venue.type}
                  data-area={venue.area}
                  data-rank={venue.rank}
                  data-search={`${venue.short} ${venue.full} ${venue.id}`.toLowerCase()}
                >
                  <div class="venue-head">
                    <div class="venue-id">
                      <h3 class="venue-title">
                        <span class="venue-short">{venue.short}</span>
                        <span class={`venue-rank ${rankClass}`}>{venue.rank}</span>
                        <span class="venue-type">{venue.type === 'journal' ? '期刊' : '会议'}</span>
                      </h3>
                      <p class="venue-full">{venue.full}</p>
                      <p class="venue-meta">
                        <span>{venue.provider === 'openalex' ? 'OpenAlex' : 'Semantic Scholar'}</span>
                        {venue.rank !== '—' && <span> · CCF-{venue.rank}</span>}
                        {metrics && (
                          <span
                            class="venue-metrics"
                            title="IF/分区为 2023-2024 JCR 与中科院升级版，仅供参考，以官方为准"
                          >
                            {metrics.if !== undefined && <span> · IF {metrics.if}</span>}
                            {metrics.cas && <span> · 中科院{metrics.cas}</span>}
                            {metrics.jcr && <span> · {metrics.jcr}</span>}
                            {metrics.ei && <span> · EI</span>}
                          </span>
                        )}
                        {venueDdl && (
                          <a href="#deadlines" class="venue-ddl" title="查看截稿日详情">
                            {' '}· {venueDdl.firstDate.getTime() > Date.now()
                              ? `截稿 D-${Math.max(0, Math.ceil((venueDdl.firstDate.getTime() - Date.now()) / 86400000))}`
                              : '已截稿'}
                          </a>
                        )}
                        <span> · </span>
                        {venue.dblp && (
                          <a href={dblpUrl(venue)} target="_blank" rel="noopener noreferrer">DBLP ↗</a>
                        )}
                        {venue.site && (
                          <a href={venue.site} target="_blank" rel="noopener noreferrer">
                            {venue.type === 'journal' ? '期刊主页' : '官网'} ↗
                          </a>
                        )}
                        <span> · </span>
                        <button type="button" class="papers-latest" title={`打开 ${venue.short} 最近一届论文`}>
                          最新论文 →
                        </button>
                      </p>
                    </div>
                    <div class="venue-years">
                      {years.map((year) => (
                        <button
                          type="button"
                          class:list={['year-btn', { 'has-snap': Boolean(venue.snapshots?.[year]) }]}
                          data-year={year}
                          title={venue.snapshots?.[year] ? '该届有官方 proceedings 快照' : undefined}
                          aria-expanded="false"
                          aria-controls={`papers-${venue.id}`}
                        >{year}</button>
                      ))}
                    </div>
                  </div>

                  <div id={`papers-${venue.id}`} class="papers-panel hidden">
                    <div class="papers-toolbar">
                      <span class="papers-where" hidden></span>
                      <input type="search" class="papers-search" placeholder="搜索标题 / 作者 / 摘要…" aria-label={`搜索 ${venue.short} 论文`} />
                      <div class="papers-filters" role="group" aria-label="论文筛选">
                        <button type="button" class="papers-filter" data-paper-filter="fulltext" aria-pressed="false">有全文</button>
                        <button type="button" class="papers-filter" data-paper-filter="saved" aria-pressed="false">收藏</button>
                      </div>
                      <span class="papers-status"></span>
                      <button type="button" class="papers-retry hidden">重试</button>
                      <button type="button" class="papers-close">收起</button>
                    </div>
                    <div class="papers-skeleton" hidden aria-hidden="true">
                      {Array.from({ length: 4 }).map(() => (
                        <div class="skel-item">
                          <div class="skel-line skel-title"></div>
                          <div class="skel-line skel-author"></div>
                          <div class="skel-line skel-abs"></div>
                        </div>
                      ))}
                    </div>
                    <ol class="papers-list"></ol>
                    <div class="papers-foot">
                      <button type="button" class="papers-more hidden">显示更多</button>
                      <a class="papers-dblp" target="_blank" rel="noopener noreferrer">在 DBLP 查看该年 ↗</a>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      ))}
    </div>
    </div>
  </main>

  <dialog id="paper-dialog" class="paper-dialog" aria-label="论文详情">
    <div class="paper-dialog-head">
      <span class="mono-label">paper detail</span>
      <button id="paper-dialog-close" type="button" class="papers-close">关闭</button>
    </div>
    <div id="paper-dialog-body" class="paper-dialog-body"></div>
  </dialog>
</BaseLayout>

<style is:inline>
  .kind-tabs {
    display: inline-flex;
    padding: 3px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--surface);
  }
  .kind-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font-size: 12.5px;
    cursor: pointer;
    transition: color .2s, background .2s;
  }
  .kind-btn.is-active {
    background: var(--ink);
    color: var(--paper);
  }
  .kind-btn span {
    font-family: var(--font-mono);
    font-size: 10.5px;
    opacity: .7;
  }
  .venue-search {
    flex: 1 1 220px;
    max-width: 320px;
    padding: 7px 13px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    font-size: 13px;
  }
  .venue-search:focus-visible,
  .saved-open:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .saved-open {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 13px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font-size: 12.5px;
    cursor: pointer;
    transition: color .2s, border-color .2s;
  }
  .saved-open:hover,
  .saved-open[aria-expanded='true'] {
    color: var(--accent);
    border-color: var(--accent);
  }
  .saved-open span {
    font-family: var(--font-mono);
    font-size: 10.5px;
  }
  .area-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  /* 搜索优先：首屏主入口 */
  .paper-search-hero {
    margin-top: 1.5rem;
    padding: 1rem 1.1rem 1.15rem;
    border: 1px solid var(--rule);
    border-radius: var(--r-md);
    background: var(--surface);
  }
  .paper-search-hero .sec-head { margin-top: 0; margin-bottom: .8rem; }
  .global-search-main {
    width: 100%;
    padding: .7rem .9rem;
    border: 1px solid var(--rule);
    border-radius: var(--r-sm);
    background: var(--paper);
    color: var(--ink);
    font-size: 15px;
  }
  .global-search-main:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .global-hint {
    display: block;
    margin-top: .5rem;
    color: var(--muted-light);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .03em;
  }
  .paper-search-hero #global-panel { margin-top: 1rem; }

  .ddl-fold {
    margin-top: 1.4rem;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .ddl-fold-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: .9rem 0;
    cursor: pointer;
    list-style: none;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 600;
  }
  .ddl-fold-summary::-webkit-details-marker { display: none; }
  .ddl-fold-summary span {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
    color: var(--muted-light);
  }
  .ddl-fold > #deadlines > .sec-head { margin-top: 0; }
  .ddl-fold > #deadlines > .sec-head > h2 { display: none; }
  .area-btn {
    padding: 4px 10px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font-size: 12px;
    cursor: pointer;
    transition: color .2s, border-color .2s, background .2s;
  }
  .area-btn:hover {
    color: var(--ink);
    border-color: var(--muted-light);
  }
  .area-btn.is-active {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--accent);
  }

