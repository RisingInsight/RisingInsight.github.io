<script>
  import { findVenue, dblpUrl, AREA_LABELS } from '../data/venues';
  import { loadVenuePapers, toBibtex, bibtexKey } from '../lib/papers';

  const SAVED_KEY = 'papers:saved:v1';
  const PER_BATCH = 150;
  const paperIndex = new Map();
  // 远程检索（OpenAlex）命中的论文单独存，卡片按钮同样能取到完整元数据
  const remoteIndex = new Map();

  const blocks = Array.from(document.querySelectorAll('.venue-block'));
  const groupsEl = Array.from(document.querySelectorAll('.venue-group'));
  const kindBtns = Array.from(document.querySelectorAll('.kind-btn'));
  // 领域行与等级行都用 .area-btn 样式，必须按容器区分作用域，
  // 否则点任意一行的按钮会把另一行的高亮一起清掉
  const areaBtns = Array.from(document.querySelectorAll('#area-filter .area-btn'));
  const rankBtns = Array.from(document.querySelectorAll('#rank-filter .area-btn'));
  const venueSearch = document.getElementById('venue-search');
  const venueEmpty = document.getElementById('venue-empty');
  const savedOpen = document.getElementById('saved-open');
  const savedClose = document.getElementById('saved-close');
  const savedPanel = document.getElementById('saved-panel');
  const savedList = document.getElementById('saved-list');
  const savedEmpty = document.getElementById('saved-empty');
  const savedSearch = document.getElementById('saved-search');
  const savedCount = document.getElementById('saved-count');
  const globalSearch = document.getElementById('global-search');
  const globalPanel = document.getElementById('global-panel');
  const globalList = document.getElementById('global-list');
  const globalEmpty = document.getElementById('global-empty');
  const globalHint = document.getElementById('global-search-hint');
  const globalClose = document.getElementById('global-close');
  const detailDialog = document.getElementById('paper-dialog');
  const detailBody = document.getElementById('paper-dialog-body');
  const detailClose = document.getElementById('paper-dialog-close');

  let kind = 'conference';
  let area = 'all';
  let rank = 'all';
  let active = null;

  // ---- 收藏云端同步（可选）----
  // 复用 /write 发布设置里的 Worker 地址与口令；没配置时完全不发请求。
  const LIBRARY_WORKER_KEY = 'write:worker';
  const LIBRARY_TOKEN_KEY = 'write:token';
  let cloudTimer;

  function cloudConfig() {
    try {
      const base = (localStorage.getItem(LIBRARY_WORKER_KEY) || '').trim().replace(/\/+$/, '');
      const token = (localStorage.getItem(LIBRARY_TOKEN_KEY) || '').trim();
      return base && token ? { base, token } : null;
    } catch (e) {
      return null;
    }
  }

  function setCloudStatus(text) {
    const el = document.getElementById('cloud-status');
    if (el) el.textContent = text;
  }

  function syncSavedToCloud() {
    const cfg = cloudConfig();
    if (!cfg) return;
    window.clearTimeout(cloudTimer);
    cloudTimer = window.setTimeout(() => {
      fetch(cfg.base + '/library', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${cfg.token}` },
        body: JSON.stringify({ library: saved }),
      })
        .then((res) => setCloudStatus(res.ok ? '已同步到云端' : '云端未就绪，本地已保存'))
        .catch(() => setCloudStatus('云端未就绪，本地已保存'));
    }, 1200);
  }

  async function pullSavedFromCloud() {
    const cfg = cloudConfig();
    if (!cfg) {
      setCloudStatus('本机保存 · 配置 Worker 后可跨设备同步');
      return;
    }
    try {
      const res = await fetch(cfg.base + '/library', {
        headers: { Authorization: `Bearer ${cfg.token}` },
      });
      if (!res.ok) {
        setCloudStatus('云端未就绪，本地已保存');
        return;
      }
      const data = await res.json();
      if (data.library && typeof data.library === 'object') {
        // 合并：以云端为基础，保留本机离线期间新增的条目
        saved = { ...data.library, ...saved };
        localStorage.setItem(SAVED_KEY, JSON.stringify(saved));
        syncSavedCount();
        if (!savedPanel.hidden) renderSaved();
        if (!globalPanel.hidden) renderGlobal();
        updateGlobalHint();
      }
      setCloudStatus('已与云端同步');
    } catch (e) {
      setCloudStatus('云端未就绪，本地已保存');
    }
  }

  function loadSaved() {
    try {
      const raw = JSON.parse(localStorage.getItem(SAVED_KEY) || '{}');
      return raw && typeof raw === 'object' && !Array.isArray(raw) ? raw : {};
    } catch (e) {
      return {};
    }
  }
  let saved = loadSaved();

  function persistSaved() {
    try { localStorage.setItem(SAVED_KEY, JSON.stringify(saved)); } catch (e) {}
    syncSavedToCloud();
  }
  function syncSavedCount() {
    if (savedCount) savedCount.textContent = String(Object.keys(saved).length);
  }

  function esc(value) {
    return String(value == null ? '' : value).replace(/[&<>"']/g, (ch) => {
      if (ch === '&') return '&amp;';
      if (ch === '<') return '&lt;';
      if (ch === '>') return '&gt;';
      if (ch === '"') return '&quot;';
      return '&#39;';
    });
  }

  // ---- 关键词定位：空格分隔多词 AND 匹配 + 命中高亮 ----
  function queryTokens(q) {
    return String(q || '').trim().toLowerCase().split(/\s+/).filter(Boolean).slice(0, 8);
  }

  function paperMatches(paper, tokens) {
    if (!tokens || tokens.length === 0) return true;
    const haystack = `${paper.title}\n${paper.authors.join(' ')}\n${paper.abstract || ''}\n${paper.venueShort || ''}`.toLowerCase();
    return tokens.every((token) => haystack.includes(token));
  }

  function highlight(text, tokens) {
    const safe = esc(text);
    if (!tokens || tokens.length === 0) return safe;
    const pattern = tokens
      .map((token) => token.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'))
      .join('|');
    // 单次合并替换：不会重复扫描已插入的 <mark> 标签
    return safe.replace(new RegExp(`(${pattern})`, 'gi'), '<mark>$1</mark>');
  }

  function providerLabel(provider) {
    if (provider === 's2') return 'Semantic Scholar';
    if (provider === 'cvf') return 'CVF OpenAccess';
    if (provider === 'pmlr') return 'PMLR';
    if (provider === 'iclr') return 'ICLR Proceedings';
    if (provider === 'jmlr') return 'JMLR';
    if (provider === 'dblp') return 'DBLP';
    if (provider === 'aclanthology') return 'ACL Anthology';
    if (provider === 'crossref') return 'Crossref';
    return 'OpenAlex';
  }

  // 无被引数据的来源（官方快照 / DBLP / Anthology 目录）不展示“被引 0”徽章
  function isOfficialSource(paper) {
    return paper.source === 'cvf' || paper.source === 'pmlr' ||
      paper.source === 'iclr' || paper.source === 'jmlr' ||
      paper.source === 'dblp' || paper.source === 'aclanthology';
  }

  // ---- 写成笔记：把论文元数据交给 /write 编辑器 ----
  function toRef(paper) {
    return {
      key: bibtexKey(paper),
      title: paper.title || '',
      authors: Array.isArray(paper.authors) ? paper.authors : [],
      year: String(paper.year || ''),
      venue: paper.venueShort || paper.venueFull || '',
      url: paper.link || paper.oaUrl || paper.pdf || '',
      doi: paper.doi || '',
      arxiv: paper.arxiv || '',
      pdf: paper.pdf || '',
      bibtex: toBibtex(paper),
    };
  }

  function startNote(papers) {
    const refs = papers.map(toRef).filter((r) => r.key && r.title);
    if (!refs.length) return;
    try {
      localStorage.setItem('write:pending-refs', JSON.stringify(refs.slice(0, 30)));
    } catch (e) {}
    window.location.href = '/write/?from=ccf';
  }

  function findPaper(id) {
    return paperIndex.get(id) || remoteIndex.get(id) || saved[id];
  }

  function cardHtml(paper, mode, tokens) {
    const authorLine = paper.authors.slice(0, 3).join(', ') + (paper.more || paper.authors.length > 3 ? ' et al.' : '');
    const abstract = paper.abstract
      ? `<p class="paper-abstract">${highlight(paper.abstract, tokens)}</p>`
      : '<p class="paper-abstract is-empty">摘要暂缺，打开原文查看</p>';
    const toggle = paper.abstract
      ? '<button type="button" class="paper-toggle" aria-expanded="false">展开摘要</button>'
      : '';
    let links = '';
    if (paper.pdf) links += `<a class="paper-link" href="${esc(paper.pdf)}" target="_blank" rel="noopener noreferrer">PDF ↗</a>`;
    if (paper.oaUrl && paper.oaUrl !== paper.pdf) links += `<a class="paper-link" href="${esc(paper.oaUrl)}" target="_blank" rel="noopener noreferrer">原文 ↗</a>`;
    if (paper.code) links += `<a class="paper-link" href="${esc(paper.code)}" target="_blank" rel="noopener noreferrer">Code ↗</a>`;
    if (paper.arxiv) links += `<a class="paper-link" href="https://arxiv.org/abs/${esc(paper.arxiv)}" target="_blank" rel="noopener noreferrer">arXiv ↗</a>`;
    if (paper.doi) links += `<a class="paper-link" href="${esc(paper.doi)}" target="_blank" rel="noopener noreferrer">DOI ↗</a>`;
    if (!paper.pdf && !paper.oaUrl && !paper.doi && !paper.code && !paper.arxiv) links += `<a class="paper-link" href="${esc(paper.link)}" target="_blank" rel="noopener noreferrer">原文 ↗</a>`;
    const bib = `<button type="button" class="paper-bib" data-id="${esc(paper.id)}">BibTeX</button>`;
    const detail = `<button type="button" class="paper-detail" data-id="${esc(paper.id)}">详情</button>`;
    const saveLabel = mode === 'saved' ? '移除' : (saved[paper.id] ? '已收藏' : '收藏');
    const save = `<button type="button" class="paper-save" data-id="${esc(paper.id)}" aria-pressed="${saved[paper.id] ? 'true' : 'false'}">${saveLabel}</button>`;
    const note = `<button type="button" class="paper-note" data-id="${esc(paper.id)}" title="用这篇论文开一篇笔记">写成笔记 ↗</button>`;
    const statusLabels = { want: '想读', reading: '在读', read: '已读' };
    const statusKey = paper.status && statusLabels[paper.status] ? paper.status : 'want';
    const status = mode === 'saved'
      ? `<button type="button" class="paper-status" data-id="${esc(paper.id)}" data-status="${statusKey}" title="点击切换阅读状态">${statusLabels[statusKey]}</button>`
      : '';
    const venue = mode === 'panel' ? '' : `<span class="paper-venue">${esc(paper.venueShort)} ${paper.year}</span>`;
    // 官方 proceedings 快照没有被引数据，显示“被引 0”是噪音，直接不展示
    const citesBadge = isOfficialSource(paper) ? '' : `<span class="paper-cites">被引 ${paper.cites}</span>`;
    return `<li class="paper-item" data-id="${esc(paper.id)}">
      <div class="paper-head">
        <a class="paper-title" href="${esc(paper.link)}" target="_blank" rel="noopener noreferrer">${highlight(paper.title, tokens)}</a>
        ${citesBadge}
      </div>
      ${authorLine ? `<div class="paper-authors">${highlight(authorLine, tokens)}</div>` : ''}
      ${abstract}
      <div class="paper-actions">${toggle}${links}${detail}${bib}${save}${status}${note}${venue}</div>
    </li>`;
  }

  function openDetail(paper) {
    if (!detailDialog || !detailBody) return;
    const authorLine = paper.authors.join(', ') + (paper.more ? ' et al.' : '');
    let links = '';
    if (paper.pdf) links += `<a href="${esc(paper.pdf)}" target="_blank" rel="noopener noreferrer">PDF ↗</a>`;
    if (paper.oaUrl) links += `<a href="${esc(paper.oaUrl)}" target="_blank" rel="noopener noreferrer">原文 ↗</a>`;
    if (paper.code) links += `<a href="${esc(paper.code)}" target="_blank" rel="noopener noreferrer">Code ↗</a>`;
    if (paper.arxiv) links += `<a href="https://arxiv.org/abs/${esc(paper.arxiv)}" target="_blank" rel="noopener noreferrer">arXiv ↗</a>`;
    if (paper.doi) links += `<a href="${esc(paper.doi)}" target="_blank" rel="noopener noreferrer">DOI ↗</a>`;
    if (paper.link && paper.link !== paper.pdf && paper.link !== paper.doi && paper.link !== paper.oaUrl) {
      links += `<a href="${esc(paper.link)}" target="_blank" rel="noopener noreferrer">论文页 ↗</a>`;
    }
    const bib = toBibtex(paper);
    detailBody.innerHTML = `
      <div class="detail-venue">${esc(paper.venueShort)} ${paper.year} · ${esc(paper.venueFull)} · ${providerLabel(paper.source)}</div>
      <h2 class="detail-title">${esc(paper.title)}</h2>
      <p class="detail-authors">${authorLine ? esc(authorLine) : '作者信息暂缺'}</p>
      <p class="detail-abstract">${paper.abstract ? esc(paper.abstract) : '摘要暂缺，打开原文查看。'}</p>
      <div class="detail-links">${links}</div>
      <pre class="detail-bib">${esc(bib)}</pre>
      <button type="button" class="paper-bib detail-copy">复制 BibTeX</button>
    `;
    if (!detailDialog.open) detailDialog.showModal();
    detailClose?.focus();
  }

  let remoteStatus = '';
  let remoteSeq = 0;
  let remoteTimer;

  function updateGlobalHint() {
    if (!globalHint) return;
    const count = new Set([...paperIndex.keys(), ...Object.keys(saved), ...remoteIndex.keys()]).size;
    globalHint.textContent = remoteStatus || (count
      ? `可搜索 ${count} 篇已加载 / 收藏 / 在线论文`
      : '输入标题或作者即可检索：本站快照 + 收藏 + OpenAlex 在线结果');
  }

  // 在线检索：没点开任何会议年份时，也能直接按标题 / 作者找论文
  function fromOpenAlex(work) {
    const authors = (work.authorships || [])
      .map((a) => (a.author && a.author.display_name) || '')
      .filter(Boolean);
    const loc = work.primary_location || {};
    const src = loc.source || {};
    const doi = work.doi || '';
    const pdf = (work.open_access && work.open_access.oa_url) || '';
    return {
      id: 'oa:' + String(work.id || '').split('/').pop(),
      title: work.title || '',
      authors,
      more: false,
      abstract: '',
      cites: work.cited_by_count || 0,
      year: work.publication_year || 0,
      venueId: '',
      venueShort: src.display_name || 'OpenAlex',
      venueFull: src.display_name || '',
      venueType: src.type === 'journal' ? 'journal' : 'conference',
      doi,
      pdf,
      oaUrl: pdf,
      link: loc.landing_page_url || doi || work.id || '',
      fulltext: Boolean(pdf),
      source: 'openalex',
    };
  }

  function currentQuery() {
    return ((globalSearch && globalSearch.value) || '').trim();
  }

  async function fetchJsonWithTimeout(url) {
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 8000);
    try {
      const res = await fetch(url, { signal: controller.signal });
      if (!res.ok) throw new Error('HTTP ' + res.status);
      return await res.json();
    } finally {
      clearTimeout(timeout);
    }
  }

  function ingestRemote(papers) {
    for (const paper of papers.slice(0, 25)) {
      if (paper.id && paper.title) remoteIndex.set(paper.id, paper);
    }
  }

  // Semantic Scholar 作为 OpenAlex 限流（429）时的第二数据源
  function fromS2(item) {
    const ext = item.externalIds || {};
    const doi = ext.DOI ? `https://doi.org/${ext.DOI}` : '';
    const arxiv = ext.ArXiv || '';
    const pdf = (item.openAccessPdf && item.openAccessPdf.url) || '';
    return {
      id: 's2:' + String(item.paperId || ''),
      title: item.title || '',
      authors: (item.authors || []).map((a) => a.name).filter(Boolean),
      more: false,
      abstract: item.abstract || '',
      cites: item.citationCount || 0,
      year: item.year || 0,
      venueId: '',
      venueShort: item.venue || 'Semantic Scholar',
      venueFull: item.venue || '',
      venueType: 'conference',
      doi,
      pdf,
      oaUrl: pdf,
      arxiv,
      link: arxiv ? `https://arxiv.org/abs/${arxiv}` : (doi || item.url || ''),
      fulltext: Boolean(pdf),
      source: 's2',
    };
  }

  async function runRemoteSearch(q) {
    if (!q || q.length < 3) return;
    const seq = ++remoteSeq;
    remoteStatus = '正在在线检索…';
    updateGlobalHint();
    const oaUrl = `https://api.openalex.org/works?search=${encodeURIComponent(q)}&per-page=25&select=id,doi,title,authorships,publication_year,primary_location,cited_by_count,open_access&mailto=1668676243@qq.com`;
    try {
      const data = await fetchJsonWithTimeout(oaUrl);
      if (seq !== remoteSeq || q !== currentQuery()) return;
      ingestRemote((data.results || []).map(fromOpenAlex));
      remoteStatus = '';
      renderGlobalResults();
      return;
    } catch (e) {
      if (seq !== remoteSeq) return;
    }
    try {
      const s2Url = `https://api.semanticscholar.org/graph/v1/paper/search?query=${encodeURIComponent(q)}&limit=20&fields=title,abstract,authors,year,venue,citationCount,externalIds,openAccessPdf`;
      const data = await fetchJsonWithTimeout(s2Url);
      if (seq !== remoteSeq || q !== currentQuery()) return;
      ingestRemote((data.data || []).map(fromS2));
      remoteStatus = 'OpenAlex 限流，在线结果来自 Semantic Scholar';
      renderGlobalResults();
    } catch (e) {
      if (seq !== remoteSeq) return;
      remoteStatus = '在线检索暂不可用，已显示本地与收藏结果';
      updateGlobalHint();
    }
  }

  function renderGlobalResults() {
    if (!globalSearch || !globalPanel) return;
    const tokens = queryTokens(globalSearch.value);
    if (tokens.length === 0) {
      globalPanel.hidden = true;
      return;
    }
    const all = new Map([...paperIndex, ...Object.entries(saved), ...remoteIndex]);
    const shown = Array.from(all.values())
      .filter((paper) => paperMatches(paper, tokens))
      .sort((a, b) => (b.cites || 0) - (a.cites || 0))
      .slice(0, 150);
    globalList.innerHTML = shown.map((paper) => cardHtml(paper, 'global', tokens)).join('');
    if (globalEmpty) globalEmpty.hidden = shown.length > 0;
    globalPanel.hidden = false;
    updateGlobalHint();
  }

  function renderGlobal() {
    renderGlobalResults();
    window.clearTimeout(remoteTimer);
    const q = ((globalSearch && globalSearch.value) || '').trim();
    if (q.length < 3) {
      remoteStatus = '';
      updateGlobalHint();
      return;
    }
    remoteTimer = window.setTimeout(() => runRemoteSearch(q), 550);
  }

  function panelState(panel) {
    return panel && panel.__paperState ? panel.__paperState : null;
  }

  function setStatus(panel, text) {
    const status = panel.querySelector('.papers-status');
    if (status) status.textContent = text;
  }

  function renderPanel(panel, state) {
    const list = panel.querySelector('.papers-list');
    const search = panel.querySelector('.papers-search');
    const more = panel.querySelector('.papers-more');
    const retry = panel.querySelector('.papers-retry');
    const dblp = panel.querySelector('.papers-dblp');
    const skeleton = panel.querySelector('.papers-skeleton');
    const tokens = queryTokens((search && search.value) || '');
    const fulltextBtn = panel.querySelector('[data-paper-filter="fulltext"]');
    const savedBtn = panel.querySelector('[data-paper-filter="saved"]');
    const fulltextOnly = !!fulltextBtn && fulltextBtn.getAttribute('aria-pressed') === 'true';
    const savedOnly = !!savedBtn && savedBtn.getAttribute('aria-pressed') === 'true';

    let shown = state.papers.filter((paper) => {
      if (fulltextOnly && !paper.fulltext) return false;
      if (savedOnly && !saved[paper.id]) return false;
      return paperMatches(paper, tokens);
    });

    const cap = state.visible || PER_BATCH;
    list.innerHTML = shown.slice(0, cap).map((paper) => cardHtml(paper, 'panel', tokens)).join('');
    if (retry) retry.classList.add('hidden');
    if (skeleton) skeleton.hidden = !state.loading;

    if (state.error) {
      setStatus(panel, `加载失败：${state.error}`);
      if (retry) retry.classList.remove('hidden');
    } else if (state.loading) {
      setStatus(panel, `加载中 ${state.loaded || 0} / ${state.total || '…'} 篇 · ${state.providerLabel}`);
    } else if (shown.length === 0) {
      setStatus(panel, state.papers.length === 0
        ? '该届暂未收录 —— 尚未出版或数据源未收录，可去 DBLP / 官网查看。'
        : '没有匹配的论文 —— 试试更少的关键词。');
    } else if (tokens.length > 0) {
      setStatus(panel, `${shown.length} / ${state.papers.length} 篇匹配`);
    } else if (fulltextOnly || savedOnly) {
      setStatus(panel, `${shown.length} 篇匹配`);
    } else {
      const official = ['CVF OpenAccess', 'PMLR', 'ICLR Proceedings', 'JMLR'].includes(state.providerLabel);
      const sortLabel = official ? '官方顺序' : '按被引排序';
      const note = official ? ' · 官方快照，无被引数据' : '';
      setStatus(panel, `${shown.length} 篇 · ${sortLabel} · ${state.providerLabel}${note}`);
    }

    more.classList.toggle('hidden', shown.length <= cap);
    more.textContent = `显示更多（还有 ${Math.max(0, shown.length - cap)} 篇）`;

    if (dblp) {
      const venue = findVenue(state.venueId);
      if (venue && !venue.dblp) {
        dblp.classList.add('hidden');
      } else {
        dblp.classList.remove('hidden');
        dblp.href = venue ? dblpUrl(venue, state.year) : '#';
        dblp.textContent = state.papers.length === 0 && !state.loading && !state.error
          ? '该年 DBLP 页面 ↗'
          : '在 DBLP 查看该年 ↗';
      }
    }
  }

  function deactivateYears() {
    blocks.forEach((block) => {
      block.querySelectorAll('.year-btn').forEach((btn) => {
        btn.classList.remove('is-active');
        btn.setAttribute('aria-expanded', 'false');
      });
    });
  }

  function closeActive() {
    if (!active) return;
    active.panel.classList.add('hidden');
    deactivateYears();
    active = null;
  }

  function openYear(block, btn, options) {
    const venueId = block.dataset.id;
    const year = Number(btn.dataset.year);
    const panel = block.querySelector('.papers-panel');
    const venue = findVenue(venueId);
    if (!venue || !panel) return;

    if (active && active.block === block && active.year === year && !panel.classList.contains('hidden')) {
      closeActive();
      if (!options?.fromHash) history.replaceState(null, '', `#${venueId}`);
      return;
    }

    closeActive();
    btn.classList.add('is-active');
    btn.setAttribute('aria-expanded', 'true');
    panel.classList.remove('hidden');

    const where = panel.querySelector('.papers-where');
    if (where) {
      where.textContent = `${venue.short} ${year}`;
      where.hidden = false;
    }

    const state = {
      venueId,
      year,
      panel,
      block,
      papers: [],
      visible: PER_BATCH,
      loading: true,
      loaded: 0,
      total: 0,
      error: '',
      providerLabel: providerLabel(venue.provider),
    };
    panel.__paperState = state;
    active = state;
    if (!options?.fromHash) history.replaceState(null, '', `#${venueId}-${year}`);

    const search = panel.querySelector('.papers-search');
    if (search) search.value = '';
    panel.querySelectorAll('[data-paper-filter]').forEach((filter) => filter.setAttribute('aria-pressed', 'false'));

    renderPanel(panel, state);
    if (window.innerWidth < 960) {
      panel.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    }

    loadVenuePapers(venue, year, (loaded, total, provider) => {
      state.loaded = loaded;
      state.total = total;
      state.providerLabel = providerLabel(provider);
      if (active === state) setStatus(panel, `加载中 ${loaded} / ${total || '…'} 篇 · ${state.providerLabel}`);
    }).then((papers) => {
      state.papers = papers;
      state.loading = false;
      state.error = '';
      papers.forEach((paper) => paperIndex.set(paper.id, paper));
      updateGlobalHint();
      if (active === state) renderPanel(panel, state);
    }).catch((error) => {
      state.loading = false;
      state.error = String(error && error.message ? error.message : error);
      if (active === state) renderPanel(panel, state);
    });
  }

  blocks.forEach((block) => {
    block.addEventListener('click', (event) => {
      const target = event.target;
      if (!target || !target.closest) return;
      const yearBtn = target.closest('.year-btn');
      if (yearBtn) {
        openYear(block, yearBtn);
        return;
      }
      const where = target.closest('.papers-where');
      if (where) {
        block.scrollIntoView({ block: 'start', behavior: 'smooth' });
        return;
      }
      const ddlLink = target.closest('.venue-ddl');
      if (ddlLink) {
        const fold = document.querySelector('.ddl-fold');
        if (fold) fold.open = true; // 折叠区闭合时锚点跳转会静默失败，先展开
        return; // 放开默认锚点行为
      }
      const latest = target.closest('.papers-latest');
      if (latest) {
        const firstYear = block.querySelector('.year-btn');
        if (firstYear) openYear(block, firstYear);
        return;
      }
      const retry = target.closest('.papers-retry');
      if (retry && active) {
        const state = active;
        state.error = '';
        state.loading = true;
        state.papers = [];
        renderPanel(state.panel, state);
        const venue = findVenue(state.venueId);
        if (venue) {
          loadVenuePapers(venue, state.year, (loaded, total, provider) => {
            state.loaded = loaded;
            state.total = total;
            state.providerLabel = providerLabel(provider);
            if (active === state) setStatus(state.panel, `加载中 ${loaded} / ${total || '…'} 篇 · ${state.providerLabel}`);
          }).then((papers) => {
            state.papers = papers;
            state.loading = false;
            papers.forEach((paper) => paperIndex.set(paper.id, paper));
            updateGlobalHint();
            if (active === state) renderPanel(state.panel, state);
          }).catch((error) => {
            state.loading = false;
            state.error = String(error && error.message ? error.message : error);
            if (active === state) renderPanel(state.panel, state);
          });
        }
        return;
      }
      const close = target.closest('.papers-close');
      if (close && active) {
        closeActive();
        return;
      }
      const more = target.closest('.papers-more');
      if (more && active) {
        active.visible = (active.visible || PER_BATCH) + PER_BATCH;
        renderPanel(active.panel, active);
      }
    });
  });

  blocks.forEach((block) => {
    const panel = block.querySelector('.papers-panel');
    if (!panel) return;
    let renderQueued = false;
    panel.addEventListener('input', (event) => {
      if (!event.target.classList.contains('papers-search')) return;
      const state = panelState(panel);
      if (!state) return;
      state.visible = PER_BATCH;
      if (renderQueued) return;
      renderQueued = true;
      requestAnimationFrame(() => {
        renderQueued = false;
        const current = panelState(panel);
        if (current) renderPanel(panel, current);
      });
    });
    panel.addEventListener('click', (event) => {
      const target = event.target;
      if (!target || !target.closest) return;
      const filter = target.closest('[data-paper-filter]');
      if (filter) {
        const pressed = filter.getAttribute('aria-pressed') === 'true';
        filter.setAttribute('aria-pressed', String(!pressed));
        const state = panelState(panel);
        if (state) {
          state.visible = PER_BATCH;
          renderPanel(panel, state);
        }
      }
    });
  });

  function toggleSave(id) {
    const paper = findPaper(id);
    if (!paper) return;
    if (saved[id]) {
      delete saved[id];
    } else {
      saved[id] = { ...paper, status: 'want' };
    }
    persistSaved();
    syncSavedCount();
    updateGlobalHint();
    if (active) renderPanel(active.panel, active);
    if (!savedPanel.hidden) renderSaved();
    if (!globalPanel.hidden) renderGlobal();
  }

  async function copyText(text) {
    if (navigator.clipboard && navigator.clipboard.writeText) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch (e) {}
    }
    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.style.position = 'fixed';
    textarea.style.top = '-9999px';
    document.body.appendChild(textarea);
    textarea.select();
    let ok = false;
    try { ok = document.execCommand('copy'); } catch (e) {}
    textarea.remove();
    return ok;
  }

  document.querySelectorAll('.papers-list').forEach((list) => {
    list.addEventListener('click', async (event) => {
      const target = event.target;
      if (!target || !target.closest) return;
      const toggle = target.closest('.paper-toggle');
      if (toggle) {
        const item = toggle.closest('.paper-item');
        const abstract = item && item.querySelector('.paper-abstract');
        if (!abstract) return;
        const expanded = toggle.getAttribute('aria-expanded') === 'true';
        abstract.classList.toggle('is-expanded', !expanded);
        toggle.setAttribute('aria-expanded', String(!expanded));
        toggle.textContent = expanded ? '展开摘要' : '收起摘要';
        return;
      }
      const statusBtn = target.closest('.paper-status');
      if (statusBtn) {
        const id = statusBtn.getAttribute('data-id') || '';
        const paper = saved[id];
        if (paper) {
          const order = ['want', 'reading', 'read'];
          const current = paper.status || 'want';
          paper.status = order[(order.indexOf(current) + 1) % order.length];
          persistSaved();
          renderSaved();
        }
        return;
      }
      const note = target.closest('.paper-note');
      if (note) {
        const paper = findPaper(note.getAttribute('data-id') || '');
        if (paper) startNote([paper]);
        return;
      }
      const save = target.closest('.paper-save');
      if (save) {
        toggleSave(save.getAttribute('data-id') || '');
        return;
      }
      const detail = target.closest('.paper-detail');
      if (detail) {
        const id = detail.getAttribute('data-id') || '';
        const paper = findPaper(id);
        if (paper) openDetail(paper);
        return;
      }
      const bib = target.closest('.paper-bib');
      if (bib) {
        const id = bib.getAttribute('data-id') || '';
        const paper = findPaper(id);
        if (!paper) return;
        const ok = await copyText(toBibtex(paper));
        bib.textContent = ok ? '已复制' : '复制失败';
        setTimeout(() => { bib.textContent = 'BibTeX'; }, 1600);
      }
    });
  });

  function renderSaved() {
    const list = Object.values(saved).sort((a, b) => (b.cites || 0) - (a.cites || 0));
    const tokens = queryTokens(savedSearch && savedSearch.value);
    const shown = list.filter((paper) => paperMatches(paper, tokens));
    savedList.innerHTML = shown.slice(0, 300).map((paper) => cardHtml(paper, 'saved', tokens)).join('');
    savedEmpty.hidden = shown.length > 0;
  }

  if (savedOpen) {
    savedOpen.addEventListener('click', () => {
      const opening = savedPanel.hidden;
      savedPanel.hidden = !opening;
      savedOpen.setAttribute('aria-expanded', String(opening));
      if (opening) {
        renderSaved();
        savedPanel.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      }
    });
  }
  savedClose?.addEventListener('click', () => {
    savedPanel.hidden = true;
    savedOpen?.setAttribute('aria-expanded', 'false');
  });
  savedSearch?.addEventListener('input', renderSaved);
  globalSearch?.addEventListener('input', renderGlobal);
  globalClose?.addEventListener('click', () => {
    if (globalSearch) globalSearch.value = '';
    if (globalPanel) globalPanel.hidden = true;
    remoteStatus = '';
    updateGlobalHint();
  });

  detailClose?.addEventListener('click', () => detailDialog?.close());
  detailDialog?.addEventListener('click', (event) => {
    if (event.target === detailDialog) detailDialog.close();
  });
  detailBody?.addEventListener('click', async (event) => {
    const target = event.target;
    if (!target || !target.closest) return;
    const copy = target.closest('.detail-copy');
    if (!copy) return;
    const pre = detailBody.querySelector('.detail-bib');
    const ok = await copyText(pre ? pre.textContent || '' : '');
    copy.textContent = ok ? '已复制' : '复制失败';
    setTimeout(() => { copy.textContent = '复制 BibTeX'; }, 1600);
  });

  function applyVenueFilter() {
    const q = ((venueSearch && venueSearch.value) || '').trim().toLowerCase();
    let visible = 0;
    blocks.forEach((block) => {
      const matchKind = block.dataset.type === kind;
      const matchArea = area === 'all' || block.dataset.area === area;
      const matchRank = rank === 'all' ||
        (rank === 'other'
          ? block.dataset.rank !== 'A' && block.dataset.rank !== 'B'
          : block.dataset.rank === rank);
      const matchQuery = !q || block.dataset.search.includes(q);
      const show = matchKind && matchArea && matchRank && matchQuery;
      block.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    groupsEl.forEach((group) => {
      const count = Array.from(group.querySelectorAll('.venue-block')).filter((block) => block.style.display !== 'none').length;
      group.style.display = count > 0 ? '' : 'none';
      const badge = group.querySelector('.venue-group-count');
      if (badge) badge.textContent = `${count} 个`;
    });
    if (venueEmpty) {
      venueEmpty.classList.toggle('hidden', visible > 0);
      if (visible === 0) {
        const parts = [];
        if (area !== 'all') parts.push(AREA_LABELS[area] || area);
        parts.push(kind === 'conference' ? '顶会' : '顶刊');
        if (rank !== 'all') parts.push(rank === 'other' ? '其他等级' : 'CCF-' + rank);
        if (q) parts.push('搜索「' + q + '」');
        venueEmpty.textContent = parts.length > 1
          ? parts.join(' × ') + ' 下暂无收录来源 —— 试试放宽筛选，或切换顶会 / 顶刊。'
          : '没有匹配的会议或期刊。';
      }
    }
    if (active && active.block.style.display === 'none') closeActive();
  }

  kindBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      kind = btn.dataset.kind || 'conference';
      kindBtns.forEach((item) => {
        item.classList.toggle('is-active', item === btn);
        item.setAttribute('aria-pressed', String(item === btn));
      });
      applyVenueFilter();
    });
  });
  areaBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      area = btn.dataset.area || 'all';
      // 该领域在当前类型下没有来源、但另一类型有时，自动切换顶会/顶刊
      if (area !== 'all') {
        const hasFor = (k) => blocks.some((b) => b.dataset.type === k && b.dataset.area === area);
        if (!hasFor(kind) && hasFor(kind === 'conference' ? 'journal' : 'conference')) {
          kind = kind === 'conference' ? 'journal' : 'conference';
          kindBtns.forEach((item) => {
            item.classList.toggle('is-active', item.dataset.kind === kind);
            item.setAttribute('aria-pressed', String(item.dataset.kind === kind));
          });
        }
      }
      areaBtns.forEach((item) => {
        item.classList.toggle('is-active', item === btn);
        item.setAttribute('aria-pressed', String(item === btn));
      });
      applyVenueFilter();
    });
  });
  rankBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      rank = btn.dataset.rank || 'all';
      rankBtns.forEach((item) => {
        item.classList.toggle('is-active', item === btn);
        item.setAttribute('aria-pressed', String(item === btn));
      });
      applyVenueFilter();
    });
  });
  venueSearch?.addEventListener('input', applyVenueFilter);

  const savedExport = document.getElementById('saved-export');
  const savedClear = document.getElementById('saved-clear');

  const savedNote = document.getElementById('saved-note');
  savedNote?.addEventListener('click', () => {
    const list = Object.values(saved);
    if (!list.length) {
      window.alert('还没有收藏论文，先点论文卡片上的「收藏」。');
      return;
    }
    startNote(list);
  });

  savedExport?.addEventListener('click', () => {
    const papers = Object.values(saved);
    if (papers.length === 0) return;
    const bib = papers.map((paper) => toBibtex(paper)).join('\n\n');
    const blob = new Blob([bib], { type: 'text/x-bibtex;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'saved-papers.bib';
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
    savedExport.textContent = `已导出 ${papers.length} 篇`;
    setTimeout(() => { savedExport.textContent = '导出全部 BibTeX'; }, 1600);
  });

  savedClear?.addEventListener('click', () => {
    const count = Object.keys(saved).length;
    if (!count) return;
    if (!window.confirm(`确定清空全部 ${count} 篇收藏？此操作不可撤销。`)) return;
    saved = {};
    persistSaved();
    syncSavedCount();
    updateGlobalHint();
    renderSaved();
    if (active) renderPanel(active.panel, active);
    if (!globalPanel.hidden) renderGlobal();
  });

  // ---- 键盘：/ 聚焦论文检索，Esc 逐层收起面板 ----
  document.addEventListener('keydown', (event) => {
    if (event.key === '/' && !event.ctrlKey && !event.metaKey && !event.altKey) {
      const tag = document.activeElement ? document.activeElement.tagName : '';
      if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
      if (detailDialog && detailDialog.open) return;
      event.preventDefault();
      globalSearch?.focus();
      globalSearch?.select();
      return;
    }
    if (event.key === 'Escape') {
      if (detailDialog && detailDialog.open) return; // 弹窗自己响应 Esc
      if (active) {
        closeActive();
        return;
      }
      if (savedPanel && !savedPanel.hidden) {
        savedPanel.hidden = true;
        savedOpen?.setAttribute('aria-expanded', 'false');
        return;
      }
      if (globalPanel && !globalPanel.hidden) {
        globalPanel.hidden = true;
        if (globalSearch) globalSearch.value = '';
      }
    }
  });

  // ---- 深链：#cvpr / #cvpr-2026 → 定位并自动展开 ----
  function parseHash() {
    const raw = decodeURIComponent((location.hash || '').replace(/^#/, '')).trim();
    const match = raw.match(/^([A-Za-z0-9]+)(?:-(\d{4}))?$/);
    if (!match) return null;
    const venueId = match[1].toLowerCase();
    const venue = findVenue(venueId);
    if (!venue) return null;
    return { venueId, venue, year: match[2] ? Number(match[2]) : null };
  }

  function applyHash() {
    const target = parseHash();
    if (!target) return;
    const block = document.getElementById(target.venueId);
    if (!block) return;

    if (kind !== target.venue.type) {
      kind = target.venue.type;
      kindBtns.forEach((item) => {
        item.classList.toggle('is-active', item.dataset.kind === kind);
        item.setAttribute('aria-pressed', String(item.dataset.kind === kind));
      });
    }
    area = 'all';
    rank = 'all';
    areaBtns.forEach((item) => {
      item.classList.toggle('is-active', item.dataset.area === 'all');
      item.setAttribute('aria-pressed', String(item.dataset.area === 'all'));
    });
    rankBtns.forEach((item) => {
      item.classList.toggle('is-active', item.dataset.rank === 'all');
      item.setAttribute('aria-pressed', String(item.dataset.rank === 'all'));
    });
    if (venueSearch) venueSearch.value = '';
    applyVenueFilter();

    block.scrollIntoView({ block: 'start', behavior: 'smooth' });
    const yearBtns = Array.from(block.querySelectorAll('.year-btn'));
    if (yearBtns.length === 0) return;
    const isOpen = active && active.venueId === target.venueId && !active.panel.classList.contains('hidden');
    if (isOpen) return;
    const wanted = target.year
      ? yearBtns.find((b) => Number(b.dataset.year) === target.year)
      : yearBtns[0];
    if (wanted) openYear(block, wanted, { fromHash: true });
  }

  window.addEventListener('hashchange', applyHash);

  // ---- 吸顶偏移：跟随站点头部实际高度（移动端换行时会变化） ----
  function syncStickyTop() {
    const header = document.getElementById('site-header');
    const height = header ? header.getBoundingClientRect().height : 57;
    document.documentElement.style.setProperty('--papers-sticky-top', `${Math.max(0, Math.round(height))}px`);
  }
  syncStickyTop();
  window.addEventListener('resize', syncStickyTop);

  // ---- 筛选区吸顶联动：面板工具栏吸附在筛选区正下方；滚到截稿日区时筛选区让位 ----
  const papersCluster = document.getElementById('papers-cluster');
  let panelTopQueued = false;
  function syncPanelTop() {
    if (!papersCluster) return;
    const header = document.getElementById('site-header');
    const headerH = header ? header.getBoundingClientRect().height : 57;
    const top = Math.max(headerH, papersCluster.getBoundingClientRect().bottom);
    document.documentElement.style.setProperty('--papers-panel-top', `${Math.round(top)}px`);
  }
  function queuePanelTop() {
    if (panelTopQueued) return;
    panelTopQueued = true;
    requestAnimationFrame(() => {
      panelTopQueued = false;
      syncPanelTop();
    });
  }
  window.addEventListener('scroll', queuePanelTop, { passive: true });
  window.addEventListener('resize', () => {
    syncStickyTop();
    queuePanelTop();
  });
  syncPanelTop();

  // ---- 截稿日：等级 tab + 仅未截止 + 倒计时客户端重算 ----
  const ddlRowEls = Array.from(document.querySelectorAll('.ddl-row'));
  const ddlTabs = Array.from(document.querySelectorAll('.ddl-tab'));
  const ddlUpcoming = document.getElementById('ddl-upcoming');
  const ddlEmpty = document.getElementById('ddl-empty');
  let ddlRank = 'all';

  function ddlApplyFilter() {
    let visible = 0;
    ddlRowEls.forEach((row) => {
      const matchRank = ddlRank === 'all' || row.dataset.ddlRank === ddlRank;
      const matchUpcoming = !ddlUpcoming?.checked || row.dataset.past !== 'true';
      const show = matchRank && matchUpcoming;
      row.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    if (ddlEmpty) ddlEmpty.classList.toggle('hidden', visible > 0);
  }
  ddlTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      ddlRank = tab.dataset.ddlRank || 'all';
      ddlTabs.forEach((t) => {
        t.classList.toggle('is-active', t === tab);
        t.setAttribute('aria-pressed', String(t === tab));
      });
      ddlApplyFilter();
    });
  });
  ddlUpcoming?.addEventListener('change', ddlApplyFilter);
  ddlApplyFilter();

  function ddlRefreshCountdown() {
    ddlRowEls.forEach((row) => {
      const el = row.querySelector('.ddl-countdown');
      if (!el || !row.dataset.deadline) return;
      const tz = row.dataset.tz || 'UTC-12';
      let offset = '-12:00';
      const m = tz.match(/UTC([+-]\d{1,2})/);
      if (m) {
        const h = parseInt(m[1], 10);
        offset = `${h >= 0 ? '+' : '-'}${String(Math.abs(h)).padStart(2, '0')}:00`;
      }
      const d = new Date(row.dataset.deadline.replace(' ', 'T') + offset);
      if (isNaN(d.getTime())) return;
      const days = Math.ceil((d.getTime() - Date.now()) / 86400000);
      const past = d.getTime() < Date.now();
      if (row.dataset.past !== String(past)) {
        row.dataset.past = String(past);
        const label = row.querySelector('.ddl-status-label');
        if (label) label.textContent = past ? '已截止' : '距截稿';
        ddlApplyFilter();
      }
      el.textContent = past ? '—' : days <= 0 ? 'D±0' : `D-${days}`;
    });
  }
  ddlRefreshCountdown();
  window.setInterval(ddlRefreshCountdown, 30 * 60 * 1000);

  syncSavedCount();
  updateGlobalHint();
  pullSavedFromCloud();
  applyVenueFilter();
  if (location.hash === '#deadlines') {
    const fold = document.querySelector('.ddl-fold');
    if (fold) fold.open = true;
  }
  if (location.hash) applyHash();
</script>
