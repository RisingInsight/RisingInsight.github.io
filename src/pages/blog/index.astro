---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { GITHUB_BRANCH, GITHUB_REPO } from '../../consts';
import { formatDate, formatWordCount, getReadTime, getWordCount } from '../../utils/blog';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const tagCounts: Record<string, number> = {};
const categoryCounts: Record<string, number> = {};
for (const post of allPosts) {
  for (const tag of post.data.tags || []) {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  }
  for (const category of post.data.categories || []) {
    categoryCounts[category] = (categoryCounts[category] || 0) + 1;
  }
}
const allTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
const allCategories = Object.entries(categoryCounts).sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="笔记" description={`共 ${sortedPosts.length} 篇笔记`}>
  <main class="mx-auto max-w-4xl px-4 pb-24 pt-10 sm:px-6 lg:px-8">
    <Breadcrumb items={[{ label: '首页', href: '/' }, { label: '笔记' }]} />

    <header class="border border-rule bg-surface/55 p-5 sm:p-7">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-rule-soft pb-3">
        <div class="flex items-center gap-2 font-mono text-[11px] tracking-[0.08em] text-muted-light">
          <span class="text-accent">~/</span>
          posts.index
        </div>
        <a
          href={`https://github.com/${GITHUB_REPO}/new/${GITHUB_BRANCH}/src/content/blog`}
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-[11px] uppercase tracking-[0.1em] text-muted transition-colors hover:text-accent"
        >
          new post ↗
        </a>
      </div>
      <div class="mt-5 font-mono text-[11px] uppercase tracking-[0.16em] text-accent">notes</div>
      <h1 class="mt-3 font-serif text-3xl font-semibold tracking-[-0.035em] text-ink sm:text-4xl">
        笔记
      </h1>
      <p class="mt-3 text-sm text-muted">
        显示 <span id="post-count" class="font-mono text-ink">{sortedPosts.length}</span> / {sortedPosts.length} 篇 · 按分类或标签筛选
      </p>
    </header>

    <div class="mt-6 border-y border-rule py-4">
      <div id="category-filter" class="flex flex-wrap items-baseline gap-x-5 gap-y-1.5">
        <span class="w-10 shrink-0 font-mono text-[11px] uppercase tracking-[0.16em] text-muted-light">分类</span>
        <button type="button" data-category="all" class="filter-btn category-filter-btn is-active">
          全部
        </button>
        {allCategories.map(([category, count]) => (
          <button type="button" data-category={category} class="filter-btn category-filter-btn">
            {category} <span>{count}</span>
          </button>
        ))}
      </div>
      <div id="tag-filter" class="mt-2 flex flex-wrap items-baseline gap-x-5 gap-y-1.5">
        <span class="w-10 shrink-0 font-mono text-[11px] uppercase tracking-[0.16em] text-muted-light">标签</span>
        <button type="button" data-tag="all" class="filter-btn tag-filter-btn is-active">
          全部
        </button>
        {allTags.map(([tag, count]) => (
          <button type="button" data-tag={tag} class="filter-btn tag-filter-btn">
            {tag} <span>{count}</span>
          </button>
        ))}
      </div>
    </div>

    <div id="posts-grid" class="divide-y divide-rule">
      {sortedPosts.map((post) => {
        const postTags = (post.data.tags || []).join(',');
        const postCategories = (post.data.categories || []).join(',');
        return (
          <a
            href={`/blog/${post.id}/`}
            data-tags={postTags}
            data-categories={postCategories}
            class="post-item group grid gap-4 py-7 transition-colors hover:bg-accent-soft/40 sm:grid-cols-[110px_1fr_auto] sm:items-baseline"
          >
            <div class="font-mono text-[11px] uppercase tracking-[0.1em] text-muted">
              {formatDate(post.data.pubDate)}
              <br />
              <span class="whitespace-nowrap text-muted-light">
                {getReadTime(post.body || '')} · {formatWordCount(getWordCount(post.body || ''))} 字
              </span>
            </div>
            <div>
              <h2 class="font-serif text-xl font-semibold leading-snug text-ink transition-colors group-hover:text-accent">
                {post.data.title}
              </h2>
              <p class="mt-2 max-w-2xl text-[14px] leading-7 text-muted">
                {post.data.description}
              </p>
              {post.data.tags.length > 0 && (
                <div class="mt-3 flex flex-wrap gap-2">
                  {post.data.tags.slice(0, 4).map((tag) => <span class="tag">{tag}</span>)}
                </div>
              )}
            </div>
            <div class="hidden font-mono text-[11px] uppercase tracking-[0.1em] text-muted-light sm:block">
              {post.data.categories[0] || ''}
            </div>
          </a>
        );
      })}
    </div>

    <div id="no-results" class="hidden py-16 text-center">
      <p class="font-serif text-lg text-ink">没有匹配的笔记</p>
      <button
        id="clear-filter"
        type="button"
        class="mt-4 text-[13px] text-muted underline decoration-rule underline-offset-4 transition-colors hover:text-accent"
      >
        清除筛选
      </button>
    </div>

    {sortedPosts.length === 0 && (
      <p class="py-16 text-center text-sm text-muted">还没有笔记。</p>
    )}

    <div class="mt-10 flex flex-wrap items-center justify-between gap-2 border-t border-rule pt-4 font-mono text-[11px] uppercase tracking-[0.1em] text-muted-light">
      <span>edit / submit via github pr</span>
      <span>owner review before deploy</span>
    </div>
  </main>
</BaseLayout>

<script>
  const tagBtns = document.querySelectorAll<HTMLButtonElement>('.tag-filter-btn');
  const categoryBtns = document.querySelectorAll<HTMLButtonElement>('.category-filter-btn');
  const postItems = document.querySelectorAll<HTMLElement>('.post-item');
  const noResults = document.getElementById('no-results');
  const clearFilter = document.getElementById('clear-filter');
  const postCount = document.getElementById('post-count');
  let activeTag = 'all';
  let activeCategory = 'all';

  function syncUrl() {
    const url = new URL(location.href);
    if (activeTag === 'all') {
      url.searchParams.delete('tag');
    } else {
      url.searchParams.set('tag', activeTag);
    }
    if (activeCategory === 'all') {
      url.searchParams.delete('category');
    } else {
      url.searchParams.set('category', activeCategory);
    }
    history.replaceState(null, '', url);
  }

  function applyFilter() {
    let visibleCount = 0;
    postItems.forEach((item) => {
      const tags = (item.dataset.tags || '').split(',');
      const categories = (item.dataset.categories || '').split(',');
      const visible =
        (activeTag === 'all' || tags.includes(activeTag)) &&
        (activeCategory === 'all' || categories.includes(activeCategory));
      item.style.display = visible ? '' : 'none';
      if (visible) visibleCount++;
    });

    if (noResults) noResults.classList.toggle('hidden', visibleCount > 0);
    if (postCount) postCount.textContent = String(visibleCount);

    tagBtns.forEach((btn) => {
      btn.classList.toggle('is-active', (btn.dataset.tag || 'all') === activeTag);
    });
    categoryBtns.forEach((btn) => {
      btn.classList.toggle('is-active', (btn.dataset.category || 'all') === activeCategory);
    });

    syncUrl();
  }

  tagBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeTag = btn.dataset.tag || 'all';
      applyFilter();
    });
  });

  categoryBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeCategory = btn.dataset.category || 'all';
      applyFilter();
    });
  });

  clearFilter?.addEventListener('click', () => {
    activeTag = 'all';
    activeCategory = 'all';
    applyFilter();
  });

  const params = new URLSearchParams(location.search);
  const initialTag = params.get('tag');
  const initialCategory = params.get('category');
  if (initialTag && [...tagBtns].some((btn) => btn.dataset.tag === initialTag)) {
    activeTag = initialTag;
  }
  if (initialCategory && [...categoryBtns].some((btn) => btn.dataset.category === initialCategory)) {
    activeCategory = initialCategory;
  }
  applyFilter();
</script>

<style>
  .filter-btn {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: 5px 0;
    border: 0;
    border-bottom: 1px solid transparent;
    background: transparent;
    color: var(--muted);
    font-size: 13px;
    cursor: pointer;
    transition: color .2s, border-color .2s;
  }
  .filter-btn:hover { color: var(--ink); }
  .filter-btn.is-active {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }
  .filter-btn span {
    margin-left: 4px;
    color: var(--muted-light);
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .filter-btn.is-active span { color: var(--accent); }
</style>
