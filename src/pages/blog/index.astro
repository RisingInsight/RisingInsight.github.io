---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { formatDate, getReadTime } from '../../utils/blog';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const tagCounts: Record<string, number> = {};
for (const post of allPosts) {
  for (const tag of post.data.tags || []) {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  }
}
const allTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="笔记" description={`共 ${sortedPosts.length} 篇笔记`}>
  <main class="mx-auto max-w-4xl px-4 pb-24 pt-10 sm:px-6 lg:px-8">
    <Breadcrumb items={[{ label: '首页', href: '/' }, { label: '笔记' }]} />

    <header class="border-b border-rule pb-6">
      <div class="font-mono text-[9px] uppercase tracking-[0.16em] text-accent">Notes</div>
      <h1 class="mt-3 font-serif text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
        笔记
      </h1>
      <p class="mt-3 text-sm text-muted">
        共 <span id="post-count" class="text-ink">{sortedPosts.length}</span> 篇 · 按标签筛选
      </p>
    </header>

    <div class="flex flex-wrap gap-x-5 gap-y-2 border-b border-rule py-4" id="tag-filter">
      <button type="button" data-tag="all" class="filter-btn is-active">
        全部 <span>{sortedPosts.length}</span>
      </button>
      {allTags.map(([tag, count]) => (
        <button type="button" data-tag={tag} class="filter-btn">
          {tag} <span>{count}</span>
        </button>
      ))}
    </div>

    <div id="posts-grid" class="divide-y divide-rule">
      {sortedPosts.map((post) => {
        const postTags = (post.data.tags || []).join(',');
        return (
          <a
            href={`/blog/${post.id}/`}
            data-tags={postTags}
            class="post-item group grid gap-4 py-7 sm:grid-cols-[90px_1fr_auto] sm:items-baseline"
          >
            <div class="font-mono text-[9px] uppercase tracking-[0.1em] text-muted">
              {formatDate(post.data.pubDate)}
              <br />
              <span class="text-muted-light">{getReadTime(post.body || '')}</span>
            </div>
            <div>
              <h2 class="font-serif text-xl font-semibold leading-snug text-ink transition-colors group-hover:text-accent">
                {post.data.title}
              </h2>
              <p class="mt-2 max-w-2xl text-[13px] leading-7 text-muted">
                {post.data.description}
              </p>
              {post.data.tags.length > 0 && (
                <div class="mt-3 flex flex-wrap gap-2">
                  {post.data.tags.slice(0, 4).map((tag) => <span class="tag">{tag}</span>)}
                </div>
              )}
            </div>
            <div class="hidden font-mono text-[9px] uppercase tracking-[0.1em] text-muted-light sm:block">
              {post.data.categories[0] || ''}
            </div>
          </a>
        );
      })}
    </div>

    <div id="no-results" class="hidden py-16 text-center">
      <p class="font-serif text-lg text-ink">这个标签下还没有笔记</p>
      <button
        id="clear-filter"
        type="button"
        class="mt-4 text-[12px] text-muted underline decoration-rule underline-offset-4 transition-colors hover:text-accent"
      >
        查看全部
      </button>
    </div>

    {sortedPosts.length === 0 && (
      <p class="py-16 text-center text-sm text-muted">还没有笔记。</p>
    )}
  </main>
</BaseLayout>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const postItems = document.querySelectorAll<HTMLElement>('.post-item');
  const noResults = document.getElementById('no-results');
  const clearFilter = document.getElementById('clear-filter');
  const postCount = document.getElementById('post-count');
  let activeTag = 'all';

  function updateFilterButtons() {
    filterBtns.forEach((btn) => {
      btn.classList.toggle('is-active', (btn.dataset.tag || 'all') === activeTag);
    });
  }

  function filterPosts(tag: string) {
    activeTag = tag;
    let visibleCount = 0;
    postItems.forEach((item) => {
      const tags = (item.dataset.tags || '').split(',');
      const visible = tag === 'all' || tags.includes(tag);
      item.style.display = visible ? '' : 'none';
      if (visible) visibleCount++;
    });

    if (noResults) {
      noResults.classList.toggle('hidden', visibleCount > 0 || tag === 'all');
    }
    if (postCount) {
      postCount.textContent = tag === 'all' ? String(postItems.length) : String(visibleCount);
    }

    const url = new URL(location.href);
    if (tag === 'all') {
      url.searchParams.delete('tag');
    } else {
      url.searchParams.set('tag', tag);
    }
    history.replaceState(null, '', url);

    updateFilterButtons();
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => filterPosts(btn.dataset.tag || 'all'));
  });

  clearFilter?.addEventListener('click', () => filterPosts('all'));

  const initialTag = new URLSearchParams(location.search).get('tag');
  const hasInitialTag = initialTag && [...filterBtns].some((btn) => btn.dataset.tag === initialTag);
  if (hasInitialTag && initialTag) {
    filterPosts(initialTag);
  } else {
    updateFilterButtons();
  }
</script>

<style>
  .filter-btn {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: 5px 0;
    border: 0;
    border-bottom: 1px solid transparent;
    background: transparent;
    color: var(--muted);
    font-size: 12px;
    cursor: pointer;
    transition: color .2s, border-color .2s;
  }
  .filter-btn:hover { color: var(--ink); }
  .filter-btn.is-active {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }
  .filter-btn span {
    margin-left: 4px;
    color: var(--muted-light);
    font-family: var(--font-mono);
    font-size: 9px;
  }
  .filter-btn.is-active span { color: var(--accent); }
</style>
