---
import BaseLayout from '../layouts/BaseLayout.astro';
import Heatmap from '../components/Heatmap.astro';
import {
  SITE_TITLE,
  SITE_DESCRIPTION,
  PROFILE,
  SOCIALS,
  GITHUB_USERNAME,
} from '../consts';
import { getCollection } from 'astro:content';
import {
  formatDate,
  formatWordCount,
  getReadTime,
  getSeriesGroups,
  getWordCount,
} from '../utils/blog';
import { getCommitActivity } from '../utils/git';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const tagCounts: Record<string, number> = {};
let totalWords = 0;
for (const post of allPosts) {
  totalWords += getWordCount(post.body || '');
  for (const tag of post.data.tags || []) tagCounts[tag] = (tagCounts[tag] || 0) + 1;
}
const tags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
const seriesGroups = getSeriesGroups(allPosts);
const activity = getCommitActivity();
const lastCommitLabel = activity.lastCommit ? activity.lastCommit.replace(/-/g, '.') : '—';

const BLOG_START_DATE = '2026-01-01';
const runDays = Math.max(
  0,
  Math.floor((Date.now() - new Date(BLOG_START_DATE).getTime()) / (1000 * 60 * 60 * 24))
);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <main>
    <section class="relative overflow-hidden border-b border-rule">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-7xl px-4 pb-6 pt-16 sm:px-6 lg:px-8 lg:pb-8 lg:pt-24">
        <div class="grid items-center gap-12 lg:grid-cols-[1.04fr_.96fr]">
          <div>
            <div class="flex flex-wrap items-center gap-3 font-mono text-[11px] uppercase tracking-[0.18em] text-muted-light">
              <span class="status-dot"></span>
              <span>build log</span>
              <span class="text-rule">/</span>
              <span>2026</span>
              <span class="hidden items-center gap-2 sm:flex">
                <span class="text-rule">/</span>
                <span class="text-accent">learning in public</span>
              </span>
            </div>

            <h1 class="mt-6 font-serif text-[2.9rem] font-semibold leading-[.98] tracking-[-0.06em] text-ink sm:text-6xl lg:text-[4.6rem]">
              Build<span class="text-accent">.</span> Break<span class="text-accent">.</span><br />
              Document<span class="text-accent">.</span>
            </h1>
            <p class="mt-5 max-w-xl font-serif text-xl leading-snug tracking-[-0.02em] text-ink-soft sm:text-2xl">
              把想法跑起来，再把过程写下来。
            </p>
            <p class="mt-4 max-w-xl text-[14px] leading-7 text-muted">
              这里记录生成模型、深度学习与工程实践：从推导、实验，到真正能跑起来的代码。
              <span class="text-muted-light">Just broaden my horizons.</span>
            </p>

            <div class="mt-7 flex flex-wrap items-center gap-3">
              <a href="/blog/" class="btn btn-primary">
                阅读笔记 <span aria-hidden="true">→</span>
              </a>
              <a
                href={`https://github.com/${GITHUB_USERNAME}`}
                target="_blank"
                rel="noopener noreferrer"
                class="font-mono text-[12px] uppercase tracking-[0.08em] text-muted transition-colors hover:text-accent"
              >
                github ↗
              </a>
            </div>

            <div class="mt-8 flex flex-wrap gap-x-5 gap-y-2 font-mono text-[11px] uppercase tracking-[0.08em] text-muted-light">
              {SOCIALS.map((social) => (
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="transition-colors hover:text-accent"
                >
                  {social.name} <span aria-hidden="true">↗</span>
                </a>
              ))}
              <span class="flex items-center gap-2">
                <span class="status-dot"></span>
                {PROFILE.location}
              </span>
            </div>
          </div>

          <div class="terminal-window reveal" data-terminal>
            <div class="terminal-bar">
              <span class="terminal-dot"></span>
              <span class="terminal-dot"></span>
              <span class="terminal-dot"></span>
              <span class="ml-2 font-mono text-[11px] tracking-[0.08em] term-muted">
                risinginsight@blog: ~
              </span>
              <span class="ml-auto font-mono text-[11px] uppercase tracking-[0.12em] term-muted">
                zsh
              </span>
            </div>

            <div
              class="min-h-[400px] whitespace-pre-wrap p-4 font-mono text-[12px] leading-6 sm:p-5"
              data-terminal-type
              aria-hidden="true"
            >
              <span data-terminal-typed>
                <div><span class="terminal-prompt">$</span> <span class="term-fg">whoami</span></div>
                <div class="term-accent">{PROFILE.name}</div>
                <div class="term-muted">{PROFILE.role} · {PROFILE.location}</div>
                <div class="mt-2"><span class="terminal-prompt">$</span> <span class="term-fg">cat profile.json</span></div>
                <div class="term-muted">{'{'}</div>
                <div class="pl-3"><span class="term-key">"focus"</span>: <span class="term-str">"generative systems"</span>,</div>
                <div class="pl-3"><span class="term-key">"mode"</span>: <span class="term-str">"build in public"</span>,</div>
                <div class="pl-3"><span class="term-key">"status"</span>: <span class="term-accent">"online"</span></div>
                <div class="term-muted">{'}'}</div>
                <div class="mt-2"><span class="terminal-prompt">$</span> <span class="term-fg">uptime</span></div>
                <div class="term-fg">{runDays} days · {allPosts.length} posts · {formatWordCount(totalWords)} words</div>
                <div class="mt-2"><span class="terminal-prompt">$</span> <span class="term-fg">git log --oneline | wc -l</span></div>
                <div class="term-fg">{activity.totalAll} commits · streak {activity.currentStreak}d · last {lastCommitLabel}</div>
                <div class="mt-2"><span class="terminal-prompt">$</span> <span class="term-fg">ls -t posts | head -3</span></div>
                {latestPosts.slice(0, 3).map((post) => (
                  <div class="term-accent">→ {post.data.title}</div>
                ))}
              </span><span class="cursor-blink"></span>
            </div>

            <div class="terminal-foot flex items-center justify-between px-4 py-2 font-mono text-[11px] uppercase tracking-[0.12em] term-muted">
              <span>UTF-8 · LF · git:(main)</span>
              <span class="term-accent">● connected</span>
            </div>
          </div>
        </div>

        <div class="mt-12 grid grid-cols-2 border border-rule bg-surface/40 sm:grid-cols-4">
          <div class="border-b border-r border-rule px-4 py-4 sm:border-b-0">
            <div class="mono-label">uptime</div>
            <div class="mt-2 font-serif text-2xl tracking-[-0.03em] text-ink">
              <span data-uptime-days>{runDays}</span><span class="ml-0.5 text-sm text-muted">d</span>
            </div>
          </div>
          <div class="border-b border-rule px-4 py-4 sm:border-b-0 sm:border-r">
            <div class="mono-label">posts</div>
            <div class="mt-2 font-serif text-2xl tracking-[-0.03em] text-ink">{allPosts.length}</div>
          </div>
          <div class="border-r border-rule px-4 py-4">
            <div class="mono-label">words</div>
            <div class="mt-2 font-serif text-2xl tracking-[-0.03em] text-ink">{formatWordCount(totalWords)}</div>
          </div>
          <div class="px-4 py-4">
            <div class="mono-label">commits</div>
            <div class="mt-2 font-serif text-2xl tracking-[-0.03em] text-accent">{activity.totalAll}</div>
          </div>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-2 border border-t-0 border-rule bg-paper-alt/30 px-4 py-2.5 font-mono text-[11px] uppercase tracking-[0.1em] text-muted-light">
          <span class="flex flex-wrap items-center gap-x-3 gap-y-1">
            <span>traffic</span>
            <span class="text-muted"><span id="busuanzi_value_site_pv">--</span> views</span>
            <span class="text-muted"><span id="busuanzi_value_site_uv">--</span> visitors</span>
          </span>
          <span>busuanzi / live</span>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 pb-12 pt-8 sm:px-6 lg:px-8 lg:pb-16 lg:pt-10">
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_300px]">
        <div class="min-w-0 space-y-10">
          <Heatmap activity={activity} />

          <section aria-labelledby="latest-heading" class="reveal">
            <div class="flex flex-wrap items-end justify-between gap-3 border-b border-rule pb-4">
              <div>
                <div class="mono-label text-accent">latest.log</div>
                <h2 id="latest-heading" class="mt-2 font-serif text-2xl font-semibold tracking-[-0.03em] text-ink sm:text-3xl">
                  最近更新
                </h2>
              </div>
              <a href="/blog/" class="font-mono text-[12px] uppercase tracking-[0.1em] text-muted transition-colors hover:text-accent">
                all posts <span aria-hidden="true">→</span>
              </a>
            </div>

            <div class="divide-y divide-rule">
              {latestPosts.map((post, index) => (
                <a
                  href={`/blog/${post.id}/`}
                  class="log-row group grid gap-4 py-6 sm:grid-cols-[74px_minmax(0,1fr)_auto] sm:items-start"
                >
                  <div class="font-mono text-[11px] uppercase leading-5 tracking-[0.1em] text-muted-light">
                    <span class="text-accent">{String(index + 1).padStart(2, '0')}</span>
                    <br />
                    {formatDate(post.data.pubDate)}
                  </div>
                  <div class="min-w-0">
                    <div class="flex flex-wrap items-center gap-2">
                      {post.data.featured && (
                        <span class="border border-accent/40 bg-accent-soft px-1.5 py-0.5 font-mono text-[11px] uppercase tracking-[0.1em] text-accent">
                          pinned
                        </span>
                      )}
                      <h3 class="font-serif text-xl font-semibold leading-snug tracking-[-0.02em] text-ink transition-colors group-hover:text-accent">
                        {post.data.title}
                      </h3>
                    </div>
                    <p class="mt-2 max-w-2xl text-[14px] leading-7 text-muted">{post.data.description}</p>
                    <div class="mt-3 flex flex-wrap items-center gap-2">
                      {post.data.tags.slice(0, 4).map((tag) => <span class="tag">{tag}</span>)}
                      <span class="font-mono text-[11px] text-muted-light">
                        {getReadTime(post.body || '')} · {formatWordCount(getWordCount(post.body || ''))} 字
                      </span>
                    </div>
                  </div>
                  <div class="hidden items-center gap-2 pt-1 font-mono text-[11px] uppercase tracking-[0.1em] text-muted-light sm:flex">
                    {post.data.categories[0] || 'note'}
                    <span aria-hidden="true" class="transition-transform group-hover:translate-x-1 group-hover:text-accent">→</span>
                  </div>
                </a>
              ))}
            </div>
          </section>

          <a href="/guestbook/" class="panel panel-link group flex items-center justify-between gap-6 p-5 sm:p-6 reveal">
            <div>
              <div class="mono-label text-accent">guestbook.open()</div>
              <div class="mt-2 font-serif text-xl font-semibold tracking-[-0.02em] text-ink transition-colors group-hover:text-accent">
                留下一条记录
              </div>
              <p class="mt-1 text-[13px] leading-6 text-muted">
                登录 GitHub 后留言，聊聊技术、项目或任何你想说的事。
              </p>
            </div>
            <span class="font-mono text-2xl text-accent transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
          </a>
        </div>

        <aside class="space-y-8">
          <section class="panel p-5 reveal">
            <div class="flex items-center justify-between">
              <span class="mono-label">operator</span>
              <span class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.1em] text-accent">
                <span class="status-dot"></span> online
              </span>
            </div>
            <div class="mt-5 flex items-center gap-3.5">
              <span class="relative">
                <img
                  src={PROFILE.avatar}
                  alt={PROFILE.name}
                  width="460"
                  height="460"
                  class="h-16 w-16 rounded-full border border-rule object-cover"
                />
                <span class="absolute bottom-0.5 right-0.5 h-3 w-3 rounded-full border-2 border-surface bg-accent"></span>
              </span>
              <div class="min-w-0">
                <div class="font-serif text-lg font-semibold leading-tight tracking-[-0.02em] text-ink">{PROFILE.name}</div>
                <div class="mt-1 font-mono text-[11px] uppercase tracking-[0.12em] text-muted">{PROFILE.role}</div>
              </div>
            </div>
            <p class="mt-4 text-[13px] leading-6 text-muted">{PROFILE.bio}</p>
            <p class="mt-1 text-[12px] leading-5 text-muted-light">{PROFILE.tagline}</p>
            <div class="mt-4 grid grid-cols-2 gap-2 border-t border-rule-soft pt-4 font-mono text-[11px] uppercase tracking-[0.06em]">
              <div>
                <div class="text-muted-light">last commit</div>
                <div class="mt-1 text-ink">{lastCommitLabel}</div>
              </div>
              <div>
                <div class="text-muted-light">streak</div>
                <div class="mt-1 text-accent">{activity.currentStreak} days</div>
              </div>
            </div>
            <div class="mt-4 flex flex-wrap gap-x-3.5 gap-y-1.5 text-[12px] text-muted">
              {SOCIALS.map((social) => (
                <a href={social.href} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-accent">
                  {social.name} <span aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          </section>

          {seriesGroups.length > 0 && (
            <section class="reveal">
              <div class="flex items-baseline justify-between border-b border-rule pb-2.5">
                <h2 class="mono-label">series</h2>
                <a href="/series/" class="font-mono text-[11px] uppercase tracking-[0.08em] text-muted-light transition-colors hover:text-accent">
                  all <span aria-hidden="true">→</span>
                </a>
              </div>
              <ul class="mt-3 space-y-2.5">
                {seriesGroups.map((group) => (
                  <li>
                    <a href={`/series/#series-${group.slug}`} class="group flex items-baseline justify-between gap-3">
                      <span class="text-[14px] leading-5 text-ink transition-colors group-hover:text-accent">{group.name}</span>
                      <span class="font-mono text-[11px] text-muted-light">{group.posts.length}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}

          <section class="reveal">
            <div class="flex items-baseline justify-between border-b border-rule pb-2.5">
              <h2 class="mono-label">tags</h2>
              <span class="font-mono text-[11px] text-muted-light">{tags.length}</span>
            </div>
            <div class="mt-3 flex flex-wrap gap-1.5">
              {tags.map(([tag, count]) => (
                <a href={`/blog/?tag=${encodeURIComponent(tag)}`} class="tag">
                  {tag} <span class="font-mono text-[11px] text-muted-light">{count}</span>
                </a>
              ))}
            </div>
          </section>
        </aside>
      </div>
    </section>
  </main>

  <script define:vars={{ BLOG_START_DATE, POST_COUNT: allPosts.length, WORD_COUNT_LABEL: formatWordCount(totalWords), COMMITS: activity.totalAll, STREAK_DAYS: activity.currentStreak, LAST_COMMIT: lastCommitLabel, POST_TITLES: latestPosts.slice(0, 3).map((post) => post.data.title) }}>
    const runDaysEls = document.querySelectorAll('[data-uptime-days]');
    const uptimeDays = Math.max(
      0,
      Math.floor((Date.now() - new Date(BLOG_START_DATE).getTime()) / (1000 * 60 * 60 * 24))
    );
    runDaysEls.forEach((el) => { el.textContent = String(uptimeDays); });

    const terminal = document.querySelector('[data-terminal]');
    const typedEl = document.querySelector('[data-terminal-typed]');
    const typeBody = document.querySelector('[data-terminal-type]');
    if (terminal && typedEl && typeBody) {
      const escapeHtml = (value) => String(value).replace(/[&<>"']/g, (ch) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      }[ch]));

      const NL = String.fromCharCode(10);
      const segments = [
        ['$', 'term-accent'], [' whoami' + NL, 'term-fg'],
        ['RisingInsight' + NL, 'term-accent'],
        ['Deep Learning · China' + NL, 'term-muted'],
        ['$', 'term-accent'], [' cat profile.json' + NL, 'term-fg'],
        ['{' + NL, 'term-muted'],
        ['  "focus"', 'term-key'], [': ', 'term-muted'], ['"generative systems"', 'term-str'], [',' + NL, 'term-muted'],
        ['  "mode"', 'term-key'], [': ', 'term-muted'], ['"build in public"', 'term-str'], [',' + NL, 'term-muted'],
        ['  "status"', 'term-key'], [': ', 'term-muted'], ['"online"', 'term-accent'], [NL, 'term-muted'],
        ['}' + NL, 'term-muted'],
        ['$', 'term-accent'], [' uptime' + NL, 'term-fg'],
        [`${uptimeDays} days`, 'term-fg'], [' · ', 'term-muted'], [`${POST_COUNT} posts`, 'term-fg'], [' · ', 'term-muted'], [`${WORD_COUNT_LABEL} words`, 'term-fg'], [NL, 'term-muted'],
        ['$', 'term-accent'], [' git log --oneline | wc -l' + NL, 'term-fg'],
        [`${COMMITS} commits`, 'term-fg'], [' · ', 'term-muted'], [`streak ${STREAK_DAYS}d`, 'term-fg'], [' · ', 'term-muted'], [`last ${LAST_COMMIT}`, 'term-fg'], [NL, 'term-muted'],
        ['$', 'term-accent'], [' ls -t posts | head -3' + NL, 'term-fg'],
        ...POST_TITLES.map((title, i) => [`→ ${title}${i < POST_TITLES.length - 1 ? NL : ''}`, i === 0 ? 'term-accent' : 'term-fg']),
      ];
      const totalLength = segments.reduce((sum, [text]) => sum + text.length, 0);
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const SPEED = 14;
      const HOLD = 3800;
      const RESUME_DELAY = 1200;
      let index = 0;
      let state = 'typing';
      let tickTimer = 0;
      let holdTimer = 0;
      let fadeTimer = 0;
      let rendered = -1;

      function render(count) {
        if (count === rendered) return;
        rendered = count;
        let used = 0;
        let html = '';
        for (const [text, cls] of segments) {
          if (used >= count) break;
          const take = Math.min(text.length, count - used);
          if (take > 0) html += `<span class="${cls}">${escapeHtml(text.slice(0, take))}</span>`;
          used += take;
        }
        typedEl.innerHTML = html;
      }

      function clearAndType() {
        index = 0;
        render(0);
        state = 'typing';
        typeBody.classList.add('is-fading');
        fadeTimer = window.setTimeout(() => {
          typeBody.classList.remove('is-fading');
          tickTimer = window.setTimeout(tick, SPEED);
        }, 220);
      }

      function tick() {
        if (state !== 'typing') return;
        index = Math.min(totalLength, index + 1);
        render(index);
        if (index >= totalLength) {
          state = 'hold';
          holdTimer = window.setTimeout(() => {
            if (state === 'hold') clearAndType();
          }, HOLD);
        } else {
          tickTimer = window.setTimeout(tick, SPEED);
        }
      }

      function pauseAndShowFull() {
        if (state === 'paused') return;
        window.clearTimeout(tickTimer);
        window.clearTimeout(holdTimer);
        window.clearTimeout(fadeTimer);
        state = 'paused';
        render(totalLength);
      }

      function resumeLoop() {
        if (state !== 'paused') return;
        state = 'hold';
        holdTimer = window.setTimeout(() => {
          if (state === 'hold') clearAndType();
        }, RESUME_DELAY);
      }

      terminal.addEventListener('mouseenter', pauseAndShowFull);
      terminal.addEventListener('mouseleave', resumeLoop);

      if (reduced) {
        state = 'hold';
        render(totalLength);
      } else {
        render(0);
        window.setTimeout(tick, 700);
      }
    }
  </script>
</BaseLayout>

<style>
  .hero-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(700px circle at 15% 30%, var(--glow-a), transparent 55%),
      radial-gradient(500px circle at 85% 15%, var(--glow-b), transparent 55%);
  }

  .hero-glow::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(var(--accent-rgb), .04) 1px, transparent 1px);
    background-size: 100% 4px;
    mask-image: linear-gradient(to bottom, black, transparent 80%);
    opacity: .35;
  }

  .terminal-prompt {
    color: var(--term-accent);
  }

  [data-terminal-type] {
    transition: opacity .2s ease;
  }

  [data-terminal-type].is-fading {
    opacity: .18;
  }

  .log-row {
    position: relative;
    transition: background .2s, padding-left .2s;
  }

  .log-row:hover {
    background: var(--accent-soft);
  }

  .log-row::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: -16px;
    width: 1px;
    background: var(--accent);
    opacity: 0;
    transition: opacity .2s;
  }

  .log-row:hover::before {
    opacity: 1;
  }

  @media (max-width: 640px) {
    .log-row::before {
      left: -12px;
    }
  }
</style>
