---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE, SITE_DESCRIPTION, PROFILE, SOCIALS } from '../consts';
import { getCollection } from 'astro:content';
import { formatDate, getReadTime } from '../utils/blog';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const tagCounts: Record<string, number> = {};
const categoryCounts: Record<string, number> = {};
for (const post of allPosts) {
  for (const tag of post.data.tags || []) tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  for (const category of post.data.categories || []) {
    categoryCounts[category] = (categoryCounts[category] || 0) + 1;
  }
}
const tags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
const categories = Object.entries(categoryCounts).sort((a, b) => b[1] - a[1]);

const featuredPost = sortedPosts.find((post) => post.data.featured) ?? null;
const indexPosts = featuredPost
  ? sortedPosts.filter((post) => post.id !== featuredPost.id)
  : sortedPosts;

const BLOG_START_DATE = '2026-01-01';
const runDays = Math.max(
  0,
  Math.floor((Date.now() - new Date(BLOG_START_DATE).getTime()) / (1000 * 60 * 60 * 24))
);

---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <main>
    <section class="border-b border-rule">
      <div class="mx-auto grid max-w-6xl gap-16 px-4 py-16 sm:px-6 lg:grid-cols-[1.35fr_.65fr] lg:items-center lg:px-8 lg:py-24">
        <div>
          <div class="mb-10 flex items-center gap-3">
            <img
              src={PROFILE.avatar}
              alt={PROFILE.name}
              class="h-10 w-10 rounded-full border border-rule object-cover"
            />
            <div>
              <div class="text-sm font-medium text-ink">{PROFILE.name}</div>
              <div class="mt-0.5 font-mono text-[9px] uppercase tracking-[0.16em] text-muted">
                {PROFILE.role} · {PROFILE.location}
              </div>
            </div>
          </div>

          <div class="font-mono text-[10px] uppercase tracking-[0.2em] text-accent">
            Research notes · 2026
          </div>
          <h1 class="mt-4 font-serif text-4xl font-semibold leading-[1.12] tracking-[-0.02em] text-ink sm:text-5xl lg:text-6xl">
            生成模型笔记
          </h1>
          <p class="mt-3 font-serif text-lg text-muted">Notes on generative models</p>
          <p class="mt-6 max-w-xl text-[15px] leading-8 text-muted">
            记录扩散模型、图像模态转换与多模态生成的推导和实验。<br />
            Just broaden my horizons.
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-x-3 gap-y-2 text-[11px] text-muted">
            <span class="font-mono text-[9px] uppercase tracking-[0.16em] text-muted-light">Now</span>
            <span>{sortedPosts.length} 篇笔记</span>
            <span class="text-rule">/</span>
            <span>{categories.length} 个分类</span>
            <span class="text-rule">/</span>
            <span>{tags.length} 个标签</span>
            <span class="text-rule">/</span>
            <span>运行 {runDays} 天</span>
          </div>

          <div class="mt-8 flex flex-wrap gap-x-5 gap-y-2 text-[12px] text-muted">
            {SOCIALS.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="underline decoration-rule underline-offset-4 transition-colors hover:text-accent hover:decoration-accent"
              >
                {social.name} <span aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </div>

        <div class="relative hidden flex-col items-center gap-6 lg:flex">
          <div class="relative h-60 w-60">
            <div class="absolute inset-0 rounded-full border border-rule"></div>
            <div class="absolute inset-12 rounded-full border border-dashed border-rule"></div>
            <div class="absolute inset-24 rounded-full border border-accent/30"></div>
            <div class="absolute left-[22%] top-[18%] h-1.5 w-1.5 rounded-full bg-accent"></div>
            <div class="absolute bottom-[16%] right-[18%] h-1 w-1 rounded-full bg-muted-light"></div>
          </div>
          <div class="text-center font-mono text-[9px] uppercase tracking-[0.2em] text-muted-light">
            Diffusion / Image-to-Image
          </div>
        </div>
      </div>
    </section>

    {featuredPost && (
      <section class="mx-auto max-w-6xl px-4 pb-16 pt-14 sm:px-6 lg:px-8">
        <div class="flex items-baseline justify-between border-b border-rule pb-4">
          <h2 class="font-serif text-2xl font-semibold tracking-tight text-ink">精选笔记</h2>
          <span class="font-mono text-[9px] uppercase tracking-[0.16em] text-muted-light">Selected note</span>
        </div>

        <a
          href={`/blog/${featuredPost.id}/`}
          class="group mt-8 grid gap-6 md:grid-cols-[64px_1fr_auto] md:items-start"
        >
          <div class="font-serif text-4xl leading-none text-accent/70">01</div>
          <div>
            <div class="font-mono text-[9px] uppercase tracking-[0.14em] text-muted">
              {formatDate(featuredPost.data.pubDate)} · {getReadTime(featuredPost.body || '')}
              {featuredPost.data.categories.length > 0 && ` · ${featuredPost.data.categories.join(' / ')}`}
            </div>
            <h3 class="mt-3 font-serif text-2xl font-semibold leading-snug text-ink transition-colors group-hover:text-accent">
              {featuredPost.data.title}
            </h3>
            <p class="mt-3 max-w-2xl text-sm leading-7 text-muted">
              {featuredPost.data.description}
            </p>
            {featuredPost.data.tags.length > 0 && (
              <div class="mt-4 flex flex-wrap gap-2">
                {featuredPost.data.tags.slice(0, 4).map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            )}
          </div>
          <div class="hidden items-center gap-2 pt-1 text-[12px] text-muted transition-colors group-hover:text-accent md:flex">
            阅读笔记 <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
          </div>
        </a>
      </section>
    )}

    <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6 lg:px-8">
      <div class="flex items-baseline justify-between border-b border-rule pb-4">
        <h2 class="font-serif text-2xl font-semibold tracking-tight text-ink">
          {featuredPost ? '更多笔记' : '笔记索引'}
        </h2>
        <a href="/blog/" class="text-[12px] text-muted transition-colors hover:text-accent">
          全部笔记 <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="divide-y divide-rule">
        {indexPosts.map((post) => (
          <a
            href={`/blog/${post.id}/`}
            class="group grid gap-4 py-7 sm:grid-cols-[90px_1fr_auto] sm:items-baseline"
          >
            <div class="font-mono text-[9px] uppercase tracking-[0.1em] text-muted">
              {formatDate(post.data.pubDate)}
              <br />
              <span class="text-muted-light">{getReadTime(post.body || '')}</span>
            </div>
            <div>
              <h3 class="font-serif text-lg font-semibold leading-snug text-ink transition-colors group-hover:text-accent">
                {post.data.title}
              </h3>
              <p class="mt-1.5 max-w-2xl text-[13px] leading-7 text-muted">
                {post.data.description}
              </p>
              {post.data.tags.length > 0 && (
                <div class="mt-3 flex flex-wrap gap-2">
                  {post.data.tags.slice(0, 4).map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              )}
            </div>
            <div class="hidden font-mono text-[9px] uppercase tracking-[0.1em] text-muted-light sm:block">
              {post.data.categories[0] || ''}
            </div>
          </a>
        ))}
        {indexPosts.length === 0 && (
          <p class="py-10 text-sm text-muted">更多笔记正在整理中。</p>
        )}
      </div>
    </section>

    <section class="border-t border-rule">
      <div class="mx-auto grid max-w-6xl gap-12 px-4 py-12 sm:px-6 md:grid-cols-2 lg:px-8">
        <div>
          <div class="font-mono text-[9px] uppercase tracking-[0.16em] text-muted-light">Categories</div>
          <div class="mt-4">
            {categories.map(([category, count]) => (
              <div class="flex items-baseline justify-between border-b border-rule-soft py-2.5 text-sm">
                <span class="text-ink">{category}</span>
                <span class="font-mono text-[10px] text-muted-light">{count}</span>
              </div>
            ))}
          </div>
        </div>
        <div>
          <div class="font-mono text-[9px] uppercase tracking-[0.16em] text-muted-light">Tags</div>
          <div class="mt-4 flex flex-wrap gap-2">
            {tags.map(([tag, count]) => (
              <a href={`/blog/?tag=${encodeURIComponent(tag)}`} class="tag">
                {tag} <span class="font-mono text-[9px] text-muted-light">{count}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
