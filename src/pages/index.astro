---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE, SITE_DESCRIPTION, PROFILE, SOCIALS } from '../consts';
import { getCollection } from 'astro:content';
import {
  formatDate,
  formatWordCount,
  getReadTime,
  getSeriesGroups,
  getWordCount,
} from '../utils/blog';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const tagCounts: Record<string, number> = {};
const categoryCounts: Record<string, number> = {};
let totalWords = 0;
for (const post of allPosts) {
  totalWords += getWordCount(post.body || '');
  for (const tag of post.data.tags || []) tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  for (const category of post.data.categories || []) {
    categoryCounts[category] = (categoryCounts[category] || 0) + 1;
  }
}
const tags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
const categories = Object.entries(categoryCounts).sort((a, b) => b[1] - a[1]);
const seriesGroups = getSeriesGroups(allPosts);

const featuredPost = sortedPosts.find((post) => post.data.featured) ?? null;
const indexPosts = featuredPost
  ? sortedPosts.filter((post) => post.id !== featuredPost.id)
  : sortedPosts;

const BLOG_START_DATE = '2026-01-01';
const runDays = Math.max(
  0,
  Math.floor((Date.now() - new Date(BLOG_START_DATE).getTime()) / (1000 * 60 * 60 * 24))
);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <main>
    <section class="mx-auto max-w-6xl px-4 pt-6 sm:px-6 sm:pt-8 lg:px-8">
      <div class="relative overflow-hidden border border-rule bg-ink">
        <img
          src="/demo/home-banner.webp"
          alt=""
          width="1592"
          height="520"
          fetchpriority="high"
          class="h-44 w-full object-cover object-[center_42%] sm:h-56 lg:h-64"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-[#0d1114]/85 via-[#0d1114]/45 to-[#0d1114]/10"></div>
        <div class="absolute inset-0 flex flex-col justify-between p-5 sm:p-7 lg:p-8">
          <div class="flex items-center justify-between font-mono text-[9px] uppercase tracking-[0.2em] text-white/65">
            <span>RisingInsight / Research notes</span>
            <span class="hidden sm:inline">Vol. 01 · 2026</span>
          </div>
          <div>
            <h1 class="font-serif text-3xl font-semibold leading-tight tracking-[-0.02em] text-white sm:text-4xl lg:text-[2.75rem]">
              生成模型笔记
            </h1>
            <p class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] leading-6 text-white/70">
              <span>Notes on generative models</span>
              <span aria-hidden="true" class="text-white/35">/</span>
              <span>扩散模型 · 图像模态转换 · 多模态生成</span>
            </p>
          </div>
        </div>
      </div>
    </section>

    <div class="mx-auto grid max-w-6xl gap-12 px-4 py-10 sm:px-6 lg:grid-cols-[17rem_minmax(0,1fr)] lg:gap-12 lg:px-8 lg:py-14">
      <div class="min-w-0 lg:order-2">
        <div class="flex items-baseline justify-between border-b border-rule pb-4">
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <h2 class="font-serif text-2xl font-semibold tracking-tight text-ink">笔记索引</h2>
            <span class="font-mono text-[9px] uppercase tracking-[0.16em] text-muted-light">
              Notes · {sortedPosts.length}
            </span>
          </div>
          <a href="/blog/" class="text-[12px] text-muted transition-colors hover:text-accent">
            全部笔记 <span aria-hidden="true">→</span>
          </a>
        </div>

        {featuredPost && (
          <a
            href={`/blog/${featuredPost.id}/`}
            class="group relative mt-6 block border border-rule bg-surface p-5 transition-colors hover:border-muted-light sm:p-7"
          >
            <span aria-hidden="true" class="absolute inset-y-0 left-0 w-[2px] bg-accent"></span>
            <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 font-mono text-[9px] uppercase tracking-[0.14em] text-muted">
              <span class="text-accent">Selected note · 01</span>
              <span>
                {formatDate(featuredPost.data.pubDate)} · {getReadTime(featuredPost.body || '')} · {formatWordCount(
                  getWordCount(featuredPost.body || '')
                )} 字
              </span>
            </div>
            <h3 class="mt-4 font-serif text-2xl font-semibold leading-snug text-ink transition-colors group-hover:text-accent sm:text-3xl">
              {featuredPost.data.title}
            </h3>
            <p class="mt-3 max-w-2xl text-[13px] leading-7 text-muted">
              {featuredPost.data.description}
            </p>
            <div class="mt-5 flex flex-wrap items-center gap-2">
              {featuredPost.data.categories.map((category) => (
                <span class="font-mono text-[9px] uppercase tracking-[0.12em] text-muted-light">
                  {category}
                </span>
              ))}
              {featuredPost.data.tags.slice(0, 4).map((tag) => (
                <span class="tag">{tag}</span>
              ))}
              <span class="mt-2 inline-flex w-full items-center gap-2 text-[12px] text-muted transition-colors group-hover:text-accent sm:ml-auto sm:mt-0 sm:w-auto">
                阅读笔记
                <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
              </span>
            </div>
          </a>
        )}

        <div class="mt-8 flex items-baseline justify-between border-b border-rule pb-3">
          <h2 class="font-serif text-lg font-semibold tracking-tight text-ink">
            {featuredPost ? '更多笔记' : '笔记'}
          </h2>
          <span class="font-mono text-[9px] uppercase tracking-[0.14em] text-muted-light">Recently</span>
        </div>

        <div class="divide-y divide-rule">
          {indexPosts.map((post) => (
            <a
              href={`/blog/${post.id}/`}
              class="group grid gap-3 py-6 sm:grid-cols-[1fr_auto] sm:items-start sm:gap-6"
            >
              <div class="min-w-0">
                <div class="font-mono text-[9px] uppercase tracking-[0.1em] text-muted-light">
                  {formatDate(post.data.pubDate)} · {getReadTime(post.body || '')} · {formatWordCount(
                    getWordCount(post.body || '')
                  )} 字
                </div>
                <h3 class="mt-2 font-serif text-xl font-semibold leading-snug text-ink transition-colors group-hover:text-accent">
                  {post.data.title}
                </h3>
                <p class="mt-1.5 max-w-2xl text-[13px] leading-7 text-muted">
                  {post.data.description}
                </p>
                {post.data.tags.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-2">
                    {post.data.tags.slice(0, 4).map((tag) => <span class="tag">{tag}</span>)}
                  </div>
                )}
              </div>
              <div class="hidden text-right font-mono text-[9px] uppercase leading-5 tracking-[0.1em] text-muted-light sm:block">
                {post.data.categories[0] || ''}
                <br />
                <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
              </div>
            </a>
          ))}
          {indexPosts.length === 0 && (
            <p class="py-10 text-sm text-muted">更多笔记正在整理中。</p>
          )}
        </div>
      </div>

      <aside class="min-w-0 space-y-8 lg:order-1">
        <section class="border border-rule bg-surface p-5">
          <div class="flex items-center gap-3.5">
            <img
              src={PROFILE.avatar}
              alt={PROFILE.name}
              width="460"
              height="460"
              class="h-14 w-14 rounded-full border border-rule object-cover"
            />
            <div class="min-w-0">
              <div class="font-serif text-lg font-semibold leading-tight text-ink">{PROFILE.name}</div>
              <div class="mt-1 font-mono text-[9px] uppercase tracking-[0.14em] text-muted">
                {PROFILE.role} · {PROFILE.location}
              </div>
            </div>
          </div>
          <p class="mt-4 text-[12px] leading-6 text-muted">{PROFILE.bio}</p>
          <p class="mt-1 text-[11px] leading-5 text-muted-light">{PROFILE.tagline}</p>
          <div class="mt-4 flex flex-wrap gap-x-3.5 gap-y-1.5 border-t border-rule-soft pt-3 text-[11px]">
            {SOCIALS.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-muted transition-colors hover:text-accent"
              >
                {social.name} <span aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </section>

        <section class="border border-rule bg-paper-alt/40">
          <div class="grid grid-cols-2">
            <div class="border-b border-r border-rule px-4 py-3.5">
              <div class="font-serif text-[22px] leading-none text-ink">{allPosts.length}</div>
              <div class="mt-1 font-mono text-[8px] uppercase tracking-[0.16em] text-muted-light">Notes</div>
            </div>
            <div class="border-b border-rule px-4 py-3.5">
              <div class="font-serif text-[22px] leading-none text-ink">{formatWordCount(totalWords)}</div>
              <div class="mt-1 font-mono text-[8px] uppercase tracking-[0.16em] text-muted-light">Words</div>
            </div>
            <div class="border-r border-rule px-4 py-3.5">
              <div class="font-serif text-[22px] leading-none text-ink">{categories.length}</div>
              <div class="mt-1 font-mono text-[8px] uppercase tracking-[0.16em] text-muted-light">Categories</div>
            </div>
            <div class="px-4 py-3.5">
              <div class="font-serif text-[22px] leading-none text-ink">{tags.length}</div>
              <div class="mt-1 font-mono text-[8px] uppercase tracking-[0.16em] text-muted-light">Tags</div>
            </div>
          </div>
          <div class="flex items-center justify-between border-t border-rule px-4 py-2.5 font-mono text-[8px] uppercase tracking-[0.12em] text-muted-light">
            <span>Running since 2026.01</span>
            <span><span id="home-run-days" class="text-ink">{runDays}</span> days</span>
          </div>
        </section>

        {seriesGroups.length > 0 && (
          <section>
            <div class="flex items-baseline justify-between border-b border-rule pb-2.5">
              <h2 class="font-mono text-[9px] uppercase tracking-[0.18em] text-muted">Series</h2>
              <a href="/series/" class="text-[10px] text-muted-light transition-colors hover:text-accent">
                全部 <span aria-hidden="true">→</span>
              </a>
            </div>
            <ul class="mt-3 space-y-2.5">
              {seriesGroups.map((group) => (
                <li>
                  <a
                    href={`/series/#series-${group.slug}`}
                    class="group flex items-baseline justify-between gap-3"
                  >
                    <span class="text-[13px] leading-5 text-ink transition-colors group-hover:text-accent">
                      {group.name}
                    </span>
                    <span class="font-mono text-[9px] text-muted-light">{group.posts.length}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        <section>
          <div class="flex items-baseline justify-between border-b border-rule pb-2.5">
            <h2 class="font-mono text-[9px] uppercase tracking-[0.18em] text-muted">Categories</h2>
            <span class="font-mono text-[9px] text-muted-light">{categories.length}</span>
          </div>
          <ul class="mt-2 divide-y divide-rule-soft">
            {categories.map(([category, count]) => (
              <li>
                <a
                  href={`/blog/?category=${encodeURIComponent(category)}`}
                  class="group flex items-baseline justify-between gap-3 py-2 text-[12px] text-muted transition-colors hover:text-accent"
                >
                  <span>{category}</span>
                  <span class="font-mono text-[9px] text-muted-light">{count}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>

        <section>
          <div class="flex items-baseline justify-between border-b border-rule pb-2.5">
            <h2 class="font-mono text-[9px] uppercase tracking-[0.18em] text-muted">Tags</h2>
            <span class="font-mono text-[9px] text-muted-light">{tags.length}</span>
          </div>
          <div class="mt-3 flex flex-wrap gap-1.5">
            {tags.map(([tag, count]) => (
              <a href={`/blog/?tag=${encodeURIComponent(tag)}`} class="tag">
                {tag} <span class="font-mono text-[9px] text-muted-light">{count}</span>
              </a>
            ))}
          </div>
        </section>

        <a
          href="/lab/"
          class="group block border border-rule bg-accent-soft/60 p-4 transition-colors hover:border-muted-light"
        >
          <div class="flex items-center justify-between font-mono text-[8px] uppercase tracking-[0.18em] text-muted-light">
            <span>Lab</span>
            <span>Interactive</span>
          </div>
          <div class="mt-2 font-serif text-base font-semibold text-ink transition-colors group-hover:text-accent">
            扩散过程实验
          </div>
          <p class="mt-1 text-[11px] leading-5 text-muted">
            拖动时间步，观察一张图片如何被加噪与还原。
          </p>
        </a>
      </aside>
    </div>
  </main>

  <script define:vars={{ BLOG_START_DATE }}>
    const runDaysEl = document.getElementById('home-run-days');
    if (runDaysEl) {
      const days = Math.max(
        0,
        Math.floor((Date.now() - new Date(BLOG_START_DATE).getTime()) / (1000 * 60 * 60 * 24))
      );
      runDaysEl.textContent = String(days);
    }
  </script>
</BaseLayout>
