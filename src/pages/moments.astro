---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { formatDate } from '../utils/blog';

const moments = [
  {
    date: '2026-04-11',
    content: '使用 Astro 对个人博客进行了全面重构，体验大幅提升。',
    category: '网站',
  },
  {
    date: '2026-01-01',
    content: '使用 Hugo 搭建了个人博客，正式开始记录学习与研究的旅程。',
    category: '网站',
  },
];
---

<BaseLayout title="时光机" description="记录生活与研究的碎片瞬间">
  <main id="main" class="mx-auto max-w-3xl px-4 pb-24 pt-10 sm:px-6 lg:px-8">
    <Breadcrumb items={[{ label: '首页', href: '/' }, { label: '时光机' }]} />

    <header class="border-b border-rule pb-10">
      <p class="font-mono text-[12px] text-muted-light">~/timeline</p>
      <h1 class="mt-4 font-serif text-[2.1rem] font-semibold leading-[1.3] tracking-[.01em] text-ink sm:text-[2.5rem]">
        时光机
      </h1>
      <p class="mt-4 text-[14px] text-muted">记录生活与研究的碎片瞬间 · {moments.length} 条</p>
    </header>

    <div class="relative mt-10 border-l border-rule pl-6">
      {moments.map((moment) => {
        const date = new Date(moment.date);
        return (
          <div class="relative pb-10 last:pb-0">
            <span class="absolute -left-[28px] top-1.5 h-2 w-2 rounded-full border border-paper bg-accent"></span>
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[12px] text-muted-light">
              <time datetime={moment.date}>{formatDate(date)}</time>
              <span class="text-rule-soft" aria-hidden="true">·</span>
              <span>{date.toLocaleDateString('zh-CN', { weekday: 'short' })}</span>
              <span class="text-rule-soft" aria-hidden="true">·</span>
              <span>{moment.category}</span>
            </div>
            <p class="mt-2 max-w-2xl text-sm leading-7 text-ink-soft">{moment.content}</p>
          </div>
        );
      })}
    </div>
  </main>
</BaseLayout>
