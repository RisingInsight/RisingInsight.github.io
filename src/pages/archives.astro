---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { formatDate } from '../utils/blog';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const postsByMonth: Record<string, typeof allPosts> = {};
for (const post of sortedPosts) {
  const key = post.data.pubDate.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: 'long',
  });
  if (!postsByMonth[key]) postsByMonth[key] = [];
  postsByMonth[key].push(post);
}
const months = Object.keys(postsByMonth);
---

<BaseLayout title="归档" description="Blog archives">
  <main id="main" class="mx-auto max-w-4xl px-4 pb-24 pt-10 sm:px-6 lg:px-8">
    <Breadcrumb items={[{ label: '首页', href: '/' }, { label: '归档' }]} />

    <header class="border-b border-rule pb-10">
      <p class="font-mono text-[12px] text-muted-light">~/archive</p>
      <h1 class="mt-4 font-serif text-[2.1rem] font-semibold leading-[1.3] tracking-[.01em] text-ink sm:text-[2.5rem]">
        归档
      </h1>
      <p class="mt-4 text-[14px] text-muted">共 {sortedPosts.length} 篇笔记 · 按时间倒序</p>
    </header>

    <div class="mt-10 space-y-12">
      {months.map((month) => (
        <section>
          <div class="flex items-baseline justify-between border-b border-rule pb-3">
            <h2 class="font-serif text-xl font-semibold text-ink">{month}</h2>
            <span class="mono-label">
              {postsByMonth[month].length} 篇
            </span>
          </div>
          <div class="divide-y divide-rule">
            {postsByMonth[month].map((post) => (
              <a
                href={`/blog/${post.id}/`}
                class="row-link group grid gap-3 py-5 sm:grid-cols-[90px_1fr_auto] sm:items-baseline"
              >
                <div class="font-mono text-[12px] text-muted-light">
                  {formatDate(post.data.pubDate)}
                </div>
                <div>
                  <h3 class="font-serif text-base font-semibold leading-snug text-ink transition-colors group-hover:text-accent">
                    {post.data.title}
                  </h3>
                  <p class="mt-1 text-[14px] leading-6 text-muted">{post.data.description}</p>
                </div>
                {post.data.tags.length > 0 && (
                  <div class="hidden gap-2 sm:flex">
                    {post.data.tags.slice(0, 2).map((tag) => <span class="tag">{tag}</span>)}
                  </div>
                )}
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </main>
</BaseLayout>
