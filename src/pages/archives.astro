---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { getTagColor } from '../utils/blog';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// 按年月分组
const postsByMonth: Record<string, typeof allPosts> = {};
for (const post of sortedPosts) {
  const key = post.data.pubDate.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: 'long',
  });
  if (!postsByMonth[key]) postsByMonth[key] = [];
  postsByMonth[key].push(post);
}

const months = Object.keys(postsByMonth);
---

<html lang="zh-CN">
  <head>
    <BaseHead title="归档" description="Blog archives" />
  </head>
  <body>
    <Header />

    <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <Breadcrumb items={[{ label: '首页', href: '/' }, { label: '归档' }]} />

      <!-- 页面标题 -->
      <div class="mb-10 animate-fade-up">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-6 bg-gradient-to-b from-primary to-accent rounded-full"></div>
          <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">归档</h1>
        </div>
        <p class="text-slate-500 dark:text-slate-400 ml-4">
          共 <span class="font-semibold text-slate-700 dark:text-slate-300">{sortedPosts.length}</span> 篇文章
        </p>
      </div>

      <!-- 时间线 -->
      <div class="space-y-10">
        {months.map((month, mi) => (
          <div class="animate-fade-up" style={`animation-delay: ${mi * 0.1}s`}>
            <!-- 月份标题 -->
            <div class="flex items-center gap-3 mb-4">
              <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-primary/10 dark:bg-primary-light/10">
                <svg class="w-4 h-4 text-primary dark:text-primary-light" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
              <h2 class="text-lg font-bold text-slate-800 dark:text-slate-200">
                {month}
              </h2>
              <span class="text-sm text-slate-400 dark:text-slate-500 bg-slate-100 dark:bg-slate-800 px-2.5 py-0.5 rounded-full">
                {postsByMonth[month].length}
              </span>
              <div class="flex-1 h-px bg-gradient-to-r from-slate-200 dark:from-slate-700 to-transparent"></div>
            </div>

            <!-- 文章列表 -->
            <div class="ml-4 space-y-3">
              {postsByMonth[month].map((post) => (
                <a
                  href={`/blog/${post.id}/`}
                  class="group flex items-center gap-4 p-4 rounded-xl bg-white dark:bg-slate-800/40 border border-slate-200/60 dark:border-slate-700/40 hover:border-primary/30 dark:hover:border-primary-light/30 hover:shadow-md transition-all"
                >
                  <div class="shrink-0 text-center w-12">
                    <div class="text-xl font-bold text-slate-800 dark:text-slate-200 leading-none">
                      {post.data.pubDate.toLocaleDateString('zh-CN', { day: 'numeric' })}
                    </div>
                    <div class="text-xs text-slate-400 dark:text-slate-500 mt-0.5">
                      {post.data.pubDate.toLocaleDateString('zh-CN', { weekday: 'short' })}
                    </div>
                  </div>
                  <div class="flex-1 min-w-0">
                    <h3 class="font-semibold text-slate-800 dark:text-slate-200 group-hover:text-primary dark:group-hover:text-primary-light transition-colors truncate">
                      {post.data.title}
                    </h3>
                    {post.data.description && (
                      <p class="text-sm text-slate-500 dark:text-slate-400 truncate mt-0.5">
                        {post.data.description}
                      </p>
                    )}
                  </div>
                  {post.data.tags.length > 0 && (
                    <div class="hidden sm:flex flex-wrap gap-1 shrink-0">
                      {post.data.tags.slice(0, 2).map((tag) => (
                        <span class={`tag ${getTagColor(tag)}`}>{tag}</span>
                      ))}
                    </div>
                  )}
                  <svg class="w-4 h-4 text-slate-300 dark:text-slate-600 group-hover:text-primary dark:group-hover:text-primary-light transition-all shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </main>

    <Footer />
  </body>
</html>
