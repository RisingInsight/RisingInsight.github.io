---
import BaseLayout from '../layouts/BaseLayout.astro';
import ddl from '../data/ccf-ddl.json';

const fetchedDate = ddl.fetchedAt ? ddl.fetchedAt.slice(0, 10).replace(/-/g, '.') : '';

// 截稿时间解析：'YYYY-MM-DD HH:MM:SS' + 'UTC-12' / 'AoE' → Date
function ddlDate(str, tz) {
  if (!str) return null;
  let offset = '-12:00'; // 默认 AoE
  const m = (tz || '').match(/UTC([+-]\d{1,2})/);
  if (m) {
    const h = parseInt(m[1], 10);
    offset = `${h >= 0 ? '+' : '-'}${String(Math.abs(h)).padStart(2, '0')}:00`;
  }
  const d = new Date(str.replace(' ', 'T') + offset);
  return isNaN(d.getTime()) ? null : d;
}

const rows = ddl.entries
  .map((e) => {
    const first = e.timelines.map((t) => t.deadline).sort()[0];
    const firstDate = ddlDate(first, e.timezone);
    return { ...e, first, firstDate };
  })
  .filter((e) => e.firstDate)
  .sort((a, b) => a.firstDate - b.firstDate);

const rankBadge = (rank) =>
  rank === 'A'
    ? 'bg-accent text-[var(--accent-contrast)]'
    : 'border border-rule text-muted';
---

<BaseLayout title="CCF DDL · 顶会截稿日 // RisingInsight" description="CCF-A/B 会议截稿日追踪，完整顶会顶刊论文门户见 /papers/">
  <main id="main" class="mx-auto max-w-4xl px-4 pb-24 pt-10 sm:px-6 lg:px-8">
    <header class="border-b border-rule pb-10">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <p class="font-mono text-[12px] text-muted-light">~/ddl</p>
        <a
          href={ddl.source}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[12px] text-muted-light transition-colors hover:text-accent"
        >
          数据源 ccfddl <span aria-hidden="true">↗</span>
        </a>
      </div>
      <h1 class="mt-4 font-serif text-[2.1rem] font-semibold leading-[1.3] tracking-[.01em] text-ink sm:text-[2.5rem]">
        CCF 截稿日
      </h1>
      <p class="mt-4 max-w-2xl text-[14px] leading-7 text-muted">
        追踪 CCF-A/B 会议的最近一届截稿时间。
        数据来自 ccfddl 社区仓库（构建于 {fetchedDate}），<span class="text-muted-light">截稿时间以官网为准</span>。
        历年中稿论文已移到独立的
        <a href="/papers/" class="text-accent underline decoration-rule underline-offset-4 hover:decoration-accent">顶会顶刊论文门户</a>。
      </p>
      <p class="mt-4 font-mono text-[12px] text-muted-light">
        {ddl.count} conferences · A {rows.filter(r => r.rank === 'A').length} · B {rows.filter(r => r.rank === 'B').length}
      </p>
    </header>

    <section aria-labelledby="ddl-list-heading">
      <div class="flex flex-wrap items-center justify-between gap-3 pt-8 pb-4">
        <h2 id="ddl-list-heading" class="font-serif text-xl font-semibold text-ink">
          截稿日
        </h2>
        <div class="ddl-tabs" role="group" aria-label="按等级筛选">
          <button type="button" data-rank="all" class="ddl-tab is-active" aria-pressed="true">全部</button>
          <button type="button" data-rank="A" class="ddl-tab" aria-pressed="false">CCF-A</button>
          <button type="button" data-rank="B" class="ddl-tab" aria-pressed="false">CCF-B</button>
          <label class="ddl-only-upcoming">
            <input type="checkbox" id="ddl-upcoming" checked />
            <span>仅未截止</span>
          </label>
        </div>
      </div>

      <div id="ddl-rows" class="divide-y divide-rule-soft">
        {rows.map((e) => {
          const first = e.timelines[0];
          const isPast = e.firstDate ? e.firstDate.getTime() < Date.now() : false;
          const days = e.firstDate
            ? Math.ceil((e.firstDate.getTime() - Date.now()) / 86400000)
            : null;
          return (
            <article
              class="ddl-row group py-5"
              data-rank={e.rank}
              data-deadline={first.deadline}
              data-tz={e.timezone}
              data-past={String(isPast)}
            >
              <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-1">
                <div class="flex min-w-0 items-center gap-3">
                  <span class={`ddl-badge ${rankBadge(e.rank)}`}>{e.rank}</span>
                  <h3 class="font-mono text-[1.05rem] font-bold text-ink">
                    {e.title}
                    <span class="ml-1 font-sans text-[13px] font-normal text-muted-light">{e.year}</span>
                  </h3>
                </div>
                <time class="font-mono text-[12px] text-muted-light" datetime={first.deadline}>
                  {first.deadline} {e.timezone}
                </time>
              </div>
              <p class="mt-1.5 text-[13.5px] leading-6 text-muted">{e.description}</p>
              <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-[11.5px] text-muted-light">
                <span class="inline-flex items-center gap-1.5">
                  <span
                    class="ddl-countdown font-serif text-[15px] font-semibold tabular-nums text-accent"
                    data-deadline={first.deadline}
                    data-tz={e.timezone}
                  >
                    {days !== null ? `D${days <= 0 ? '+' + Math.abs(days) : '-' + days}` : '—'}
                  </span>
                  <span class="ddl-status-label">{isPast ? '已截止' : '距截稿'}</span>
                </span>
                {e.timelines.length > 1 && (
                  <span>
                    {e.timelines.length} 轮 · 首轮 {e.timelines[0].abstract || e.timelines[0].deadline}
                  </span>
                )}
                <span>{e.place}</span>
                {e.link && (
                  <a href={e.link} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-accent">
                    官网 <span aria-hidden="true">↗</span>
                  </a>
                )}
                <a href={`/papers/#${e.id}`} class="transition-colors hover:text-accent">
                  历年论文 <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          );
        })}
      </div>

      <p id="ddl-empty" class="hidden py-14 text-center text-sm text-muted">
        没有匹配的会议 —— 放宽筛选试试。
      </p>
    </section>

    <section class="mt-14 border-t border-rule pt-8">
      <a href="/papers/" class="group flex flex-wrap items-end justify-between gap-4">
        <div>
          <div class="mono-label">paper portal</div>
          <h2 class="mt-2 font-serif text-xl font-semibold text-ink transition-colors group-hover:text-accent">
            顶会顶刊论文
          </h2>
          <p class="mt-2 max-w-2xl text-[13.5px] leading-6 text-muted">
            40+ 会议与期刊，按领域、会议/期刊与年份浏览中稿论文；
            摘要展开、有全文筛选、收藏与 BibTeX 都在那里。
          </p>
        </div>
        <span class="font-mono text-[12px] text-muted-light transition-colors group-hover:text-accent">
          打开门户 <span aria-hidden="true">→</span>
        </span>
      </a>
    </section>
  </main>
</BaseLayout>

<style is:inline>
  .ddl-badge {
    display: inline-flex;
    align-items: center;
    padding: 1px 8px;
    border-radius: var(--r-xs);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .06em;
    line-height: 1.6;
  }
  .ddl-tabs {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .ddl-tab {
    padding: 4px 12px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font-size: 12.5px;
    cursor: pointer;
    transition: color .2s, border-color .2s, background .2s;
  }
  .ddl-tab:hover {
    color: var(--ink);
    border-color: var(--muted-light);
  }
  .ddl-tab.is-active {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .ddl-tab:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .ddl-only-upcoming {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: 10px;
    font-size: 12.5px;
    color: var(--muted);
    cursor: pointer;
  }
  .ddl-only-upcoming input {
    accent-color: var(--accent);
  }
  .ddl-row[data-past='true'] {
    opacity: .45;
  }
  .ddl-row[data-past='true'] .ddl-countdown {
    color: var(--muted-light);
  }
</style>

<script>
  // ---- 筛选：等级 tab + 仅未截止 ----
  const rows = Array.from(document.querySelectorAll('.ddl-row'));
  const tabs = Array.from(document.querySelectorAll('.ddl-tab'));
  const upcoming = document.getElementById('ddl-upcoming');
  const empty = document.getElementById('ddl-empty');
  let rank = 'all';

  function applyFilter() {
    let visible = 0;
    rows.forEach((row) => {
      const matchRank = rank === 'all' || row.dataset.rank === rank;
      const matchUpcoming = !upcoming?.checked || row.dataset.past !== 'true';
      const show = matchRank && matchUpcoming;
      row.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    if (empty) empty.classList.toggle('hidden', visible > 0);
  }
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      rank = tab.dataset.rank || 'all';
      tabs.forEach((t) => {
        t.classList.toggle('is-active', t === tab);
        t.setAttribute('aria-pressed', String(t === tab));
      });
      applyFilter();
    });
  });
  upcoming?.addEventListener('change', applyFilter);
  applyFilter();

  // ---- 倒计时：客户端按本地时间重算（构建时的 days 会随时间漂移）----
  function refreshCountdown() {
    rows.forEach((row) => {
      const el = row.querySelector('.ddl-countdown');
      if (!el || !row.dataset.deadline) return;
      const tz = row.dataset.tz || 'UTC-12';
      let offset = '-12:00';
      const m = tz.match(/UTC([+-]\d{1,2})/);
      if (m) {
        const h = parseInt(m[1], 10);
        offset = `${h >= 0 ? '+' : '-'}${String(Math.abs(h)).padStart(2, '0')}:00`;
      }
      const d = new Date(row.dataset.deadline.replace(' ', 'T') + offset);
      if (isNaN(d.getTime())) return;
      const days = Math.ceil((d.getTime() - Date.now()) / 86400000);
      const past = d.getTime() < Date.now();
      if (row.dataset.past !== String(past)) {
        row.dataset.past = String(past);
        const label = row.querySelector('.ddl-status-label');
        if (label) label.textContent = past ? '已截止' : '距截稿';
        applyFilter();
      }
      el.textContent = past ? '—' : days <= 0 ? 'D±0' : `D-${days}`;
    });
  }
  refreshCountdown();
  window.setInterval(refreshCountdown, 30 * 60 * 1000);
</script>
